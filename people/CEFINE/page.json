"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",h3:\"h3\",p:\"p\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"感觉对象不如歼 20 和歼 16（？）\"),\"\\n\",Vue.h(_components.p,null,\"—— 雪芙妮 2024-02-15 13:12\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"简介\"),\"\\n\",Vue.h(_components.p,null,\"每次翻阅妮猫的空间，第一眼看到的肯定是他更换新头像的通知。\"),\"\\n\",Vue.h(_components.p,null,\"从他留存的极少数个性签名来看，他大概是个相当喜欢机娘和枪娘的孩子，比如引言的那句，也是他个签的一部分。\"),\"\\n\",Vue.h(_components.p,null,\"谁都想不到，这样一个乐观，天天水群，高强度上网冲浪，还给朋友们带来无数温暖的人，屏幕后却承受着巨大的生理和心理压力……\"),\"\\n\",Vue.h(_components.h2,null,\"回忆录\"),\"\\n\",Vue.h(_components.h3,null,\"By: _AloneStar_\"),\"\\n\",Vue.h(_components.p,null,\"我和他很早就认识了。截至今天，他已经在我好友列表里存在了四年之久，但我并不算很了解他，他好像对自己现实里的事情只字不提。但我还是有印象，曾经听他说过自己的病症。\"),\"\\n\",Vue.h(_components.p,null,\"总之，他说自己大概很快就会失去自理能力，是个很可怜的孩子呢……但他还是照常天天水群、玩游戏，似乎一点都没有为此焦虑的感觉，甚至偶尔还能在群里发点好看的图片，完全看不出来这是一个身患绝症的孩子。\"),\"\\n\",Vue.h(_components.h3,null,\"By: Arista\"),\"\\n\",Vue.h(_components.p,null,\"妮猫是一个很有意思、很有趣的人……我不擅长描述自己的感觉，总之就是很有意思。在和妮猫相处的这段时间里，他给我带来了无限的快乐，「很有趣」就是我对他最高的评价。\"),\"\\n\",Vue.h(_components.h3,null,\"《明天还会再见》By: 黑不在\"),\"\\n\",Vue.h(_components.p,null,\"现在写这篇文章好像有点晚了。\"),\"\\n\",Vue.h(_components.p,null,\"妮猫，我是叫你猫猫的来着，毕竟你以前就叫猫猫，也不知道是什么时候开始变成妮猫了。\"),\"\\n\",Vue.h(_components.p,null,\"你是我认识的 QQ 好友里面很早的一个了，我有点记不清认识多久了，好友详情里也没法看见了——因为我有一阵子赌气把很多好友都删了，原因是感觉你们都不在乎我的样子，想着说不定这样做能引起你们的注意。很幼稚。很久很久以前是你主动加我，来跟我一起玩的，我很开心：我很喜欢你，到现在我都记得大家一起玩 MC 的种种时光。但就是因为这样，我感到很落差，在 QQ 这个小世界里，你的身边总是围满了人，我一点点的被挤出了你的视野，也有可能是我自己的心理作祟，我感觉你不再像从前那样跟我要好了……\"),\"\\n\",Vue.h(_components.p,null,\"我会想办法地融入你们的世界，打听你玩的游戏、交好各自的好友，尽管我有点笨拙，但是你走了，在 7 月 3 日。\"),\"\\n\",Vue.h(_components.p,null,\"你知道吗，我会很想你，我不知道我在你的心里是什么地位，怎样的颜色，但是猫猫你在我的心里面，从来不会是一个普通的网友，而是一个从我入坑 QQ 这一社交媒体以来，认识的最有色彩，对我来说最为重要的一个亲友，我们或许可能永远也不知道屏幕后的你是谁，但是我们永远认识「妮猫猫」。\"),\"\\n\",Vue.h(_components.p,null,\"我不清楚别人怎么样想，但是我永远不会忘记你，你会成为在我独一份的记忆中的「猫猫」。让我们明天还会再见，尽管不再可能，我的至交。\"),\"\\n\",Vue.h(_components.h2,null,\"离开\"),\"\\n\",Vue.h(_components.p,null,\"妮猫的离开很意外，很突然……就好像一滴水沉入了海里，无处可寻，又或者是蜡烛燃尽了它最后的烛芯一样，彻底在网上消失了。\"),\"\\n\",Vue.h(_components.p,null,\"起初，朋友们只是以为他身体不太好，需要休养一段时间。但随着时间慢慢推移，大家似乎意识到了问题所在。直到他的手机被家人接管，我们才知道，他的病并不是那种普普通通的疾病，而是——\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\"))),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; color: #d32f2f; font-size: 1.8em; font-weight: bold; margin: 30px 0; letter-spacing: 2px;\"},Vue.h(_components.p,null,\"渐冻症\")),\"\\n\",Vue.h(_components.p,null,\"大部分朋友在这个时候才了解到，原来乐观的妮猫身患绝症，却仍然把他的开朗留在了互联网上。\"),\"\\n\",Vue.h(_components.p,null,\"7 月 3 日，妮猫在睡梦中坠入了海底。渐冻症让他无法自主呼吸，他累了，不想再承受生理和心理上的痛苦了，就此闭上了眼睛，永远地离开了这个世界。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「总有一天，我们不用说再见，只需要互道晚安。」\"),\"\\n\",Vue.h(_components.p,null,\"晚安，妮猫。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"条目贡献：_AloneStar_, Arista, 黑不在\"),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"延伸阅读：维基百科上的\",Vue.h(_components.a,{href:\"https://zh.wikipedia.org/zh-cn/%E8%82%8C%E8%90%8E%E7%BC%A9%E4%BE%A7%E7%B4%A2%E7%A1%AC%E5%8C%96\"},\"肌萎缩侧索硬化\"),\"页面。\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h