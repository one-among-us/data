"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"简介\"),\"\\n\",Vue.h(_components.p,null,\"千面弥生出身于中国青海一个保守的穆斯林家庭，但她的内心却有着一片辽阔的天地。\"),\"\\n\",Vue.h(_components.p,null,\"早年间，她对《坦克世界：闪击战》有着浓厚的兴趣，曾撰写过德式坦克、自动火炮等的科普专栏，文笔十分专业，见解亦有独到之处。同时，作为一名音游玩家，她沉醉于 Muse Dash 的节奏与韵律，亦常在商场与好友一同于舞萌洗衣机前拍打和滑动。\"),\"\\n\",Vue.h(_components.h2,null,\"他乡\"),\"\\n\",Vue.h(_components.p,null,\"2024 年，受中国政府日渐激进的伊斯兰教本土化政策影响，千面弥生随家庭离开青海，举家搬迁至马来西亚，以留学生的身份开始了在异国他乡的生活。\"),\"\\n\",Vue.h(_components.p,null,\"因其父在他国务工养家糊口，她便与母亲及另外两位弟弟住在一起。然而其母对她的看管与控制到了近乎病态的地步，只要她一出门，就会收到来自母亲无数的短信轰炸要求她回家。加之其家庭因她跨性别女性的身份而断绝其生活费来源，故而她与家庭的关系变得越来越糟糕。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"她和她家里的关系啊……恐怕她在家里烂掉她家里人都不会知道的吧。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"随之崩溃的除了经济来源，还有她的合法留学签证与继续求学的希望。在退学遣返的风险与精神状态的重度压抑之下，2025 年初的一个夜晚，千面弥生决意在马来西亚的家中以最决绝的方式离开这个世界。\"),\"\\n\",Vue.h(_components.p,null,\"其友人崵霜得知消息后已倾尽全力，通过联系其对象得知了她所在的小区，及时拨打了 999 紧急热线，并以最快的速度赶往现场。然而，因着她的决绝，当救援力量到达时，一切已无转圜之机。她年轻的生命永远停在了那个寒冬的夜晚。\"),\"\\n\",Vue.h(_components.h2,null,\"彼岸\"),\"\\n\",Vue.h(_components.p,null,\"路漫悠长，梦归他乡。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"青海是她的来路，却并非她的归宿。马来西亚的生活虽说压抑而沉重，不可道「此心安处是吾乡」，但那里不仅有她得以作为真实自我呼吸的空气，亦有她的挚爱之人。\"),\"\\n\",Vue.h(_components.p,null,\"「馨香盈怀袖，路远莫致之。」\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-2\",id:\"footnote-ref-2\"},\"2\")),\"此岸与彼岸总是这世上最遥远的距离，而那相守的希望与未能送达的爱意，终与她一同留在了异乡的海风之中。\"),\"\\n\",Vue.h(_components.p,null,\"条目贡献：One Among Us, \",Vue.h(_components.a,{href:\"https://twitter.com/dangshuang\"},\"崵霜\")),\"\\n\",Vue.h(_components.p,null,\"推文整理：\",Vue.h(_components.a,{href:\"https://space.bilibili.com/1362658251\"},\"Up 主纪念馆\")),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"千面弥生曾以此作为 Twitter/X 主页的个人简介。\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"translate(0,2)\"},Vue.h(\"circle\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient2);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path1\",cx:\"10.667834\",cy:\"6\",r:\"4.5818877\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:#ff8373;stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",d:\"M 9.9178