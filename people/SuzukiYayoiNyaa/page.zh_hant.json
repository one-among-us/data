"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"簡介\"),\"\\n\",Vue.h(_components.p,null,\"千面彌生出身於中國青海一個保守的穆斯林家庭，但她的內心卻有著一片遼闊的天地。\"),\"\\n\",Vue.h(_components.p,null,\"早年間，她對《戰車世界：閃擊戰》有著濃厚的興趣，曾撰寫過德式戰車、自動火砲等的科普專欄，文筆十分專業，見解亦有獨到之處。同時，作為一名音遊玩家，她沉醉於 Muse Dash 的節奏與韻律，亦常在商場與好友一同於 maimai 洗衣機前拍打和滑動。\"),\"\\n\",Vue.h(_components.h2,null,\"他鄉\"),\"\\n\",Vue.h(_components.p,null,\"2024 年，受中國政府日漸激進的伊斯蘭教本土化政策影響，千面彌生隨家庭離開青海，舉家搬遷至馬來西亞，以留學生的身份開始了在異國他鄉的生活。\"),\"\\n\",Vue.h(_components.p,null,\"因其父在他國務工養家糊口，她便與母親及另外兩位弟弟住在一起。然而其母對她的看管與控制到了近乎病態的地步，只要她一出門，就會收到來自母親無數的簡訊轟炸要求她回家。加之其家庭因她跨性別女性的身分而斷絕其生活費來源，故而她與家庭的關係變得越來越糟糕。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"她和她家裡的關係啊……恐怕她在家裡爛掉她家裡人都不會知道的吧。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"隨之崩潰的除了經濟來源，還有她的合法留學簽證與繼續求學的希望。在退學遣返的風險與精神狀態的重度壓抑之下，2025 年初的一個夜晚，千面彌生決意在馬來西亞的家中以最決絕的方式離開這個世界。\"),\"\\n\",Vue.h(_components.p,null,\"其友人崵霜得知消息後已傾盡全力，透過聯繫其伴侶得知了她所在的社區，及時聯絡了 999 緊急熱線，並以最快的速度趕往現場。然而，因著她的決絕，當救援力量到達時，一切已無轉圜之機。她年輕的生命永遠停在了那個寒冬的夜晚。\"),\"\\n\",Vue.h(_components.h2,null,\"彼岸\"),\"\\n\",Vue.h(_components.p,null,\"路漫悠長，夢歸他鄉。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"青海是她的來路，卻並非她的歸宿。馬來西亞的生活雖說壓抑而沉重，不可道「此心安處是吾鄉」，但那裡不僅有她得以作為真實自我呼吸的空氣，亦有她的摯愛之人。\"),\"\\n\",Vue.h(_components.p,null,\"「馨香盈懷袖，路遠莫致之。」\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-2\",id:\"footnote-ref-2\"},\"2\")),\"此岸與彼岸總是這世上最遙遠的距離，而那相守的希望與未能送達的愛意，終與她一同留在了異鄉的海風之中。\"),\"\\n\",Vue.h(_components.p,null,\"條目貢獻：One Among Us, \",Vue.h(_components.a,{href:\"https://twitter.com/dangshuang\"},\"崵霜\")),\"\\n\",Vue.h(_components.p,null,\"推文整理：\",Vue.h(_components.a,{href:\"https://space.bilibili.com/1362658251\"},\"Up 主紀念館\")),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"千面彌生曾以此作為 Twitter/X 主頁的個人簡介。\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"translate(0,2)\"},Vue.h(\"circle\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient2);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path1\",cx:\"10.667834\",cy:\"6\",r:\"4.5818877\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:#ff8373;stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",d:\"M 