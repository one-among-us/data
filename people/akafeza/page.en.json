"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",br:\"br\",em:\"em\",h2:\"h2\",h3:\"h3\",p:\"p\",strong:\"strong\"},props.components),PhotoScroll=_components.PhotoScroll,Sakura=_components.Sakura;if(!PhotoScroll)_missingMdxReference(\"PhotoScroll\",true);if(!Sakura)_missingMdxReference(\"Sakura\",true);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"Everyone Saw Her Differently\"),\"\\n\",Vue.h(_components.p,null,\"Feza—what kind of person did others see her as…? Perhaps Feza herself was curious too.\"),\"\\n\",Vue.h(_components.p,null,\"So Feza followed a format popular back then, and posted a Zhihu question: “\",Vue.h(_components.a,{href:\"https://www.zhihu.com/question/284818437\"},\"What are your thoughts about ZhiHu user @yu-zhang-31-35 ?\"),\"”\"),\"\\n\",Vue.h(_components.p,null,\"Chizuru \",Vue.h(_components.a,{href:\"https://www.zhihu.com/question/284818437/answer/447682354\"},\"wrote this\"),\":\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"A genius silly cat, all soft and squishy, every bit of her a moe point.\"),\"\\n\",Vue.h(_components.p,null,\"So kind she almost doesn’t belong to this world, like a little child.\"),\"\\n\",Vue.h(_components.p,null,\"She’d calmly do the silliest things, and I’d be the one left terrified.\"),\"\\n\",Vue.h(_components.p,null,\"Honestly, I’m still not sure… what kind of wondrous existence she really is.\"),\"\\n\",Vue.h(_components.p,null,\"I hope she remembers: “Don’t let anyone tell you ‘who you are.’”\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"Feza only said: “Naive like a child—that’s why she can’t survive, I suppose.”\"),\"\\n\",Vue.h(_components.p,null,\"Feza seemed so pure, so sacred…\"),\"\\n\",Vue.h(_components.p,null,\"Pure to the point of not belonging to this society, sacred to the point of not belonging to this world at all.\"),\"\\n\",Vue.h(_components.p,null,\"So it was easy for her to get hurt, wasn’t it…\"),\"\\n\",Vue.h(_components.p,null,\"“Once I trusted someone too easily… my privacy got sold off, like being skinned alive in front of a crowd. It hurt so much…”\"),\"\\n\",Vue.h(_components.p,null,\"Someone else \",Vue.h(_components.a,{href:\"https://www.zhihu.com/question/284818437/answer/459019064\"},\"said this\"),\":\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"Soft, light and drifting, not a cat, just Feza.\"),\"\\n\",Vue.h(_components.p,null,\"Maybe she never belonged to this world to begin with.\"),\"\\n\",Vue.h(_components.p,null,\"She just found Neko here.\"),\"\\n\",Vue.h(_components.p,null,\"The most persistent, clearest feeling Feza gave me was: no spirit.\"),\"\\n\",Vue.h(_components.p,null,\"Only after that came kindness and gentleness.\"),\"\\n\",Vue.h(_components.p,null,\"Because she lost her beloved…\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\"))),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"But… if you’d ever lived with Feza for a long time, you might know that Feza was actually a child with quite a few problems…\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-2\",id:\"footnote-ref-2\"},\"2\"))),\"\\n\",Vue.h(_components.p,null,\"“Bad things—I’ve done them. Good things—maybe I’ve done some too…” Feza once sighed in recollection.\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-3\",id:\"footnote-ref-3\"},\"3\"))),\"\\n\",Vue.h(_components.p,null,\"Promising to leave together, delivering medicine to someone’s door, borrowing someone else’s kitchen to do \",Vue.h(_components.em,null,\"those\"),\" things… Others pulled her out of the mud, and she’d jump right back in, dragging them down with her.\"),\"\\n\",Vue.h(_components.p,null,\"So some people didn’t have a good impression of Feza, stuck on that worst period of her life.\"),\"\\n\",Vue.h(_components.p,null,\"But none of that matters now, does it…?\"),\"\\n\",Vue.h(_components.h2,null,\"Hot Chocolate and Love\"),\"\\n\",Vue.h(_components.p,null,\"Feza, because she was too kind, was hurt again and again by this world.\"),\"\\n\",Vue.h(_components.p,null,\"Later, she kept trying to leave, thinking of leaving together with the people who cared about her.\"),\"\\n\",Vue.h(_components.p,null,\"But in August 2017, she met Neko.\"),\"\\n\",Vue.h(_components.p,null,\"Feza saw Neko’s profile on Twitter. At first she thought, how does this person know how to do everything—better just block her.\"),\"\\n\",Vue.h(_components.p,null,\"But in the end curiosity won, and she reached out. And then, they ended up together…\"),\"\\n\",Vue.h(_components.p,null,\"Neko’s appearance made everything better. Everything seemed to be getting better.\"),\"\\n\",Vue.h(_components.p,null,\"The time they spent together saved Feza quite a lot, just as that line we can all see goes…\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"“Even those things were dark and painful, which had been hidden, you still observed and felt them. Maybe you understood more than myself. How wonderful… You also found my scattered identity, then lifted me out of abyss. That was the first time I was touched by others.”\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"Later, Feza no longer tried to persuade others to leave, no longer delivered medicine to their doors, and would even pull people back when they felt suicidal…\"),\"\\n\",Vue.h(_components.p,null,\"If Neko was by her side, Feza’s anxiety and depression would ease a great deal.\"),\"\\n\",Vue.h(_components.p,null,\"“I’ll probably stay normal from now on.”\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"To the seaside, holding your hand, shouting at the ocean:\"),\"\\n\",Vue.h(_components.p,null,\"“I love Sis Feza the most, I can’t be without her anymore, please tell the whole world!”\"),\"\\n\",Vue.h(_components.p,null,\"“I want to be together forever and ever… never apart again… I love Sis Neko the most…”\"),\"\\n\",Vue.h(_components.p,null,\"Neko/Feza, 2017-12-11\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"Suddenly, hot chocolate came up to my mind.\"),\"\\n\",Vue.h(_components.p,null,\"With milk and sugar cubes.\"),\"\\n\",Vue.h(_components.p,null,\"That sweet-to-the-point-of-cloying feeling—that’s what love is…\"),\"\\n\",Vue.h(_components.p,null,\"Love is very sweet, and it can save so many things…\"),\"\\n\",Vue.h(_components.h2,null,\"Life Is Mostly Farewells\"),\"\\n\",Vue.h(_components.p,null,\"Do you still remember that blog post, \",Vue.h(_components.em,null,\"Separation and Reunion\"),\"? Why did it exist…?\"),\"\\n\",Vue.h(_components.p,null,\"Because, back then, they had agreed to leave together…\"),\"\\n\",Vue.h(_components.p,null,\"Neko and Feza, and Ruri too, had been living in a Shanghai hotel after the 2018 Spring Festival.\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-4\",id:\"footnote-ref-4\"},\"4\"))),\"\\n\",Vue.h(_components.p,null,\"Maybe moods were bad, maybe various things piled up—three catgirls agreed to be together…\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"“So for this death, I thought it over for a whole night before I replied that I’d help you push the injection. It was actually a very difficult decision, because plainly speaking, it was killing you. Sorry. But if it could free you, then let it free you… I’ll come find you on the other side of the world right away.”\"),\"\\n\",Vue.h(_components.p,null,\"Neko, 2018-03-11\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"Though actually,\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"I was selfish too back then. The medicine I prepared for them wasn’t a lethal dose. For myself, I prepared double the lethal dose…\"),\"\\n\",Vue.h(_components.p,null,\"Chiyuki Ruri, 2018-08-02\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"We can no longer know what another worldline would have been—worse or better? No one can say now.\"),\"\\n\",Vue.h(_components.p,null,\"But in this story as we know it, Neko’s ex-boyfriend from September 2017 had been quietly hiding in the next room, eavesdropping on them. His reason: he didn’t want Neko to die, didn’t want Neko to leave this world. So he called the police…\"),\"\\n\",Vue.h(_components.p,null,\"Maybe looking back today, it wasn’t supposed to end that way. But at the time, that was also the beginning of things getting worse.\"),\"\\n\",Vue.h(_components.p,null,\"The three catgirls were forced to leave the hotel and planned to take the high-speed rail to Ruri’s home in Baoding.\"),\"\\n\",Vue.h(_components.p,null,\"But… it failed. Ruri’s parents and Neko’s parents intervened one after another. The three catgirls were forced apart—and especially, Neko was accidentally lost…\"),\"\\n\",Vue.h(_components.p,null,\"Then came all of that… the unspeakable partings, the separations.\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"“I have nothing left.”\"),\"\\n\",Vue.h(_components.p,null,\"“You were taken from me.”\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"Without you I get lost in life…\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"“For you I always stay alive... For without you I get lost in life. Wish you are still alive…”\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"“Resuscitation at 2:34 AM was unsuccessful.” “This afternoon.” “I’m sorry.” “I couldn’t save you.”\"),\"\\n\",Vue.h(_components.p,null,\"I woke up with my pillow soaked in tears…\"),\"\\n\",Vue.h(_components.p,null,\"I only want to be with you… Why did you let me wake up…\"),\"\\n\",Vue.h(_components.p,null,\"Your violin… you promised to play it for me…\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"I only hope your death is fake. That you’ll do what you did the first time we met—tell me the day before that you’re coming.\"),\"\\n\",Vue.h(_components.p,null,\"You’re still there, aren’t you? Otherwise, why let me live…\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"Wish you are still alive…\"),\"\\n\",Vue.h(_components.p,null,\"One sentence—how sad a story can it tell…?\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"“Only for you I stay alive... But you are not by my side. Isn’t it? Wish you are still alive…”\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-5\",id:\"footnote-ref-5\"},\"5\"))),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"What greeted her was only shattered reality.\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"I had planned to die this winter, but recently I got a mouse-gray pinstriped linen kimono, a kimono for summer, so I suppose I’ll live until summer first.\"),\"\\n\",Vue.h(_components.p,null,\"I had planned to die last spring, but that day I met that lovely him, someone I could entrust my life to, so I suppose I’ll live until the day he abandons me first.\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-6\",id:\"footnote-ref-6\"},\"6\"))),\"\\n\",Vue.h(_components.p,null,\"After all, no one would really like me.\"),\"\\n\",Vue.h(_components.p,null,\"As long as you stay with me and talk to me, I’m satisfied.\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"Your fingerprint’s still the best at unlocking it, you know. Come back, won’t you…\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo1.webp\"]}),\"\\n\",Vue.h(_components.h2,null,\"You are not by my side…\"),\"\\n\",Vue.h(_components.p,null,\"Put on a forced smile. It doesn’t matter anymore, does it.\"),\"\\n\",Vue.h(_components.p,null,\"Only existing because of you, not existing because of you.\"),\"\\n\",Vue.h(_components.p,null,\"Though you remember that last line too,\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-7\",id:\"footnote-ref-7\"},\"7\")),\" don’t you…\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"Wish you are still alive… Still alive…\"),\"\\n\",Vue.h(_components.p,null,\"But you are not by my side, not by my side…\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"THERE IS NO HOME ANYMORE\"),\"\\n\",Vue.h(_components.p,null,\"THIS KIND OF PLACE IS NOT A HOME AT ALL.\"),\"\\n\",Vue.h(_components.p,null,\"THAT HOME AS ALREADY BEEN DESTROYED.\"),\"\\n\",Vue.h(_components.p,null,\"I told you about it. That terrifying dream—though now it’s reality.\"),\"\\n\",Vue.h(_components.p,null,\"A destroyed home, a charred room, debris scattered across the floor, memories discarded at random, you long gone and me shattered.\"),\"\\n\",Vue.h(_components.p,null,\"The blood-soaked bedsheet has been half burned. Everything, everything precious, has turned to bubbles.\"),\"\\n\",Vue.h(_components.p,null,\"You smile and tell me this is a dream. Only, I still don’t know when this nightmare will end.\"),\"\\n\",Vue.h(_components.h2,null,\"A Wet Feather Sinks\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"Maybe the ending of Feza’s blog will be like this world—no one will ever read it.\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-8\",id:\"footnote-ref-8\"},\"8\")),Vue.h(_components.br),\"\\n\",\"But I’ll still write. Even if I can’t write much anymore, I still wants to pour her feelings into it.\",Vue.h(_components.br),\"\\n\",\"Hoping someone will read it. Hoping you’ll discover those little surprises.\",Vue.h(_components.br),\"\\n\",\"Well, even if no one sees it, it’s fine. Let them sink into the edges of the world. It’s fine.\",Vue.h(_components.br),\"\\n\",\"As long as you’re okay. As long as you’re okay.\",Vue.h(_components.br),\"\\n\",\"Neko, you’ve done your best, done your best to keep you company. You are very brave…\"),\"\\n\"),\"\\n\",Vue.h(\"br\"),\"\\n\",Vue.h(\"details\",null,Vue.h(\"summary\",null,Vue.h(_components.strong,null,\"Selected Excerpts\")),Vue.h(_components.h3,null,\"Tears\"),Vue.h(_components.p,null,\"“I’ve done my best searching these past few days, but there’s nothing. Maybe the truth is that it simply doesn’t exist.”\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-9\",id:\"footnote-ref-9\"},\"9\"))),Vue.h(_components.p,null,\"I fought despair, and even won against it more than once. I have the ability to deal with it—it just takes patience, care, companionship, and a long, long time.\"),Vue.h(_components.p,null,\"Only, I’m tired now.\"),Vue.h(_components.p,null,\"70ml? Immediately nauseous. So much water… I want fruit tea… passion fruit, that kind. Hot chocolate works too…\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-10\",id:\"footnote-ref-10\"},\"10\"))),Vue.h(_components.p,null,\"A girl no one cares about, freezing to death outside the door—that’s normal, isn’t it? After all, no one brought her home.\"),Vue.h(_components.p,null,\"I love you so much… I really, really love you…\"),Vue.h(_components.p,null,\"When I cry alone, my body heaves and shudders, as if I could hold it in.\"),Vue.h(_components.p,null,\"I can’t hold it in at all. But holding it in means nothing anyway. Wasting tears, isn’t it?\"),Vue.h(_components.p,null,\"Head tilted up, trying not to let tears fall, gasping for breath.\"),Vue.h(_components.p,null,\"Suddenly remembered discussing passion fruit with you, and how stupidly I took a bite.\"),Vue.h(_components.p,null,\"Sigh…\"),Vue.h(_components.h3,null,\"Despair\"),Vue.h(_components.p,null,\"The melody of \",Vue.h(_components.em,null,\"Ashes of Dreams\"),Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-11\",id:\"footnote-ref-11\"},\"11\")),\" is so messy. Maybe it’s a kind of happiness—only, I can’t feel it anymore…?\"),Vue.h(_components.p,null,\"I added Emil’s music from Automata to playlist too. Only at times like this can I slowly feel it…\"),Vue.h(_components.p,null,\"Suddenly remembered that line from Popola,\"),Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"“You cut down my sister like an animal and you tell me to STOP!?”\"),\"\\n\"),Vue.h(_components.p,null,\"Even in a life-for-a-life situation, she still couldn’t defeat Emil…\"),Vue.h(_components.p,null,\"That’s how hopeless it is. She couldn’t even save her own sister. Defeated by the ultimate weapon, and the continuation of herself and her sister would have to bear the sin…\"),Vue.h(_components.p,null,\"Nothing to be done. Couldn’t do any of it.\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-12\",id:\"footnote-ref-12\"},\"12\"))),Vue.h(_components.h3,null,\"Pain\"),Vue.h(_components.p,null,\"Very stupidly wrote a letter to Neko, then realized I couldn’t write anymore. My hand is so numb, so uncomfortable…\"),Vue.h(_components.p,null,\"Relistened to \",Vue.h(_components.em,null,\"Weight of the World\"),\".*\"),Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"“Is this the price I’am paying for my past mistakes?”\",Vue.h(_components.br),\"\\n\",\"“I need you more than ever right now”\",Vue.h(_components.br),\"\\n\",\"“Can you hear me now?”\",Vue.h(_components.br),\"\\n\",\"“I wish that someway, some how”\",Vue.h(_components.br),\"\\n\",\"“That I can save everyone of us”\"),\"\\n\"),Vue.h(_components.p,null,\"That’s the feeling. Never gave up. Everyone is supporting you, telling you to live.\"),Vue.h(_components.p,null,\"How nice. How enviable. For me, what fits better is probably,\"),Vue.h(_components.p,null,\"“The time I spent with you, along with the gently drowning tender consciousness, gradually fades away.”\"),Vue.h(_components.p,null,\"Everything is fading.\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-13\",id:\"footnote-ref-13\"},\"13\"))),Vue.h(_components.p,null,\"The slow rhythm of the piano feels like walking step by step toward death…\"),Vue.h(_components.p,null,\"Hard to say… many songs, even the happiest ones, once the tempo slows, always reveal that sadness.\"),Vue.h(_components.p,null,\"My right arm feels stranger and stranger. Every keystroke feels numb and painful.\"),Vue.h(_components.p,null,\"Then today my palm suddenly hurt sharply for a while. I can even feel my nails growing, pressing against the skin—it really hurts…\"),Vue.h(_components.h3,null,\"Haishang\"),Vue.h(_components.p,null,\"The Haishang you’re in has never rained, but now it keeps raining in Shanghai.\"),Vue.h(_components.p,null,\"Over there it was always cloudy or sunny, wasn’t it? Perfect for going out.\"),Vue.h(_components.p,null,\"You could sit in the park all day, basking in the sun, warm and comfortable, right?\"),Vue.h(_components.p,null,\"I remember you said that line: “Existing because of you… not existing because of you. Must be here…” Only, I remember it faintly now. Just like that.\"),Vue.h(_components.p,null,\"Maybe you’ve already written down all those beautiful memories.\"),Vue.h(_components.p,null,\"Maybe you’ve already forgotten all those sad memories.\"),Vue.h(_components.p,null,\"Alone in sunlit Haishang, wearing the dresses you like, wandering the shops you like.\"),Vue.h(_components.p,null,\"That really is a beautiful world. The world Feza is in now may already be broken—there’s never sunlight.\"),Vue.h(_components.p,null,\"I kind of want to watch a movie with you. On a leisurely day like this, maybe you’d like that? We could watch movies together, write code together, space out together, watch videos together.\"),Vue.h(_components.p,null,\"So many things we could do. Though actually, most of the time you’re asleep…\"),Vue.h(_components.p,null,\"Actually, sleeping isn’t bad either. Having you there is good…\"),Vue.h(_components.p,null,\"Mm. Having you there is good.\"),Vue.h(_components.p,null,\"In the end, I’m not in the same world as anyone else… The questions we ask are different, the feelings are completely opposite.\"),Vue.h(_components.p,null,\"It’s fine, really. Because, thinking about it—\"),Vue.h(_components.p,null,\"Your Haishang over there is really beautiful. It doesn’t matter how painful or sad this world is.\"),Vue.h(_components.p,null,\"All of this will end eventually. Remember to listen to Feza tell the story of what happened afterward, when the time comes.\"),Vue.h(_components.p,null,\"Of course, if you don’t care, it’s fine not to tell it. Just holding each other is enough.\"),Vue.h(_components.p,null,\"Though all of this is still so far, far away from Feza.\"),Vue.h(_components.p,null,\"I believe—\"),Vue.h(_components.p,null,\"Soon.\"),Vue.h(_components.h3,null,\"Rewind\"),Vue.h(_components.p,null,\"Remember \",Vue.h(_components.em,null,\"Life is Strange\"),\"? I really want to record all those memories, print them out, stick them on the wall by my bed.\"),Vue.h(_components.p,null,\"But… even with the strongest power, you can’t save your own friend…\"),Vue.h(_components.p,null,\"Clearly there was a 75% chance, wasn’t there? But it just happened to fail. Mutual misunderstanding and lack of understanding—no longer fit to be friends…\"),Vue.h(_components.p,null,\"So we sealed that world away, hoping that one day we could save everyone, instead of watching a friend leave before our eyes.\"),Vue.h(_components.p,null,\"That world is still sealed. No one opens it anymore.\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-14\",id:\"footnote-ref-14\"},\"14\"))),Vue.h(_components.h3,null,\"Meaning\"),Vue.h(_components.p,null,\"That final promise\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-15\",id:\"footnote-ref-15\"},\"15\")),\"—does it still need to be kept…? What meaning is there in keeping it? There wouldn’t be any meaning anymore, would there…?\"),Vue.h(_components.p,null,\"What is meaningful? Whatever you like is meaningful, I suppose.\"),Vue.h(_components.p,null,\"Anyway, I’m just patchwork fur. If it doesn’t fall out, it doesn’t fall out. It doesn’t matter.\"),Vue.h(_components.p,null,\"Just sink to the bottom… Take away what should be taken. The rest will stay.\"),Vue.h(_components.p,null,\"Besides a few regrets, there isn’t much left.\"),Vue.h(_components.h3,null,\"The Towering Tree\"),Vue.h(_components.p,null,\"981203\"),Vue.h(_components.p,null,\"In the Misty Forest, there was a towering tree.\"),Vue.h(_components.p,null,\"He had existed for a very, very long time. He had always watched this world—whether it was the plague that destroyed the world, or the crusades that came later, or the fourteen hundred years of loneliness. He still existed.\"),Vue.h(_components.p,null,\"Countless branches were full of memories and feelings, preserving him. He would not be affected by the river of time—a lonely observer.\"),Vue.h(_components.p,null,\"But time was too long, too long. His heart was bound by chains of loneliness. His emotions could not be expressed.\"),Vue.h(_components.p,null,\"But a new emotion appeared. It was the source of souls. It far exceeded the upper limit of what he could feel. The chains began to collapse. The branches began to break. His heart became light.\"),Vue.h(_components.p,null,\"He was free.\"),Vue.h(_components.p,null,\"Actually, that tree is amazing…\"),Vue.h(_components.p,null,\"It could pull the other person into its own dreams. Feza could only tell stories. But stories, in the end, are translated through Feza’s language. They’re not the same as a dream you can actually feel and touch.\"),Vue.h(_components.p,null,\"Sigh. Abilities really are so limited.\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-16\",id:\"footnote-ref-16\"},\"16\"))),Vue.h(_components.h3,null,\"Leaning Close\"),Vue.h(_components.p,null,\"Listening again to that song, \",Vue.h(_components.em,null,\"Nandemonaiya\"),Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-17\",id:\"footnote-ref-17\"},\"17\"))),Vue.h(_components.p,null,\"But all of this is precious. All of it matters.\"),Vue.h(_components.p,null,\"The years spent rushing alone through the streets. The loneliness of downing a mouthful of alcohol in the cold wind.\"),Vue.h(_components.p,null,\"“Now just a little more only just a little more. Let’s stay here a little longer now.”\"),Vue.h(_components.p,null,\"It’s really too cold. Too lonely.\"),Vue.h(_components.p,null,\"“Tired of playing hide-and-seek with time, of running from its passage. I won’t let go again. I’ll never let go again.\\nFinally, these hands—are holding yours.”\"),Vue.h(_components.p,null,\"I can’t hold you again anymore, can I. I can’t…\"),Vue.h(_components.p,null,\"“You’re quite a snowy crier I wanna stop your tears.”\"),Vue.h(_components.p,null,\"You know, I still remember the taste of every tear of yours. I licked them all away.\"),Vue.h(_components.p,null,\"I still remember when you asked if it hurt. It didn’t hurt as much as the moment you left.\"),Vue.h(_components.p,null,\"You noticed it that time too, didn’t you. Even though I kept walking around outside, I hate the streets of Shanghai. I’ve always, always hated them—the neon lights that never go out in the darkness.\"),Vue.h(_components.p,null,\"I don’t belong here after all. I have to quietly hide in the dark streets to move forward.\"),Vue.h(_components.p,null,\"That night, we watched all of it from the elevated road. You asked if I was okay.\"),Vue.h(_components.p,null,\"I’m okay, I guess. After all, it’s been so long. No matter what, going home makes everything better.\"),Vue.h(_components.p,null,\"“It’s all because you listened to the voice inside you.”\"),Vue.h(_components.h3,null,\"Blood Scabs\"),Vue.h(_components.p,null,\"My right ear used to bleed several times, and there were strange pains.\"),Vue.h(_components.p,null,\"I went to the doctor. He said it was otitis media. Then I took…\"),Vue.h(_components.p,null,\"Amoxicillin? I think that was the medicine?\"),Vue.h(_components.p,null,\"Then just now I felt something inside, shook it a bit,\"),Vue.h(_components.p,null,\"…three blood scabs.\"),Vue.h(_components.p,null,\"So my ear started hurting again.\"),Vue.h(_components.p,null,\"Losing a protective membrane… is that what it feels like too? Thinking it’d be better without it, but actually… it hurts more and feels worse. Then I sigh and shrink back.\"),Vue.h(_components.p,null,\"After a while, I forget how much it hurt.\"),Vue.h(_components.h3,null,\"Cutting Extra Life\"),Vue.h(_components.p,null,\"I cut my fingernails. This way… it’s like I have no extra lives left, right?\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-18\",id:\"footnote-ref-18\"},\"18\"))),Vue.h(_components.p,null,\"According to what was said before, who will win this gamble?\"),Vue.h(_components.p,null,\"Feza, or Feza’s body? I hope it’s Feza.\"),Vue.h(_components.p,null,\"Because there’s nothing left. I’ve lost too many times.\"),Vue.h(_components.p,null,\"Just let Feza win once. Please.\"),Vue.h(_components.h3,null,\"Ruri\"),Vue.h(_components.p,null,\"This is the extra chapter I promised to write for Ruri.\"),Vue.h(_components.p,null,\"When I hear the word “Ruri,” what comes to mind is the stained glass of a church. There used to be a church on the way home. The pieces of colored glass were so beautiful. Sunlight shone through like a kaleidoscope.\"),Vue.h(_components.p,null,\"Ruri and glass cats are both fragile existences. Though after breaking they become even more beautiful and colorful,\"),Vue.h(_components.p,null,\"But we both know… it’s already been broken. Breaking any further will only ruin it completely.\"),Vue.h(_components.p,null,\"Gentleness and kindness pieced together, they shine with five-colored radiance.\"),Vue.h(_components.p,null,\"They are existences that need to be carefully loved and treasured.\"),Vue.h(_components.h3,null,\"Abyss\")),\"\\n\",Vue.h(\"br\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"Actually, this article’s ending is probably going to be,\",Vue.h(_components.br),\"\\n\",Vue.h(_components.em,null,\"Random Thoughts\"),Vue.h(_components.br),\"\\n\",\"“Actually, there was originally an article here, but Feza thought about it and removed the content, so this one sentence remains as a placeholder.”\",Vue.h(_components.br),\"\\n\",\"Not expecting anyone to read this article, and not expecting the people who really want to read it to come read it, because they probably can’t understand it anymore.\",Vue.h(_components.br),\"\\n\",\"That’s fine too. It doesn’t matter. One less thing to deal with isn’t a bad thing. So what reason is there not to do it?\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"Waking up is still the same oppressive everyday. Actually, wouldn’t it be better not to wake up?\"),\"\\n\",Vue.h(_components.p,null,\"Feza can’t fly once they’re wet. Sinking to the bottom might not be bad either, right?\"),\"\\n\",Vue.h(_components.h2,null,\"Never Saw the Dawn\"),\"\\n\",Vue.h(_components.p,null,\"I no longer dare to pray for a future where you’re still here. My world has already shattered. It’s not suitable for you to come here anymore.\"),\"\\n\",Vue.h(_components.p,null,\"Sorry. Not suitable for you to hold.\"),\"\\n\",Vue.h(_components.p,null,\"Though being held by the head really is comfortable, really comfortable, really comfortable.\"),\"\\n\",Vue.h(_components.p,null,\"Sorry. I really can’t do it anymore.\"),\"\\n\",Vue.h(_components.p,null,\"“But I can never hold you again.”\"),\"\\n\",Vue.h(_components.p,null,\"“And after that?”\"),\"\\n\",Vue.h(_components.p,null,\"What after that?\"),\"\\n\",Vue.h(_components.p,null,\"I can accept it. At least it’s a fixed outcome.\"),\"\\n\",Vue.h(_components.p,null,\"Just like those questions—“If you had only X days left to live, what would you do?”\"),\"\\n\",Vue.h(_components.p,null,\"Then drawing a predetermined rest mark in advance—isn’t that fine too?\"),\"\\n\",Vue.h(_components.p,null,\"Though the last few days can’t be spent however I want. Probably I’ll be stuck in the emergency room and ICU the whole time. But in the end, I know the fate that’s already set, don’t I?\"),\"\\n\",Vue.h(_components.p,null,\"Having seen through heaven’s secrets, dying doesn’t matter much. Though that itself is a bit self-referential.\"),\"\\n\",Vue.h(_components.p,null,\"No more worrying about being mocked after leaving the hospital, being lectured by family, spending money on medicine, or worrying about the future.\"),\"\\n\",Vue.h(_components.p,null,\"It’s all settled.\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"The sky is dark, like it will never brighten again. Whether it’s tomorrow or not, it doesn’t matter.\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-19\",id:\"footnote-ref-19\"},\"19\"))),\"\\n\",Vue.h(_components.p,null,\"“Maybe we can still light the lamp. Light it again.”\"),\"\\n\",Vue.h(_components.p,null,\"It’ll be blown out by the wild wind.\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"Terminal\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"Obituary\"),\"\\n\",Vue.h(_components.p,null,\"Feza (Zhangqianye, Twitter: \",Vue.h(_components.a,{href:\"https://twitter.com/zhangyubaka\"},\"@zhangyubaka\"),\"), took her own life by medication on the afternoon of July 30th.\"),\"\\n\",Vue.h(_components.p,null,\"This is to inform.\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"I spent seventeen years and nine months alone on this planet, though nearly three months of that were not lonely. The terminal station is just ahead. Rain falls on both sides of the railway. The scenery is monotone.\"),\"\\n\",Vue.h(_components.p,null,\"All gray, faded things, abstracted in the mind into meaningless existence.\"),\"\\n\",Vue.h(_components.p,null,\"Earphones hidden beneath hanging hair. The music of the Holy Spirit and the Church’s Spear still playing, occasionally turning into the Demon King, and the Arrogant One.\"),\"\\n\",Vue.h(_components.p,null,\"What is the terminal station really like? Many people have gone there, but they never wrote Feza letters or sent postcards.\"),\"\\n\",Vue.h(_components.p,null,\"They all seem to have disappeared, disconnected from Feza. Maybe the terminal station is just too happy?\"),\"\\n\",Vue.h(_components.p,null,\"Just like when Feza sat in the convenience store, the bento was so delicious I didn’t look at my phone. Or maybe, there was someone I liked.\"),\"\\n\",Vue.h(_components.p,null,\"Feza had that experience too. Leaning close for too long, not noticing the messages others sent, absorbed in each other’s warmth.\"),\"\\n\",Vue.h(_components.p,null,\"So maybe the terminal station is a wonderful place? But others say it’s an abyss where nothing exists.\"),\"\\n\",Vue.h(_components.p,null,\"Ah, nothing at all? If there’s no sadness and no pain, isn’t that not bad either?\"),\"\\n\",Vue.h(_components.p,null,\"Thinking this, the train had already slowed. Though the people in the carriage had grown fewer and fewer, the sounds in both ears had grown clearer and clearer.\"),\"\\n\",Vue.h(_components.p,null,\"The rain outside grew heavier. The scenery was already invisible, leaving only large streaks of water.\"),\"\\n\",Vue.h(_components.p,null,\"…\"),\"\\n\",Vue.h(_components.p,null,\"Silent for a while, recalling something, my heart started hurting again.\"),\"\\n\",Vue.h(_components.p,null,\"“Because, I want to hold someone.”\"),\"\\n\",Vue.h(_components.p,null,\"“Actually, it’s you who can’t let go, isn’t it?”\"),\"\\n\",Vue.h(_components.p,null,\"“…In a sense, yes.”\"),\"\\n\",Vue.h(_components.p,null,\"Sigh. Took a cup of passion fruit tea and drank it. The heart—I’ve never been able to tell if it’s real or not.\"),\"\\n\",Vue.h(_components.p,null,\"The train sounded its long departure whistle. Stood up. Looks like this is the stop.\"),\"\\n\",Vue.h(_components.p,null,\"My heart, too, felt a little better.\"),\"\\n\",Vue.h(_components.p,null,\"“Finally. I can rest well now.”\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; font-size: 1.2em; font-weight: bold; margin: 30px 0; letter-spacing: 2px;\"},Vue.h(_components.p,null,\"“If you see a neko, please tell her: Feza left an air chair for her.”\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-20\",id:\"footnote-ref-20\"},\"20\")))),\"\\n\",Vue.h(\"details\",null,Vue.h(\"summary\",null,Vue.h(_components.strong,null,\"References and Annotations\")),Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"At the time, no one knew the truth of Neko’s “departure.” Though some doubted the authenticity of the related events, and some friends held out hope. Feza herself kept \",Vue.h(_components.a,{href:\"https://www.zhihu.com/pin/966264886343397376\"},\"seeking verification\"),\", but until Feza’s death, no decisive information was ever obtained.\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",