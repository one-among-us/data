"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",br:\"br\",h2:\"h2\",p:\"p\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"簡介\"),\"\\n\",Vue.h(_components.p,null,\"我們無從知曉 Xa9 與跨性別社群的聯繫，但 Xa9 在 GitHub 頁面為自己選擇了 She/Her 的稱謂，我們暫且就用「她」來稱呼 Xa9 吧。\"),\"\\n\",Vue.h(_components.p,null,\"在 Xa9 自己的描述裡，她是一位音遊痴，喜歡 Phigros、喵斯快跑，以及冰與火之舞。當然，稍微熟悉舞萌的朋友也能看出來，她的頭像衍生自舞萌中的角色紗露朵\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"。\"),\"\\n\",Vue.h(_components.p,null,\"紗露朵，也就是鹽巴的意思呢……Xa9 也和鹽巴一樣，是朋友們日常生活裡不可或缺的調味劑。據她的朋友所述，她是一個很開朗的孩子，性格隨和，為人正直，深受大家的喜歡。\"),\"\\n\",Vue.h(_components.p,null,\"她還熱愛著業餘無線電、電子（工程）、嵌入式（系統）、電腦科學，以及攝影。同時也是一名航空迷與鐵道迷，真是「成分複雜」\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-2\",id:\"footnote-ref-2\"},\"2\")),\"呢。\"),\"\\n\",Vue.h(_components.p,null,\"而在網易雲音樂中，Xa9 又沉浸在 EDM 和 ACG 音樂的海洋裡，是一位「分享慾不強的音樂聽者」。偶爾，她也會在這裡留下一點聲音。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"希望我的音樂能給大家帶來一點點快樂，哪怕只有一點點也超開心！\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"2025 年 6 月 28 日，她發布了自己的生日作《\",Vue.h(_components.a,{href:\"https://music.163.com/song?id=2720546025\"},\"Soda Pop Days\"),\"》，這是她首次嘗試 AI 輔助作曲，並獨立混音完成的歌曲。汽水的氣泡與夏日午後的夢交織在其中，給炎熱的夏日帶來了一抹清涼，她的聽眾們十分喜歡。\"),\"\\n\",Vue.h(_components.p,null,\"但也就是這樣一位「成分複雜」，卻能把帶給大家的快樂調得剛好的朋友，在那個炎熱的夏天，把涼爽的氣泡水留給了我們，卻把內心難以言說的痛楚留給了自己。\"),\"\\n\",Vue.h(_components.p,null,\"我們無從知曉她為何離去，只是生活裡從此少了一匙調味鹽巴。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"また明