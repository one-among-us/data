"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",br:\"br\",h2:\"h2\",p:\"p\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"简介\"),\"\\n\",Vue.h(_components.p,null,\"我们无从知晓 Xa9 与跨性别社群的联系，但 Xa9 在 GitHub 页面为自己选择了 She/Her 的称谓，我们暂且就用「她」来称呼 Xa9 吧。\"),\"\\n\",Vue.h(_components.p,null,\"在 Xa9 自己的描述里，她是一位音游痴，喜欢 Phigros、喵斯快跑，以及冰与火之舞。当然，稍微熟悉舞萌的朋友也能看出来，她的头像衍生自舞萌中的角色纱露朵\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"。\"),\"\\n\",Vue.h(_components.p,null,\"纱露朵，也就是盐巴的意思呢……Xa9 也和盐巴一样，是朋友们日常生活里不可或缺的调味剂。据她的朋友所述，她是一个很开朗的孩子，性格随和，为人正直，深受大家的喜欢。\"),\"\\n\",Vue.h(_components.p,null,\"她还热爱着业余无线电、电子（工程）、嵌入式（系统）、计算机科学，以及摄影。同时也是一名飞友与轨交迷，真是「成分复杂」\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-2\",id:\"footnote-ref-2\"},\"2\")),\"呢。\"),\"\\n\",Vue.h(_components.p,null,\"而在网易云中，Xa9 又沉浸在 EDM 和 ACG 音乐的海洋里，是一位「分享欲不强的音乐听者」。偶尔，她也会在这里留下一点声音。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"希望我的音乐能给大家带来一点点快乐，哪怕只有一点点也超开心！\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"2025 年 6 月 28 日，她发布了自己的生日作《\",Vue.h(_components.a,{href:\"https://music.163.com/song?id=2720546025\"},\"Soda Pop Days\"),\"》，这是她首次尝试 AI 辅助作曲，并独立混音完成的歌曲。汽水的气泡与夏日午后的梦交织在其中，给炎热的夏日带来了一抹清凉，她的听众们十分喜欢。\"),\"\\n\",Vue.h(_components.p,null,\"但也就是这样一位「成分复杂」，却能把带给大家的快乐调得刚好的朋友，在那个炎热的夏天，把凉爽的气泡水留给了我们，却把内心难以言说的痛楚留给了自己。\"),\"\\n\",Vue.h(_components.p,null,\"我们无从知晓她为何离去，只是生活里从此少了一勺调味盐巴。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"また明日ね ソーダポップ・デイズ\",Vue.h(_components.br),\"\\n\",\"明天见咯 汽水泡泡日\"),\"\\n\",Vue.h(_components.p,null,\"おやすみ…\",Vue.h(_components.br),\"\\n\",\"晚安……\"),\"\\n\"),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"纱露朵：首次登场于 maimai MiLK。本业是面包师傅，经过她手揉搓的面团都会奇迹般地变蓬松。\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"translate(0,2)\"},Vue.h(\"circle\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient2);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path1\",cx:\"10.667834\",cy:\"6\",r:\"4.5818877\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:#ff8373;stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",d:\"M 9.9178343,10.577036 H 1.7971455\",id:\"path2\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linea