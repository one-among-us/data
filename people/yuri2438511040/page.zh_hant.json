"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\"},props.components),PhotoScroll=_components.PhotoScroll;if(!PhotoScroll)_missingMdxReference(\"PhotoScroll\",true);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"簡介\"),\"\\n\",Vue.h(_components.p,null,\"優里，正如她的 B 站簡介所述，最初，她還是一位尚未被發現的 MTF。早年間，她關注著社會主義相關的話題，懷揣著某種理想的熱忱，曾為巴黎公社革命爆發 150 週年寫下了長篇\",Vue.h(_components.a,{href:\"https://www.bilibili.com/opus/503267259684512850\"},\"紀念辭\"),\"。\"),\"\\n\",Vue.h(_components.p,null,\"後來，她走進我們的視野之中，在溫暖的社群大家庭中，和我們愉快地相處互動著，並結識了許多相知相伴的朋友。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「唔，生活真的好難，給你一個抱抱！」\"),\"\\n\",Vue.h(_components.p,null,\"「對方把你抱了個滿懷，說我在。」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"2024 年 6 月，優里開始嘗試 HRT，逐漸以女性身份生活。有一天晚上，她懷著惴惴不安的心情嘗試與父母談心，本意是想試著探探口風，但意外得知了其實母親早已看穿卻未點破的真相。儘管來自父親與其他親屬的阻力並未完全消失，但這微小的理解依然讓她成為了半個「家長黨」\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"，在冰冷的世界中感受到了來自原生家庭的一絲餘溫。\"),\"\\n\",Vue.h(_components.p,null,\"但即便如此，她的狀態也仍未因此而好轉，嚴重的憂鬱和焦慮如影隨形，即便她在醫院忙裡忙外一整天，也未能如願開到那張她心心念念的診斷證明。\"),\"\\n\",Vue.h(_components.p,null,\"在極度缺乏安全感與渴望被疼愛的雙重煎熬下，她常處於劇烈的情緒風暴之中。她曾嘗試用不同極端或代償的方式去逃避現實的壓迫，索求微弱的情感羈絆，甚至一度將自己推入了醫院急診室。\"),\"\\n\",Vue.h(_components.p,null,\"當然，即便在這樣艱難泥濘的日子裡，也偶有一些日常碎片曾短暫地治癒過她身上的傷痕：\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo1.webp\",\"${path}/photos/photo2.webp\"]}),\"\\n\",Vue.h(_components.p,null,\"我們或許難以深切體會她在短暫的一生中所經歷的那些苦難與掙扎。在臘月的寒冬中，敏感而疲憊的她做出了自己最後的選擇，靜靜地離開了這個世界。\"),\"\\n\",Vue.h(_components.p,null,\"願這位可憐的女孩在風雨已平息的彼岸獲得屬於她的平靜。\"),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"家長黨：中國大陸跨性別社群用語，指代支持、接納跨性別子女的父母與長輩。\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"translate(0,2)\"},Vue.h(\"circle\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient2);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path1\",cx:\"10.667834\",cy:\"6\",r:\"4.5818877\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:#ff8373;stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",d:\"M 9.9178343,10.577036 H 1.7971455\",id:\"path2\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient4);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path