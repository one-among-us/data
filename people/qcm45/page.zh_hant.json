"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\",strong:\"strong\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"這裡記錄著一些回憶，卻也有一個可能缺失了再也補不全的故事。\"),\"\\n\",Vue.h(_components.p,null,\"我們是生息在不健全世界上的不健全的人，不可能用尺子測量長度，或者用分度器測量角度，如同銀行存款般那樣毫釐不爽地生活，對吧？\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\"))),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"一段回憶\"),\"\\n\",Vue.h(_components.p,null,\"雖然我從未真正與夢夢見過面，但在我的印象裡嘛……她是一個善良可愛的孩子，總是關心著別人。\"),\"\\n\",Vue.h(_components.p,null,\"夢夢喜歡《BanG Dream》，我和她也是在這個圈子裡認識的，時間不早不晚。彼時 \",Vue.h(_components.a,{href:\"../profile/execute_darker\"},\"Darker\"),\" 還未被送進武校，她們三個人過得還算開心。\"),\"\\n\",Vue.h(_components.p,null,\"夢夢和我說：她們的關係，正是因為\",Vue.h(_components.strong,null,\"三個人\"),\"才得以穩定。\"),\"\\n\",Vue.h(_components.p,null,\"她們的日常的生活裡，有對跨性別友好的貓咖，有平靜而溫暖的卡布奇諾，有熱乎的雞腿飯，也偶有一起合影的時光。只是夢夢有些內向，並不怎麼主動分享她們的日常，總那樣靦腆地轉發那些滿載幸福的照片。\"),\"\\n\",Vue.h(_components.p,null,\"過了不久，夢夢突然告訴我說，Darker 被家裡人送進了武校。\"),\"\\n\",Vue.h(_components.p,null,\"我很驚詫，但隨後又冷靜下來。因著我自己就是武校受害者。所以在夢夢和白下\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-2\",id:\"footnote-ref-2\"},\"2\")),\"，也就是白姐姐前去廣西，努力嘗試通過各種手段將她撈出來的時候，我也在嘗試聯繫 Darker 的家長嘗試溝通，因而得以加上了 Darker 母親的微信，聊天倒也算大致過得去，可總不見得有什麼實際進展。\"),\"\\n\",Vue.h(_components.p,null,\"三個人之中突然少了 Darker 的身影，夢夢和白姐姐總是爭吵不斷，最後，她在八月底獨自步入了河流的深水區……\"),\"\\n\",Vue.h(_components.p,null,\"那天夜裡，她沒有和我道晚安，只是和我說她再也忍受不了了。\"),\"\\n\",Vue.h(_components.h2,null,\"另一段回憶\"),\"\\n\",Vue.h(_components.p,null,\"說到底，夢夢一開始其實也是我的粉絲呢。\"),\"\\n\",Vue.h(_components.p,null,\"她曾經有過一位男朋友，儘管其實是單向相戀——「我把你當很好的朋友，你卻喜歡我。」她太喜歡他了，可她沒辦法作為一個小男生喜歡上她，於是那場戀情成為了她下定決心當女孩子的契機，可好景不長，他們後來分開了。夢夢便感覺到，感覺人生失去了意義。\"),\"\\n\",Vue.h(_components.p,null,\"也就是在那時，我恰好在酷安論壇寫關於玩機的實用教程，因為我的某篇文章獲得了很大的流量，得到了官方的推送，我也趁此建立了自己的粉絲群。夢夢嘛，恰好也喜歡研究內核與開發 Magisk 模組，她便來到了我群聊之中，與我聊天聊得很合拍。於是她把心放在了我身上，喜歡上了我，之後我們也就理所當然地成為了情侶。\"),\"\\n\",Vue.h(_components.p,null,\"直到 2023 年 7 月份的時候，我受不住家裡的管制，就決定南下到蘇州找她去了……\"),\"\\n\",Vue.h(_components.h2,null,\"尾聲\"),\"\\n\",Vue.h(_components.p,null,\"「她們兩個呀……是長不大的孩子。並且現在她們已經永遠長不大了。」\"),\"\\n\",Vue.h(_components.p,null,\"「你會想她們嗎？」\"),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"語出《挪威的森林》村上春樹作，林少華譯；第十章【ISBN 9787532776771 P344】\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"trans