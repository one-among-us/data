"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\",strong:\"strong\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"这里记录着一些回忆，却也有一个可能缺失了再也补不全的故事。\"),\"\\n\",Vue.h(_components.p,null,\"我们是生息在不健全世界上的不健全的人，不可能用尺子测量长度，或者用分度器测量角度，如同银行存款般那样毫厘不爽地生活，对吧？\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\"))),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"一段回忆\"),\"\\n\",Vue.h(_components.p,null,\"虽然我从未真正与梦梦见过面，但在我的印象里嘛……她是一个善良可爱的孩子，总是关心着别人。\"),\"\\n\",Vue.h(_components.p,null,\"梦梦喜欢《BanG Dream》，我和她也是在这个圈子里认识的，时间不早不晚。彼时 \",Vue.h(_components.a,{href:\"../profile/execute_darker\"},\"Darker\"),\" 还未被送进武校，她们三个人过得还算开心。\"),\"\\n\",Vue.h(_components.p,null,\"梦梦和我说：她们的关系，正是因为\",Vue.h(_components.strong,null,\"三个人\"),\"才得以稳定。\"),\"\\n\",Vue.h(_components.p,null,\"她们的日常的生活里，有对跨性别友好的猫咖，有平静而温暖的卡布奇诺，有热乎的鸡腿饭，也偶有一起合影的时光。只是梦梦有些内向，并不怎么主动分享她们的日常，总那样腼腆地转发那些满载幸福的照片。\"),\"\\n\",Vue.h(_components.p,null,\"过了不久，梦梦突然告诉我说，Darker 被家里人送进了武校。\"),\"\\n\",Vue.h(_components.p,null,\"我很惊诧，但随后又冷静下来。因着我自己就是武校受害者。所以在梦梦和白下\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-2\",id:\"footnote-ref-2\"},\"2\")),\"，也就是白姐姐前去广西，努力尝试通过各种手段将她捞出来的时候，我也在尝试联系 Darker 的家长尝试沟通，因而得以加上了 Darker 母亲的微信，聊天倒也算大致过得去，可总不见得有什么实际进展。\"),\"\\n\",Vue.h(_components.p,null,\"三个人之中突然少了 Darker 的身影，梦梦和白姐姐总是争吵不断，最后，她在八月底独自步入了河流的深水区……\"),\"\\n\",Vue.h(_components.p,null,\"那天夜里，她没有和我道晚安，只是和我说她再也忍受不了了。\"),\"\\n\",Vue.h(_components.h2,null,\"另一段回忆\"),\"\\n\",Vue.h(_components.p,null,\"说到底，梦梦一开始其实也是我的粉丝呢。\"),\"\\n\",Vue.h(_components.p,null,\"她曾经有过一位男朋友，尽管其实是单向相恋——「我把你当很好的朋友，你却喜欢我。」她太喜欢他了，可她没办法作为一个小男生喜欢上她，于是那场恋情成为了她下定决心当女孩子的契机，可好景不长，他们后来分开了。梦梦便感觉到，感觉人生失去了意义。\"),\"\\n\",Vue.h(_components.p,null,\"也就是在那时，我恰好在酷安论坛写关于玩机的实用教程，因为我的某篇文章获得了很大的流量，得到了官方的推送，我也趁此建立了自己的粉丝群。梦梦嘛，恰好也喜欢研究内核与开发 Magisk 模块，她便来到了我群聊之中，与我聊天聊得很合拍。于是她把心放在了我身上，喜欢上了我，之后我们也就理所当然地成为了情侣。\"),\"\\n\",Vue.h(_components.p,null,\"直到 2023 年 7 月份的时候，我受不住家里的管制，就决定南下到苏州找她去了……\"),\"\\n\",Vue.h(_components.h2,null,\"尾声\"),\"\\n\",Vue.h(_components.p,null,\"「她们两个呀……是长不大的孩子。并且现在她们已经永远长不大了。」\"),\"\\n\",Vue.h(_components.p,null,\"「你会想她们吗？」\"),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"语出《挪威的森林》村上春树作，林少华译；第十章【ISBN 9787532776771 P344】\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"trans