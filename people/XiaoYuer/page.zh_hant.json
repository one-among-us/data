"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({blockquote:\"blockquote\",br:\"br\",h2:\"h2\",p:\"p\"},props.components),PhotoScroll=_components.PhotoScroll;if(!PhotoScroll)_missingMdxReference(\"PhotoScroll\",true);return Vue.h(Vue.Fragment,null,Vue.h(\"h3\",{align:\"center\"},\"篇一 | 追憶故人\"),\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\"文/楓\"),\"\\n\",Vue.h(_components.h2,null,\"簡介\"),\"\\n\",Vue.h(_components.p,null,\"小魚是一個熱情善良的孩子，她喜歡幾乎所有的交通工具，喜歡化學和理工技術相關的東西，心裡始終懷揣著對深空的理想，懷揣著對科學的渴望。\",Vue.h(_components.br),\"\\n\",\"她曾經對我說，化學反應是不會騙人的，而反應裡的光和熱是世界上最美的東西。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"玩危化的時候一定要做好防護喵。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"她很喜歡 SS8-0166 這輛車，也曾因為我的喜歡而從南京前去金溫鐵路看金溫特色塗裝的機車，同時從 24 年開始收集了很多很多的「紅票」。\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo1.webp\",\"${path}/photos/photo2.webp\",\"${path}/photos/photo3.webp\",\"${path}/photos/photo4.webp\"]}),\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\" （小魚從 24 年開始到 26 年收集的部分「紅票」） \"),\"\\n\",Vue.h(_components.h2,null,\"緣起\"),\"\\n\",Vue.h(_components.p,null,\"剛認識她的時候是在 2023 年，那個時候我們還是初中生，因為相同的理想相識，然後成了無話不談的好友。\",Vue.h(_components.br),\"\\n\",\"那天，我剛剛開始策劃探空氣球和探空火箭的計畫。那天我在群組裡詢問有沒有人會畫 PLC，然後她加上了我。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「我會畫 PLC 和寫飛控。」\"),\"\\n\",Vue.h(_components.p,null,\"「哇，可以教我嘛！」\"),\"\\n\",Vue.h(_components.p,null,\"「畫板子很簡單的，我改天有空了就教你喵~」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"那天，是 2023 年一個初秋的夜晚，相識是美好的，那天一群來自天南海北，懷揣著熱血和夢想的初中生聚了起來。\",Vue.h(_components.br),\"\\n\",\"這時，地球是天上一顆星，南京是地上一座城，這天夜晚和往常一樣平靜，但是我們的命運被交織在了一起。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我們每個人都在說以後會有時間的，結果都分道揚鑣了。\"),\"\\n\",Vue.h(_components.p,null,\"——2026-10-07 22:30:40 小魚兒\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"星願\"),\"\\n\",Vue.h(_components.p,null,\"2024 年初，新年伊始，那個時候魚初二，我在上初三，除夕那天我們在討論探空氣球的方案，後半夜的時候，我們開始聊到了對方的愛好，家庭和生活。\",Vue.h(_components.br),\"\\n\",\"那個時候，她告訴我了她是 MTX，我告訴了她我是 MTF，也是那個時候，我才知道她已經由於精神原因休學了。\",Vue.h(_components.br),\"\\n\",\"那天晚上，我們聊得很開心，也第一次走進了對方的內心，那天之後，她開始叫我姐姐，我把她當作一個很厲害的老師，一個很厲害的妹妹。\",Vue.h(_components.br),\"\\n\",\"2024 年 4 月份，我們已經擬定了大致的計畫表。但是由於小魚和我的精神原因，最後還是沒有去實行。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「抱歉各位，看起來只能在 25 年到 26 年去實行我們的計畫了。」\"),\"\\n\",Vue.h(_components.p,null,\"「沒事的，慢慢來吧，摸摸你呀。」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"然後，一群孩子們再次由於現實分開。\",Vue.h(_components.br),\"\\n\",\"只是這次分開之後，再也沒有聚到一起了，雖然大家依舊懷著對群星的好奇，對天空的理想，可理想終歸只是理想，再宏大的理想也不足以影響現實。\"),\"\\n\",Vue.h(_components.h2,null,\"夢碎\"),\"\\n\",Vue.h(_components.p,null,\"雖然夢想停下了腳步，但是生活還在繼續，那個時候是 2024 年中旬，我們在生活中成了無話不談的好友，總會在對方難受的時候去安慰。\",Vue.h(_components.br),\"\\n\",\"似乎一切都在朝著好的方向發展，但是團隊中的成員由於一些社會輿論的原因開始停下了工作，然後群冷了下來……\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「抱歉，還是無限期推遲吧……」\"),\"\\n\",Vue.h(_components.p,null,\"「我們明年就沒有時間了的。」\"),\"\\n\",Vue.h(_components.p,null,\"「我知道…抱歉各位……」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"那天之後，群徹底冷下來了，小魚找我哭了很久很久，她明明很難受，但是她和我說著沒事的，以後會有時間的，是在安慰我，也是在安慰自己。\",Vue.h(_components.br),\"\\n\",\"那天之後，我們埋葬了過去滿腔熱血的自己……\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"後來啊 有個孩子 還沒治好曾經的傷 就被無情地推向了 這殘酷的大人世界\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"然後，她把生活重新看向了公共交通，並開始頻繁的運轉，拍喜歡的機車的照片。把化學和交通當作了理想的代餐，我相信她一定在這過程中重新喜歡上了那些過去的愛好。\"),\"\\n\",Vue.h(\"div\",{style:\"display: flex; margin: auto; gap: 80px; flex-direction: row; justify-self: center; justify-content: center; justify-items: center; flex-wrap: wrap\"},Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo6.webp\",\"${path}/photos/photo8.webp\",\"${path}/photos/photo9.webp\"]}),Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo5.webp\",\"${path}/photos/photo7.webp\",\"${path}/photos/photo11.webp\",\"${path}/photos/photo10.webp\"]})),\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\"（第一組照片是小魚在 25 年 8 月 11 號在金溫；第二組是小魚 25 年 2 月到 2026 年 3 月拍攝的部分照片）\"),\"\\n\",Vue.h(_components.h2,null,\"創傷與苦痛\"),\"\\n\",Vue.h(_components.p,null,\"2025 年的時候，小魚的情緒其實已經出問題了，她本身就有憂鬱，24 年又接觸了跨圈，跨圈的環境讓她本就不佳的精神狀態雪上加霜。\",Vue.h(_components.br),\"\\n\",\"那個時候，是她休學的第二年，本該讀高中的 16 歲卻因一年的休學還在初二，精神疾病又讓她的記憶開始大量的丟失。\",Vue.h(_components.br),\"\\n\",\"直到她丟失了 24 和 25 年的記憶，也忘記了我。等她重新想起來的時候，已經是 26 年的 9 月了。\",Vue.h(_components.br),\"\\n\",\"這時，她已經確診了雙相，也開始不斷的迷茫和恐懼，她說她過去的兩年過得很糟糕，很可怕。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「 @楓 我大概前兩月才想起你，想起你只記得我們很熟，當初有著共同發射火箭和氣球目標還有個群。」\",Vue.h(_components.br),\"\\n\",\"「我感覺我對你的記憶缺失了好大一塊」\"),\"\\n\",Vue.h(_components.p,null,\"「楓：你還好嗎？」\"),\"\\n\",Vue.h(_components.p,null,\"「也許是病重了吧，也許是父母把我逼得無處發洩。」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"那天，是我們時隔半年後重新第一次聊得很開心，我們聊著過去的喜怒哀樂，聊著朋友們的近況。\",Vue.h(_components.br),\"\\n\",\"最後，聊到了未來。她說她過幾天會去試試看病，試著好起來，然後明年去中考，去讓生活重新回到正軌。\"),\"\\n\",Vue.h(_components.h2,null,\"長殤\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 10 月 11 日，她離開了這個世界。\",Vue.h(_components.br),\"\\n\",\"2026 年 9 月 21 日和 2026 年 10 月 5 日她都嘗試了自殺，但是第三次命運女神沒有眷顧她……\",Vue.h(_components.br),\"\\n\",\"警方和她的朋友把她的離開定性為了自殺，但這不是自殺，這是一場透過家庭暴力導致的悲劇，她的父母本可以多次避免悲劇的發生。\",Vue.h(_components.br),\"\\n\",\"但是他們一錯再錯，從讓她停止使用精神藥物開始，然後去說她軀體化，說解離，最後打算拉著她去看中醫，才在不斷的高壓把她逼上了絕路。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我的活路越來越少，他們說身體很重要，而在他們看來我幹什麼都在傷害身體，可是我的身體真的還好嗎？我 od 他們說這樣傷身體我認了，割手傷身體我認了，吃激素我也認了，可是我正常吃藥都覺得我傷身體\",Vue.h(_components.br),\"\\n\",\"我吃藥睡個覺說我這吃多了那重複了，我要是能睡好用吃這麼多嗎我掉頭髮多也怪在藥上，白天沒精神也怪在藥上，怪完了要拉我去看中醫，讓我吃中藥。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"我在責怪她父母，其實也是在責怪我自己，怪我的遲鈍、怪我的無能，我本有很多機會可以救下她，但是我沒有做到……\"),\"\\n\",Vue.h(_components.h2,null,\"星碎 | 寂\"),\"\\n\",Vue.h(_components.p,null,\"終於還是食言了啊，明明說好了這輩子一定要來見我一面的呢……\",Vue.h(_components.br),\"\\n\",\"曾經有一個小妹妹對我說，她仰慕我，希望可以成為我，那個時候我太自卑，沒有當真，直到失去後才發覺她是認真的。\",Vue.h(_components.br),\"\\n\",\"然後，自責、悲痛，我曾以為我不會再因為見到人的離去而痛苦，但我在飛往海外的飛機上確定了她的離開時，我的心是絞痛的。\",Vue.h(_components.br),\"\\n\",\"驚覺故人成永隔，淚流滿面濕衣襟。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「@楓 你也是我仰慕的人」\",Vue.h(_components.br),\"\\n\",\"「@楓 我這輩子一定見你一面，大姐姐」\",Vue.h(_components.br),\"\\n\",\"「我自我感覺活不長了，今年精神狀態超級差。過兩天住院去了但願治好我吧。不過我求他不要給我 MECT……」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"最後的最後，故事終究還是故事。\",Vue.h(_components.br),\"\\n\",\"這世上，從來沒有過一直樂觀的小魚，只有一位希望未來會好的孩子，她把她心愛的收藏留在了不會結束的夏天。\\n命運在時間的河流裡轉了個彎。留下了充滿遺憾的過去和最後的離別。如果有下輩子，請一定要幸福。\",Vue.h(_components.br),\"\\n\",\"晚安，魚。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"星願辭\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"初秋星願集群英，燈下論天到五更。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"君能製器通玄算，我欲乘風探太清。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"金陵城闕星垂野，南北少年同一明。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"歲暮更闌言漸深，各傾心事淚沾襟。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"始知君病久休學，我亦幽憂世所侵。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"春來尺牘新盟在，流言蜚語散故人。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"舊約重逢空有語，長天未竟少年身。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"金溫道上尋塗色，朱券收來拾舊春。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"鐵龍長鳴空入夢，壯心埋沒竟成塵。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"浮言風雨摧殘燭，病骨庭闈迫歲寒。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"藥石中停求異術，記憶如沙不可摶。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"九月重憶十月別，家門逼迫無生處。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"兩番赴死天未許，三度折翼路方窮。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"雲翼忽傳凶信至，重洋淚落不成聲。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"君曾仰慕願成我，我愧低回負此情。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"遺藏長夏留朱券，星碎人間夜未明。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"從今無復長歌笑，唯見寒星照夜行。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; margin-top: 1.2em; padding-left: 14%;\"},\"——以此詩，悼小魚\"),\"\\n\"),\"\\n\",Vue.h(\"h3\",{align:\"center\"},\"篇二 | 離別前後\"),\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\"文/水中月\"),\"\\n\",Vue.h(_components.h2,null,\"簡介\"),\"\\n\",Vue.h(_components.p,null,\"小魚兒，曾是南京的一位公車迷、火車迷，也曾想要像其他跨性別者一樣，讓自己變得好看。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"小魚兒——似乎很多人也在用這個網名呢。\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"突如其來的噩耗\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"一則訊息，一通電話，一個人無聲的沉默。只有耳機裡的歌曲一直在響個不停。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 10 月 11 日，水中月像往常一樣醒來，那天他起得有點早，7 點半就醒了。他像往常一樣拿起手機看訊息，他看到了小魚兒在凌晨兩點半傳來的訊息：「晚安，只有你不會救我了。」以及幾張裝著化學試劑瓶子的照片。\"),\"\\n\",Vue.h(_components.p,null,\"那天中午，水中月還收到了南京的警察打來的電話……自那一刻起，他那天耳機裡的歌聲就沒有停過……\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「可是你明明已經說好了寒假要來找我玩的……」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"小魚兒在遺書中寫道，大約從 4 年前起，她渴望擁有好看的長相，渴望成為可愛、被喜歡的女孩子，甚至想成為「男娘」或作為跨女生活。但現實中，她對自己的五官、聲音、身材及體毛感到極度噁心與自卑，甚至覺得自己是「水色系男娘做題蛆」\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"，完全不配當一個跨性別女性。她覺得自己長得很醜，每次在網上看到好看的「男娘」，或者是好看的女孩子，她都會非常嚮往。她希望能透過穿好看的衣服、扮演二次元角色來改變現狀，但因不善於也不敢表達，更害怕被外界發現變化，以及遭到家人的阻攔反對，最終放棄了嘗試。她曾夢到 HRT 被發現，夢見媽媽對她說：「你要是還繼續，我就要殺了你！」可她堅持要繼續，於是夢中的她便被殺了。這聽上去或許有些可笑——可她真的做過這樣的夢。\"),\"\\n\",Vue.h(_components.p,null,\"她自殺也並不是為了下輩子轉世投個好胎，只是想結束這一切。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"如果過程無法選擇，又不是自己喜歡的過程，不如早點結束一切。\"),\"\\n\",Vue.h(_components.p,null,\"寫得一坨屎——我知道我寫得很爛，但我也只能寫成這樣了。\"),\"\\n\",Vue.h(_components.p,null,\"晚安，這個世界。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 10 月 11 日凌晨，她終於決定——離開這個世界，結束這一切。\"),\"\\n\",Vue.h(_components.h2,null,\"父母找上來了\"),\"\\n\",Vue.h(_components.p,null,\"沒過幾天，水中月見到了小魚兒的家長——她的爸媽一起來的。「我還是出去一下吧，」剛坐下來，她的媽媽就哽咽道，「我聽到還是有點難受……」\"),\"\\n\",Vue.h(_components.p,null,\"「他（原文如此）走得應該蠻勇敢的吧——走得蠻決絕的，他可能對這個世界也沒什麼留戀了……他近幾年斷斷續續地休學、復學，他的朋友也少——可能是他的性格比較自卑吧。他不太想依賴家庭，也不想要家裡的錢，他想靠他自己的能力掙錢……他哭著跟我說了一些心裡話，以前他怕家裡人反對，於是不敢說，他說他想養一隻貓，還想讓自己變得漂亮……」小魚兒的爸爸淡定地說道。\"),\"\\n\",Vue.h(_components.p,null,\"小魚兒曾經說過，她跟水中月特別像——性格特別像，但是又不太像。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「最喜歡水中月了。」小魚兒曾說道。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"在小魚兒離開的前幾天，她說她想養一隻貓。她的家人答應了她——給她買一隻貓來養，本來打算 11 號那天就去買下那隻挑選好的貓，把它接回家裡養——可是那隻貓卻再也等不到屬於它的主人了。\"),\"\\n\",Vue.h(_components.h2,null,\"潦草的結尾\"),\"\\n\",Vue.h(_components.p,null,\"那天，貓還在寵物店裡蜷縮著，而小魚兒卻永遠停在了那個冰冷的凌晨。她帶走了所有未能說出口的掙扎與自卑，留給這個世界的，只有那句輕聲的「晚安」，「只有你不會救我了」。陽光照常升起，卻再也照不到小魚兒心裡的陰霾。而對於在乎她的那些人來說，這聲平靜的告別，卻是一道永遠無法癒合的傷口。\"),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"水色系男娘做題蛆：此處是小魚兒的自嘲。「做題蛆」是大陸網路對只會應試做題者的極端貶稱；「男娘」泛指打扮偏可愛女性化的男性；「水色系」指水藍色調穿搭。三者連用是圈內一種刻板印象式的貶低：指埋頭做題、不擅打扮的男娘。即使套上水色系穿搭，仍被認為「美商差」，氣質上脫不去做題家底色。小魚兒以此自嘲，形容自己既想當好看的跨性別女性，又覺得本質上只是個「做題蛆」，連穿搭都救不了。\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"translate(0,2)\"},Vue.h(\"circle\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient2);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path1\",cx:\"10.667834\",cy:\"6\",r:\"4.5818877\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:#ff8373;stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",d:\"M 9.9178343,10.577036 H 1.7971455\",id:\"path2\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient4);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path3\",d:\"M 8.0000001,11.231817 4.7681825,8.0000001 7.9999999,4.7681825 11.231817,7.9999999 Z\",transform:\"translate(-3.6894439,2.577036)\"})))))))}function MDXContent(props){if(props===void 0)props={};var _ref=props.components||{},MDXLayout=_ref.wrapper;return MDXLayout?Vue.h(MDXLayout,_extends({},props),Vue.h(_createMdxContent,_extends({},props))):_createMdxContent(props)}function _missingMdxReference(id,component){throw new Error(\"Expected \"+(component?\"component\":\"object\")+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"