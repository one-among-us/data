"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({blockquote:\"blockquote\",h2:\"h2\",p:\"p\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.p,null,\"小魚兒，曾是南京的一位公車迷、火車迷，也曾想要像其他跨性別者一樣，讓自己變得好看。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"小魚兒——似乎很多人也在用這個網名呢。\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"突如其來的噩耗\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"一則訊息，一通電話，一個人無聲的沉默。只有耳機裡的歌曲一直在響個不停。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 10 月 11 日，水中月像往常一樣醒來，那天他起得有點早，7 點半就醒了。他像往常一樣拿起手機看訊息，他看到了小魚兒在凌晨兩點半傳來的訊息：「晚安，只有你不會救我了。」以及幾張裝著化學試劑瓶子的照片。\"),\"\\n\",Vue.h(_components.p,null,\"那天中午，水中月還收到了南京的警察打來的電話……自那一刻起，他那天耳機裡的歌聲就沒有停過……\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「可是你明明已經說好了寒假要來找我玩的……」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"小魚兒在遺書中寫道，大約從 4 年前起，她渴望擁有好看的長相，渴望成為可愛、被喜歡的女孩子，甚至想成為「男娘」或作為跨女生活。但現實中，她對自己的五官、聲音、身材及體毛感到極度噁心與自卑，甚至覺得自己是「水色系男娘做題蛆」\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"，完全不配當一個跨性別女性。她覺得自己長得很醜，每次在網上看到好看的「男娘」，或者是好看的女孩子，她都會非常嚮往。她希望能透過穿好看的衣服、扮演二次元角色來改變現狀，但因不善於也不敢表達，更害怕被外界發現變化，以及遭到家人的阻攔反對，最終放棄了嘗試。她曾夢到 HRT 被發現，夢見媽媽對她說：「你要是還繼續，我就要殺了你！」可她堅持要繼續，於是夢中的她便被殺了。這聽上去或許有些可笑——可她真的做過這樣的夢。\"),\"\\n\",Vue.h(_components.p,null,\"她自殺也並不是為了下輩子轉世投個好胎，只是想結束這一切。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"如果過程無法選擇，又不是自己喜歡的過程，不如早點結束一切。\"),\"\\n\",Vue.h(_components.p,null,\"寫得一坨屎——我知道我寫得很爛，但我也只能寫成這樣了。\"),\"\\n\",Vue.h(_components.p,null,\"晚安，這個世界。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 10 月 11 日凌晨，她終於決定——離開這個世界，結束這一切。\"),\"\\n\",Vue.h(_components.h2,null,\"父母找上來了\"),\"\\n\",Vue.h(_components.p,null,\"沒過幾天，水中月見到了小魚兒的家長——她的爸媽一起來的。「我還是出去一下吧，」剛坐下來，她的媽媽就哽咽道，「我聽到還是有點難受……」\"),\"\\n\",Vue.h(_components.p,null,\"「他（原文如此）走得應該蠻勇敢的吧——走得蠻決絕的，他可能對這個世界也沒什麼留戀了……他近幾年斷斷續續地休學、復學，他的朋友也少——可能是他的性格比較自卑吧。他不太想依賴家庭，也不想要家裡的錢，他想靠他自己的能力掙錢……他哭著跟我說了一些心裡話，以前他怕家裡人反對，於是不敢說，他說他想養一隻貓，還想讓自己變得漂亮……」小魚兒的爸爸淡定地說道。\"),\"\\n\",Vue.h(_components.p,null,\"小魚兒曾經說過，她跟水中月特別像——性格特別像，但是又不太像。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「最喜歡水中月了。」小魚兒曾說道。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"在小魚兒離開的前幾天，她說她想養一隻貓。她的家人答應了她——給她買一隻貓來養，本來打算 11 號那天就去買下那隻挑選好的貓，把它接回家裡養——可是那隻貓卻再也等不到屬於它的主人了。\"),\"\\n\",Vue.h(_components.h2,null,\"潦草的結尾\"),\"\\n\",Vue.h(_components.p,null,\"那天，貓還在寵物店裡蜷縮著，而小魚兒卻永遠停在了那個冰冷的凌晨。她帶走了所有未能說出口的掙扎與自卑，留給這個世界的，只有那句輕聲的「晚安」，「只有你不會救我了」。陽光照常升起，卻再也照不到小魚兒心裡的陰霾。而對於在乎她的那些人來說，這聲平靜的告別，卻是一道永遠無法癒合的傷口。\"),\"\\n\",Vue.h(_components.p,null,\"條目貢獻：水中月\"),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"水色系男娘做題蛆：此處是小魚兒的自嘲。「做題蛆」是大陸網路對只會應試做題者的極端貶稱；「男娘」泛指打扮偏可愛女性化的男性；「水色系」指水藍色調穿搭。三者連用是圈內一種刻板印象式的貶低：指埋頭做題、不擅打扮的男娘。即使套上水色系穿搭，仍被認為「美商差」，氣質上脫不去做題家底色。小魚兒以此自嘲，形容自己既想當好看的跨性別女性，又覺得本質上只是個「做題蛆」，連穿搭都救不了。\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"translate(0,2)\"},Vue.h(\"circle\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient2);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path1\",cx:\"10.667834\",cy:\"6\",r:\"4.5818877\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:#ff8373;stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",d:\"M 9.9178343,10.577036 H 1.7971455\",id:\"path2\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient4);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path3\",d:\"M 8.0000001,11.231817 4.7681825,8.0000001 7.9999999,4.7681825 11.231817,7.9999999 Z\",transform:\"translate(-3.6894439,2.577036)\"})))))))}function MDXContent(props){if(props===void 0)props={};var _ref=props.components||{},MDXLayout=_ref.wrapper;return MDXLayout?Vue.h(MDXLayout,_extends({},props),Vue.h(_createMdxContent,_extends({},props))):_createMdxContent(props)}"