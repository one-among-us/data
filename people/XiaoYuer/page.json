"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({blockquote:\"blockquote\",br:\"br\",h2:\"h2\",p:\"p\"},props.components),PhotoScroll=_components.PhotoScroll;if(!PhotoScroll)_missingMdxReference(\"PhotoScroll\",true);return Vue.h(Vue.Fragment,null,Vue.h(\"h3\",{align:\"center\"},\"篇一 | 追忆故人\"),\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\"文/楓\"),\"\\n\",Vue.h(_components.h2,null,\"简介\"),\"\\n\",Vue.h(_components.p,null,\"小鱼是一个热情善良的孩子，她喜欢几乎所有的交通工具，喜欢化学和理工技术相关的东西，心里始终怀揣着对深空的理想，怀揣着对科学的渴望。\",Vue.h(_components.br),\"\\n\",\"她曾经对我说，化学反应是不会骗人的，而反应里的光和热是世界上最美的东西。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"玩危化的时候一定要做好防护喵。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"她很喜欢 SS8-0166 这辆车，也曾因为我的喜欢而从南京前去金温铁路看金温特色涂装的机车，同时从 24 年开始收集了很多很多的「红票」。\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo1.webp\",\"${path}/photos/photo2.webp\",\"${path}/photos/photo3.webp\",\"${path}/photos/photo4.webp\"]}),\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\" （小鱼从 24 年开始到 26 年收集的部分「红票」） \"),\"\\n\",Vue.h(_components.h2,null,\"缘起\"),\"\\n\",Vue.h(_components.p,null,\"刚认识她的时候是在 2023 年，那个时候我们还是初中生，因为相同的理想相识，然后成了无话不谈的好友。\",Vue.h(_components.br),\"\\n\",\"那天，我刚刚开始策划探空气球和探空火箭的项目。那天我在群组里询问有没有人会画 PLC，然后她加上了我。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「我会画 PLC 和写飞控。」\"),\"\\n\",Vue.h(_components.p,null,\"「哇，可以教我嘛！」\"),\"\\n\",Vue.h(_components.p,null,\"「画板子很简单的，我改天有空了就教你喵~」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"那天，是 2023 年一个初秋的夜晚，相识是美好的，那天一群来自天南海北，怀揣着热血和梦想的初中生聚了起来。\",Vue.h(_components.br),\"\\n\",\"这时，地球是天上一颗星，南京是地上一座城，这天夜晚和往常一样平静，但是我们的命运被交织在了一起。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我们每个人都在说以后会有时间的，结果都分道扬镳了。\"),\"\\n\",Vue.h(_components.p,null,\"——2026-10-07 22:30:40 小鱼儿\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"星愿\"),\"\\n\",Vue.h(_components.p,null,\"2024 年初，新年伊始，那个时候鱼初二，我在上初三，除夕那天我们在讨论探空气球的方案，后半夜的时候，我们开始聊到了对方的爱好，家庭和生活。\",Vue.h(_components.br),\"\\n\",\"那个时候，她告诉我了她是 MTX，我告诉了她我是 MTF，也是那个时候，我才知道她已经由于精神原因休学了。\",Vue.h(_components.br),\"\\n\",\"那天晚上，我们聊得很开心，也第一次走进了对方的内心，那天之后，她开始叫我姐姐，我把她当作一个很厉害的老师，一个很厉害的妹妹。\",Vue.h(_components.br),\"\\n\",\"2024 年 4 月份，我们已经拟定了大致的计划表。但是由于小鱼和我的精神原因，最后还是没有去实行。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「抱歉各位，看起来只能在 25 年到 26 年去实行我们的计划了。」\"),\"\\n\",Vue.h(_components.p,null,\"「没事的，慢慢来吧，摸摸你呀。」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"然后，一群孩子们再次由于现实分开。\",Vue.h(_components.br),\"\\n\",\"只是这次分开之后，再也没有聚到一起了，虽然大家依旧怀着对群星的好奇，对天空的理想，可理想终归只是理想，再宏大的理想也不足以影响现实。\"),\"\\n\",Vue.h(_components.h2,null,\"梦碎\"),\"\\n\",Vue.h(_components.p,null,\"虽然梦想停下了脚步，但是生活还在继续，那个时候是 2024 年中旬，我们在生活中成了无话不谈的好友，总会在对面难受的时候去安慰。\",Vue.h(_components.br),\"\\n\",\"似乎一切都在朝着好的方向发展，但是团队中的成员由于一些社会舆论的原因开始停下了工作，然后群冷了下来……\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「抱歉，还是无限期推迟吧……」\"),\"\\n\",Vue.h(_components.p,null,\"「我们明年就没有时间了的。」\"),\"\\n\",Vue.h(_components.p,null,\"「我知道…抱歉各位……」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"那天之后，群彻底冷下来了，小鱼找我哭了很久很久，她明明很难受，但是她和我说着没事的，以后会有时间的，是在安慰我，也是在安慰自己。\",Vue.h(_components.br),\"\\n\",\"那天之后，我们埋葬了过去满腔热血的自己……\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"后来啊 有个孩子 还没治好曾经的伤 就被无情地推向了 这残酷的大人世界\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"然后，她把生活重新看向了公共交通，并开始频繁的运转，拍喜欢的机车的照片。把化学和交通当作了理想的代餐，我相信她一定在这过程中重新喜欢上了那些过去的爱好。\"),\"\\n\",Vue.h(\"div\",{style:\"display: flex; margin: auto; gap: 80px; flex-direction: row; justify-self: center; justify-content: center; justify-items: center; flex-wrap: wrap\"},Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo6.webp\",\"${path}/photos/photo8.webp\",\"${path}/photos/photo9.webp\"]}),Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo5.webp\",\"${path}/photos/photo7.webp\",\"${path}/photos/photo11.webp\",\"${path}/photos/photo10.webp\"]})),\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\"（第一组照片是小鱼在 25 年 8 月 11 号在金温；第二组是小鱼 25 年 2 月到 2026 年 3 月拍摄的部分照片）\"),\"\\n\",Vue.h(_components.h2,null,\"创伤与苦痛\"),\"\\n\",Vue.h(_components.p,null,\"2025 年的时候，小鱼的情绪其实已经出问题了，她本身就有抑郁，24 年又接触了跨圈，跨圈的环境让她本就不佳的精神状态雪上加霜。\",Vue.h(_components.br),\"\\n\",\"那个时候，是她休学的第二年，本该读高中的 16 岁却因一年的休学还在初二，精神疾病又让她的记忆开始大量的丢失。\",Vue.h(_components.br),\"\\n\",\"直到她丢失了 24 和 25 年的记忆，也忘记了我。等她重新想起来的时候，已经是 26 年的 9 月了。\",Vue.h(_components.br),\"\\n\",\"这时，她已经确诊了双相，也开始不断的迷茫和恐惧，她说她过去的两年过得很糟糕，很可怕。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「 @楓 我大概前两月才想起你，想起你只记得我们很熟，当初有着共同发射火箭和气球目标还有个群。」\",Vue.h(_components.br),\"\\n\",\"「我感觉我对你的记忆缺失了好大一块」\"),\"\\n\",Vue.h(_components.p,null,\"「楓：你还好吗？」\"),\"\\n\",Vue.h(_components.p,null,\"「也许是病重了吧，也许是父母把我逼得无处发泄。」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"那天，是我们时隔半年后重新第一次聊得很开心，我们聊着过去的喜怒哀乐，聊着朋友们的近况。\",Vue.h(_components.br),\"\\n\",\"最后，聊到了未来。她说她过几天会去试试看病，试着好起来，然后明年去中考，去让生活重新回到正轨。\"),\"\\n\",Vue.h(_components.h2,null,\"长殇\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 10 月 11 日，她离开了这个世界。\",Vue.h(_components.br),\"\\n\",\"2026 年 9 月 21 日和 2026 年 10 月 5 日她都尝试了自杀，但是第三次命运女神没有眷顾她……\",Vue.h(_components.br),\"\\n\",\"警方和她的朋友把她的离开定性为了自杀，但这不是自杀，这是一场通过家庭暴力导致的悲剧，她的父母本可以多次避免悲剧的发生。\",Vue.h(_components.br),\"\\n\",\"但是他们一错再错，从让她停止使用精神药物开始，然后去说她躯体化，说解离，最后打算拉着她去看中医，才在不断的高压把她逼上了绝路。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我的活路越来越少，他们说身体很重要，而在他们看来我干什么都在伤害身体，可是我的身体真的还好吗？我 od 他们说这样伤身体我认了，割手伤身体我认了，吃激素我也认了，可是我正常吃药都觉得我伤身体\",Vue.h(_components.br),\"\\n\",\"我吃药睡个觉说我这吃多了那重复了，我要是能睡好用吃这么多吗我掉头发多也怪在药上，白天没精神也怪在药上，怪完了要拉我去看中医，让我吃中药。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"我在责怪她父母，其实也是在责怪我自己，怪我的迟钝、怪我的无能，我本有很多机会可以救下她，但是我没有做到……\"),\"\\n\",Vue.h(_components.h2,null,\"星碎 | 寂\"),\"\\n\",Vue.h(_components.p,null,\"终于还是食言了啊，明明说好了这辈子一定要来见我一面的呢……\",Vue.h(_components.br),\"\\n\",\"曾经有一个小妹妹对我说，她仰慕我，希望可以成为我，那个时候我太自卑，没有当真，直到失去后才发觉她是认真的。\",Vue.h(_components.br),\"\\n\",\"然后，自责、悲痛，我曾以为我不会再因为见到人的离去而痛苦，但我在飞往海外的飞机上确定了她的离开时，我的心是绞痛的。\",Vue.h(_components.br),\"\\n\",\"惊觉故人成永隔，泪流满面湿衣襟。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「@楓 你也是我仰慕的人」\",Vue.h(_components.br),\"\\n\",\"「@楓 我这辈子一定见你一面，大姐姐」\",Vue.h(_components.br),\"\\n\",\"「我自我感觉活不长了，今年精神状态超级差。过两天住院去了但愿治好我吧。不过我求他不要给我 MECT……」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"最后的最后，故事终究还是故事。\",Vue.h(_components.br),\"\\n\",\"这世上，从来没有过一直乐观的小鱼，只有一位希望未来会好的孩子，她把她心爱的收藏留在了不会结束的夏天。\\n命运在时间的河流里转了个弯。留下了充满遗憾的过去和最后的离别。如果有下辈子，请一定要幸福。\",Vue.h(_components.br),\"\\n\",\"晚安，鱼。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"星愿辞\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"初秋星愿集群英，灯下论天到五更。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"君能制器通玄算，我欲乘风探太清。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"金陵城阙星垂野，南北少年同一明。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"岁暮更阑言渐深，各倾心事泪沾襟。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"始知君病久休学，我亦幽忧世所侵。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"春来尺牍新盟在，流言蜚语散故人。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"旧约重逢空有语，长天未竟少年身。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"金温道上寻涂色，朱券收来拾旧春。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"铁龙长鸣空入梦，壮心埋没竟成尘。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"浮言风雨摧残烛，病骨庭闱迫岁寒。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"药石中停求异术，记忆如沙不可抟。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"九月重忆十月别，家门逼迫无生处。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"两番赴死天未许，三度折翼路方穷。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"云翼忽传凶信至，重洋泪落不成声。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"君曾仰慕愿成我，我愧低回负此情。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"遗藏长夏留朱券，星碎人间夜未明。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; line-height: 2;\"},\"从今无复长歌笑，唯见寒星照夜行。\"),\"\\n\",Vue.h(\"div\",{style:\"text-align: center; margin-top: 1.2em; padding-left: 14%;\"},\"——以此诗，悼小鱼\"),\"\\n\"),\"\\n\",Vue.h(\"h3\",{align:\"center\"},\"篇二 | 离别前后\"),\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\"文/水中月\"),\"\\n\",Vue.h(_components.h2,null,\"简介\"),\"\\n\",Vue.h(_components.p,null,\"小鱼儿，曾是南京的一位公交车迷、火车迷，也曾想要像其他跨性别者一样，让自己变得好看。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"小鱼儿——似乎很多人也在用这个网名呢。\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"突如其来的噩耗\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"一则消息，一通电话，一个人无声的沉默。只有耳机里的歌曲一直在响个不停。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 10 月 11 日，水中月像往常一样醒来，那天他起得有点早，7 点半就醒了。他像往常一样拿起手机看消息，他看到了小鱼儿在凌晨两点半发来的消息：「晚安，只有你不会救我了。」以及几张装着化学试剂瓶子的照片。\",Vue.h(_components.br),\"\\n\",\"那天中午，水中月还收到了南京的民警打来的电话……自那一刻起，他那天耳机里的歌声就没有停过……\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「可是你明明已经说好了寒假要来找我玩的……」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"小鱼儿在遗书中写道，大约从 4 年前起，她渴望拥有好看的长相，渴望成为可爱、被喜欢的女孩子，甚至想成为「男娘」或作为跨女生活。但现实中，她对自己的五官、声音、身材及体毛感到极度恶心与自卑，甚至觉得自己是「水色系男娘做题蛆」，完全不配当一个跨性别女性。她觉得自己长得很丑，每次在网上看到好看的「男娘」，或者是好看的女孩子，她都会非常向往。她希望能通过穿好看的衣服、扮演二次元角色来改变现状，但因不善于也不敢表达，更害怕被外界发现变化，以及遭到家人的阻拦反对，最终放弃了尝试。她曾梦到 HRT 被发现，梦见妈妈对她说：「你要是还继续，我就要杀了你！」可她坚持要继续，于是梦中的她便被杀了。这听上去或许有些可笑——可她真的做过这样的梦。\",Vue.h(_components.br),\"\\n\",\"她自杀也并不是为了下辈子转世投个好胎，只是想结束这一切。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"如果过程无法选择，又不是自己喜欢的过程，不如早点结束一切。\"),\"\\n\",Vue.h(_components.p,null,\"写得一坨屎——我知道我写得很烂，但我也只能写成这样了。\"),\"\\n\",Vue.h(_components.p,null,\"晚安，这个世界。\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"过去的录影与残存的回忆\"),\"\\n\",Vue.h(_components.p,null,\"一周过去了，水中月收到了一条私信——是一张录影里的截图，对方把截图里的一个人框了出来——她留着不长不短的头发，戴着一副黑框眼镜，穿着一件黑色衬衫，也在拿着手机拍摄。\"),\"\\n\",Vue.h(_components.p,null,\"「这位是不是小鱼儿？」对方问道，随后发来了那段录影。\"),\"\\n\",Vue.h(_components.p,null,\"那段影像是小鱼儿在上海某位同类的生日聚会上拍摄的，画面中的她还有说有笑的——还在举着灯牌摇晃，随后她也拿上手机一起录像。围坐在小鱼儿旁边的，还有跟她一样，同为跨性别女性的同类。那是她极少数能卸下伪装、感受到归属与快乐的时刻。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"她遇到自己同类的时候，一定是她最开心、最幸福的时刻了。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"「是她了……就是她。」看着视频里熟悉的打扮与她的手机外观，水中月坚定地回答道，「去年我同她一起旅游的时候，她也是这么个打扮。」\"),\"\\n\",Vue.h(_components.p,null,\"去年的那场旅游，小鱼儿跟着水中月一起，去过了好几个城市，也见到了许多的推友。刚开始见到小鱼儿的时候，水中月就戏称她「是个帅小伙，与一位举着『长枪大炮相机』的大佬年轻时候的模样有八九分相像」——殊不知，这样的玩笑无形中成了加重她性别焦虑的隐秘刺痛。\"),\"\\n\",Vue.h(_components.p,null,\"在后来的私信里，小鱼儿也曾毫无保留地向水中月吐露过她的依赖与绝望：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「不许你叫我陈某某！」\",Vue.h(_components.br),\"\\n\",\"「我好累啊，去年跟你一起的旅行好像是我最后一次感受到真正的快乐了……我从来没这么幸福过」\",Vue.h(_components.br),\"\\n\",\"「好想跟你在一起啊」\",Vue.h(_components.br),\"\\n\",\"「我喜欢上你了」\",Vue.h(_components.br),\"\\n\",\"「我好想去你家玩 w」\",Vue.h(_components.br),\"\\n\",\"「我好想跟你幸福……可是我好像活不到那时候了……」\",Vue.h(_components.br),\"\\n\",\"「我又哭了……已经是每晚睡前必须经历的了」\",Vue.h(_components.br),\"\\n\",\"「那就这样吧，终止这个话题」\",Vue.h(_components.br),\"\\n\",\"「我想买台电脑，你有什么推荐的配置品牌吗？我问认真的」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 10 月 11 日凌晨，她终于决定——离开这个世界，结束这一切。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「晚安，只有你不会救我了。」\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"父母找上来了\"),\"\\n\",Vue.h(_components.p,null,\"没过几天，水中月见到了小鱼儿的家长——她的爸妈一起来的。「我还是出去一下吧，」刚坐下来，她的妈妈就哽咽道，「我听到还是有点难受……」\",Vue.h(_components.br),\"\\n\",\"「他（原文如此）走得应该蛮勇敢的吧——走得蛮决绝的，他可能对这个世界也没什么留恋了……他近几年断断续续地休学、复学，他的朋友也少——可能是他的性格比较自卑吧。他不太想依赖家庭，也不想要家里的钱，他想靠他自己的能力挣钱……他哭着跟我说了一些心里话，以前他怕家里人反对，于是不敢说，他说他想养一只猫，还想让自己变得漂亮……」小鱼儿的爸爸淡定地说道。\",Vue.h(_components.br),\"\\n\",\"小鱼儿曾经说过，她跟水中月特别像——性格特别像，但是又不太像。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「最喜欢水中月了。」小鱼儿曾说道。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"在小鱼儿离开的前几天，她说她想养一只猫。她的家人答应了她——给她买一只猫来养，本来打算 11 号那天就去买下那只挑选好的猫，把它接回家里养——可是那只猫却再也等不到属于它的主人了。\"),\"\\n\",Vue.h(_components.h2,null,\"潦草的结尾\"),\"\\n\",Vue.h(_components.p,null,\"那天，猫还在宠物店里蜷缩着，而小鱼儿却永远停在了那个冰冷的凌晨。她带走了所有未能说出口的挣扎与自卑，留给这个世界的，只有那句轻声的「晚安」，「只有你不会救我了」。阳光照常升起，却再也照不到小鱼儿心里的阴霾。而对于在乎她的那些人来说，这声平静的告别，却是一道永远无法愈合的伤口。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"你走之前还问我有没有兴趣给你的头像做个蓝粉白背景……\"),\"\\n\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo12.webp\"]}))}function MDXContent(props){if(props===void 0)props={};var _ref=props.components||{},MDXLayout=_ref.wrapper;return MDXLayout?Vue.h(MDXLayout,_extends({},props),Vue.h(_createMdxContent,_extends({},props))):_createMdxContent(props)}function _missingMdxReference(id,component){throw new Error(\"Expected \"+(component?\"component\":\"object\")+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"