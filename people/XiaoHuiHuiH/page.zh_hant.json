"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",br:\"br\",h2:\"h2\",p:\"p\"},props.components),PhotoScroll=_components.PhotoScroll;if(!PhotoScroll)_missingMdxReference(\"PhotoScroll\",true);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"簡介\"),\"\\n\",Vue.h(_components.p,null,\"小馬咴咴，自媒體創作者、B 站創作者，跨性別女性，一個充滿爭議的人。\"),\"\\n\",Vue.h(_components.p,null,\"2024 年起，小馬咴咴逐漸公開自己的跨性別女性身分，並開始接受荷爾蒙替代療法。身分的改變也成為她生命中一個重要的轉折點。她開始重新認識自己的身體、性別與人格，也開始思考：當曾經熟悉的自己逐漸遠去，一個人究竟要怎樣重新學習生活。\"),\"\\n\",Vue.h(_components.p,null,\"她曾以「馬哥」「小咴咴」等稱呼書寫自己的變化，將過去與現在的自己置於同一段敘事之中。她並沒有把性別轉換描述成一條簡單而明亮的道路，而是記錄其中的遲疑、懷念、掙扎與重新建立。她知道自己失去了一部分熟悉的東西，卻也在努力擁抱那個終於能夠被自己承認的「她」。\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo0.webp\",\"${path}/photos/photo1.webp\",\"${path}/photos/photo2.webp\"]}),\"\\n\",Vue.h(_components.p,null,\"搬家到加拿大後，她的創作逐漸從早年的網路梗文化轉向更加私人和現實的表達。她關注跨性別者的處境，也關注家庭控制、青少年困境、無障礙設施等社會議題。她常常從身邊的「壞消息」出發，追問那些看不見的壓力究竟如何一步步將人推向困境。\"),\"\\n\",Vue.h(_components.p,null,\"與此同時，她的現實生活也並不平靜。2025 年至 2026 年初，她經歷了親密關係變化、室友矛盾以及其他複雜的人際糾紛。網路與現實彼此交織，使她後期的生活充滿了拉扯與疲憊。她並非沒有犯過錯，也並非始終清醒而堅定，她只是一個在努力尋找自己位置的人。\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 1 月，她參與主導製作跨性別紀錄片《「我們消費的『時尚』，是她背負的一生」——跨性別紀錄片》\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"，試圖討論跨性別者如何被觀看，以及一個具體的人如何在標籤之外保有自己的真實與尊嚴。她原本希望將正片命名為《我們活著才是對惡意最大的反抗》，並解釋這是為了鼓勵身處困難中的人繼續活下去。\"),\"\\n\",Vue.h(_components.p,null,\"生命最後的日子裡，她依然與朋友保持聯絡，也曾試圖重新整理自己的人生，感謝曾經幫助過她的人，也試著尋找繼續向前的理由。\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 2 月 13 日，小馬咴咴在多倫多離世，年僅 21 歲。\"),\"\\n\",Vue.h(_components.p,null,\"她的一生並不能被某一個身分、某一次爭議，或者生命最後的那段時間所概括。跨性別之後的她，有過困惑，也有過勇氣；有過失去，也有過重新獲得；她注視自己的同時，也一直注視著別人。\"),\"\\n\",Vue.h(_components.p,null,\"她曾試圖回答「我是誰」，也曾試圖告訴身處困境中的人：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我們活著才是對惡意最大的反抗。\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"ServalCandle 的回憶\"),\"\\n\",Vue.h(_components.p,null,\"第一次和咴咴見面，是在 2024 年 3 月。\"),\"\\n\",Vue.h(_components.p,null,\"那時多倫多的雪還沒有完全融化。我剛經歷了自己人生中最糟糕的事情之一，覺得自己的人生簡直像個笑話，也剛剛經歷了一次自殺未遂。\"),\"\\n\",Vue.h(_components.p,null,\"那天是在 Eaton Centre。她一蹦一跳地出現，充滿活力，甚至亂入了新聞直播的鏡頭，在主持人身後賣萌、比耶。\"),\"\\n\",Vue.h(_components.p,null,\"「她好可愛，好想和她成為朋友。」\",Vue.h(_components.br),\"\\n\",\"這是我在線下見到她時，第一個冒出來的想法。\"),\"\\n\",Vue.h(_components.p,null,\"毫不誇張地說，就是在那一刻，我突然沒有那麼想死了。\"),\"\\n\",Vue.h(_components.p,null,\"後來，我們也真的成為了朋友。\"),\"\\n\",Vue.h(_components.p,null,\"從那以後，我發出的每一條推文，都希望她能看到，期待著她的按讚和回覆。\"),\"\\n\",Vue.h(_components.p,null,\"我很少主動幫別人拍照。除了我的家人、我的男朋友，就只有她。\"),\"\\n\",Vue.h(_components.p,null,\"她也一直覺得我拍得很好看。有些照片被她拿去發推，有些則被她拿來當作微信頭像。\"),\"\\n\",Vue.h(_components.p,null,\"可是，我始終無法理解一件事。\"),\"\\n\",Vue.h(_components.p,null,\"她明明已經身陷自己的深淵，卻還是在不停地救助中國國內的 MTF。\"),\"\\n\",Vue.h(_components.p,null,\"她關心別人，關心那些弱勢群體正在經歷什麼，卻似乎從來沒有好好關心過自己。\"),\"\\n\",Vue.h(_components.p,null,\"她曾經來過滑鐵盧，住在我家。離開的時候，她甚至沒有足夠的錢坐車回家。因為她手裡的錢，幾乎全都給了那些遭受家暴的 MTF。\"),\"\\n\",Vue.h(_components.p,null,\"我對此感到很無奈。\"),\"\\n\",Vue.h(_components.p,null,\"但或許，她就是這樣一個人。她實在看不下去別人的痛苦，善良得甚至有些忘記了自己。\"),\"\\n\",Vue.h(_components.p,null,\"最後，我給她贊助了一些錢。\"),\"\\n\",Vue.h(_components.p,null,\"我特意告訴她，我幫助她，並不是因為她也是 MTF，而是因為她是我的閨蜜。\"),\"\\n\",Vue.h(_components.p,null,\"我希望她能夠多關注一下自己。\"),\"\\n\",Vue.h(_components.p,null,\"我希望她也能夠救救自己。\"),\"\\n\",Vue.h(_components.p,null,\"可她還是在不停地關注別人的痛苦，一點一點地把自己丟在了後面。\"),\"\\n\",Vue.h(_components.p,null,\"後來，我在推特上對她的諷刺回覆越來越多，我們之間的爭吵也越來越多。她對我的稱呼，也從最開始的「閨蜜」，變成了後來半開玩笑的「敵蜜」。\"),\"\\n\",Vue.h(_components.p,null,\"現在回頭看，那些爭吵似乎都變得很遙遠了。\"),\"\\n\",Vue.h(_components.p,null,\"我曾經私下對她說過：\",Vue.h(_components.br),\"\\n\",\"「你不會死掉吧？那樣我以後就只能天天對著你的頭像自言自語了。」\"),\"\\n\",Vue.h(_components.p,null,\"她真的離開了。\"),\"\\n\",Vue.h(_components.p,null,\"而我也真的開始對著她的頭像自言自語。\"),\"\\n\",Vue.h(_components.p,null,\"直到今天，我依然沒有辦法徹底接受咴咴已經不在了。\"),\"\\n\",Vue.h(_components.p,null,\"有人告訴我，她生前經常提到我。\"),\"\\n\",Vue.h(_components.p,null,\"現在，換我經常提起她了。\"),\"\\n\",Vue.h(_components.p,null,\"我想過無數種可能。\"),\"\\n\",Vue.h(_components.p,null,\"如果事情發生的時候，我人在多倫多呢？\"),\"\\n\",Vue.h(_components.p,null,\"如果當時我能再多關心她一點呢？\"),\"\\n\",Vue.h(_components.p,null,\"如果我做的不只是給她推薦律師呢？\"),\"\\n\",Vue.h(_components.p,null,\"也許結局會不一樣。\"),\"\\n\",Vue.h(_components.p,null,\"最近，我了解到一個叫作「多元宇宙永生論」（Multiverse Immortality）的理論。\"),\"\\n\",Vue.h(_components.p,null,\"於是我忍不住想，也許在某一個宇宙裡，她真的在醫院裡醒了過來。\"),\"\\n\",Vue.h(_components.p,null,\"然後，一切如常。\"),\"\\n\",Vue.h(_components.p,null,\"她還是那個會一蹦一跳地闖進鏡頭、在新聞主持人身後賣萌比耶的人。\"),\"\\n\",Vue.h(_components.p,null,\"她的紀錄片如期上映，那是她生前最大的夢想。\"),\"\\n\",Vue.h(_components.p,null,\"我們還是會吵架，還是會互相陰陽怪氣，還是會叫對方「敵蜜」。\"),\"\\n\",Vue.h(_components.p,null,\"而那個世界的我，也許會覺得這一切再普通不過。\"),\"\\n\",Vue.h(_components.p,null,\"希望那個世界的我，能夠意識到自己究竟有多幸運。\"),\"\\n\",Vue.h(_components.p,null,\"條目貢獻：\",Vue.h(_components.a,{href:\"https://x.com/ServalCandle\"},\"ServalCandle\")),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"咴咴紀錄片的前導剪輯 \",Vue.h(_components.a,{href:\"https://www.bilibili.com/video/BV1mzzhBeEZ3/\"},\"《「我們消費的『時尚』，是她背負的一生」——跨性別紀錄片〈時尚單品〉前導片》\"),Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",o