"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",br:\"br\",h2:\"h2\",p:\"p\"},props.components),PhotoScroll=_components.PhotoScroll;if(!PhotoScroll)_missingMdxReference(\"PhotoScroll\",true);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"简介\"),\"\\n\",Vue.h(_components.p,null,\"小马咴咴，自媒体创作者、B 站创作者，跨性别女性，一个充满争议的人。\"),\"\\n\",Vue.h(_components.p,null,\"2024 年起，小马咴咴逐渐公开自己跨性别女性的身份，并开始接受激素替代疗法。身份的改变也成为她生命中一个重要的转折点。她开始重新认识自己的身体、性别与人格，也开始思考：当曾经熟悉的自己逐渐远去，一个人究竟要怎样重新学习生活。\"),\"\\n\",Vue.h(_components.p,null,\"她曾以「马哥」「小咴咴」等称呼书写自己的变化，将过去与现在的自己置于同一段叙事当中。她并没有把性别转换描述成一条简单而明亮的道路，而是记录其中的迟疑、怀念、挣扎与重新建立。她知道自己失去了一部分熟悉的东西，却也在努力拥抱那个终于能够被自己承认的「她」。\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo0.webp\",\"${path}/photos/photo1.webp\",\"${path}/photos/photo2.webp\"]}),\"\\n\",Vue.h(_components.p,null,\"搬家到加拿大后，她的创作逐渐从早年的网络梗文化转向更加私人和现实的表达。她关注跨性别者的处境，也关注家庭控制、青少年困境、无障碍设施等社会议题。她常常从身边的「坏消息」出发，追问那些看不见的压力究竟如何一步步将人推向困境。\"),\"\\n\",Vue.h(_components.p,null,\"与此同时，她的现实生活也并不平静。2025 年至 2026 年初，她经历了亲密关系变化、室友矛盾以及其他复杂的人际纠纷。网络与现实彼此交织，使她后期的生活充满了拉扯与疲倦。她并非没有犯过错，也并非始终清醒而坚定，她只是一个在努力寻找自己位置的人。\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 1 月，她参与主导制作跨性别纪录片《「我们消费的『时尚』，是她背负的一生」——跨性别纪录片》\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"，试图讨论跨性别者如何被围观，以及一个具体的人如何在标签之外保有自己的真实与尊严。她原本希望将正片命名为《我们活着才是对恶意最大的反抗》，并解释这是为了鼓励身处困难中的人继续活下去。\"),\"\\n\",Vue.h(_components.p,null,\"生命最后的日子里，她依然与朋友保持联系，也曾试图重新整理自己的人生，感谢曾经帮助过她的人，也试着寻找继续向前的理由。\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 2 月 13 日，小马咴咴在多伦多离世，年仅 21 岁。\"),\"\\n\",Vue.h(_components.p,null,\"她的一生并不能被某一个身份、某一次争议，或者生命最后的那段时间所概括。跨性别之后的她，有过困惑，也有过勇气；有过失去，也有过重新获得；她注视自己的同时，也一直注视着别人。\"),\"\\n\",Vue.h(_components.p,null,\"她曾试图回答「我是谁」，也曾试图告诉身处困境中的人：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我们活着才是对恶意最大的反抗。\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"ServalCandle 的回忆\"),\"\\n\",Vue.h(_components.p,null,\"第一次和咴咴见面，是在 2024 年 3 月。\"),\"\\n\",Vue.h(_components.p,null,\"那时多伦多的雪还没有完全融化。我刚经历了自己人生中最糟糕的事情之一，觉得自己的人生简直像个笑话，也刚刚经历了一次自杀未遂。\"),\"\\n\",Vue.h(_components.p,null,\"那天是在 Eaton Centre。她一蹦一跳地出现，充满活力，甚至乱入了新闻直播的镜头，在主持人身后卖萌、比耶。\"),\"\\n\",Vue.h(_components.p,null,\"「她好可爱，好想和她成为朋友。」\",Vue.h(_components.br),\"\\n\",\"这是我在线下见到她时，第一个冒出来的想法。\"),\"\\n\",Vue.h(_components.p,null,\"毫不夸张地说，就是在那一刻，我突然没有那么想死了。\"),\"\\n\",Vue.h(_components.p,null,\"后来，我们也真的成为了朋友。\"),\"\\n\",Vue.h(_components.p,null,\"从那以后，我发出的每一条推文，都希望她能看到，期待着她的点赞和回复。\"),\"\\n\",Vue.h(_components.p,null,\"我很少主动帮助别人拍照。除了我的家人、我的男朋友，就只有她。\"),\"\\n\",Vue.h(_components.p,null,\"她也一直觉得我拍得很好看。有些照片被她拿去发推，有些则被她拿来当作微信头像。\"),\"\\n\",Vue.h(_components.p,null,\"可是，我始终无法理解一件事。\"),\"\\n\",Vue.h(_components.p,null,\"她明明已经身陷自己的深渊，却还是在不停地救助中国国内的 MTF。\"),\"\\n\",Vue.h(_components.p,null,\"她关心别人，关心那些弱势群体正在经历什么，却似乎从来没有好好关心过自己。\"),\"\\n\",Vue.h(_components.p,null,\"她曾经来过滑铁卢，住在我家。离开的时候，她甚至没有足够的钱坐车回家。因为她手里的钱，几乎全都给了那些遭受家暴的 MTF。\"),\"\\n\",Vue.h(_components.p,null,\"我对此感到无奈。\"),\"\\n\",Vue.h(_components.p,null,\"但或许，她就是这样一个人。她实在看不下去别人的痛苦，善良得甚至有些忘记了自己。\"),\"\\n\",Vue.h(_components.p,null,\"最后，我给她赞助了一些钱。\"),\"\\n\",Vue.h(_components.p,null,\"我特意告诉她，我帮助她，并不是因为她也是 MTF，而是因为她是我的闺蜜。\"),\"\\n\",Vue.h(_components.p,null,\"我希望她能够多关注一下自己。\"),\"\\n\",Vue.h(_components.p,null,\"我希望她也能够救救自己。\"),\"\\n\",Vue.h(_components.p,null,\"可她还是在不停地关注别人的痛苦，一点一点地把自己丢在了后面。\"),\"\\n\",Vue.h(_components.p,null,\"后来，我在推特上对她的讽刺回复越来越多，我们之间的争吵也越来越多。她对我的称呼，也从最开始的「闺蜜」，变成了后来半开玩笑的「敌蜜」。\"),\"\\n\",Vue.h(_components.p,null,\"现在回头看，那些争吵似乎都变得很遥远了。\"),\"\\n\",Vue.h(_components.p,null,\"我曾私下对她说过：\",Vue.h(_components.br),\"\\n\",\"「你不会死掉吧？那样我以后就只能天天对着你的头像自言自语了。」\"),\"\\n\",Vue.h(_components.p,null,\"她真的离开了。\"),\"\\n\",Vue.h(_components.p,null,\"而我也真的开始对着她的头像自言自语。\"),\"\\n\",Vue.h(_components.p,null,\"直到今天，我依然没有办法彻底接受咴咴已经不在了。\"),\"\\n\",Vue.h(_components.p,null,\"有人告诉我，她生前经常提到我。\"),\"\\n\",Vue.h(_components.p,null,\"现在，换我经常提起她了。\"),\"\\n\",Vue.h(_components.p,null,\"我想过无数种可能。\"),\"\\n\",Vue.h(_components.p,null,\"如果事情发生的时候，我人在多伦多呢？\"),\"\\n\",Vue.h(_components.p,null,\"如果当时我能再多关心她一点呢？\"),\"\\n\",Vue.h(_components.p,null,\"如果我做的不只是给她推荐律师呢？\"),\"\\n\",Vue.h(_components.p,null,\"也许结局会不一样。\"),\"\\n\",Vue.h(_components.p,null,\"最近，我了解到一个叫做「多元宇宙永生论」（Multiverse Immortality）的理论。\"),\"\\n\",Vue.h(_components.p,null,\"于是我忍不住想，也许在某一个宇宙里，她真的在医院里醒了过来。\"),\"\\n\",Vue.h(_components.p,null,\"然后，一切如常。\"),\"\\n\",Vue.h(_components.p,null,\"她还是那个会一蹦一跳地闯进镜头、在新闻主持人身后卖萌比耶的人。\"),\"\\n\",Vue.h(_components.p,null,\"她的纪录片会如期上映，那是她生前最大的梦想。\"),\"\\n\",Vue.h(_components.p,null,\"我们还是会吵架，还是会互相阴阳怪气，还是会叫对方「敌蜜」。\"),\"\\n\",Vue.h(_components.p,null,\"而那个世界的我，也许会觉得这一切再普通不过。\"),\"\\n\",Vue.h(_components.p,null,\"希望那个世界的我，能够意识到自己究竟有多幸运。\"),\"\\n\",Vue.h(_components.p,null,\"条目贡献：\",Vue.h(_components.a,{href:\"https://x.com/ServalCandle\"},\"ServalCandle\")),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"咴咴纪录片的先导剪辑 \",Vue.h(_components.a,{href:\"https://www.bilibili.com/video/BV1mzzhBeEZ3/\"},\"《「我们消费的『时尚』，是她背负的一生」——跨性别纪录片〈时尚单品〉先导片》\"),Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",of