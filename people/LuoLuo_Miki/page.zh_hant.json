"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({blockquote:\"blockquote\",h2:\"h2\",p:\"p\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"簡介\"),\"\\n\",Vue.h(_components.p,null,\"洛洛是個溫柔且善良的人。她會因他人的悲傷而感到難過，也會在朋友最需要時連夜開車數百公里去安慰。本該在校園生活的年紀，她卻在為生計奔波。\"),\"\\n\",Vue.h(_components.p,null,\"她體型瘦弱，肩上卻承擔著沉重的責任。她曾救過他人，卻未能救下自己。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「最開心的事是躺在床上，最幸福的時刻是薪水入帳的時候。」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"被工作與生活裹挾許久的你，終於能休息了，不再受累。\"),\"\\n\",Vue.h(_components.h2,null,\"其一 伴侶回憶——Dreemurr\"),\"\\n\",Vue.h(_components.p,null,\"我與洛洛相識不久，但她留下的影響深遠且難以抹去。\"),\"\\n\",Vue.h(_components.p,null,\"我們是在一位共同的朋友自殺未遂時結識的。當時她因過量用藥意識模糊，一直說著胡話。\"),\"\\n\",Vue.h(_components.p,null,\"洛洛是個可愛的孩子，會為他人的悲傷而難過。\"),\"\\n\",Vue.h(_components.p,null,\"她的生活其實一直很無趣，只是一個普通的送貨員，可能平時喜歡吃點麥當勞，晚上去網咖玩玩暗區突圍？\"),\"\\n\",Vue.h(_components.p,null,\"據我所知，洛洛在前幾年自殺過一次，在此之前，她的第一任主人格或許非常的暴戾？但自殺之後的第二主人格，也就是我們熟知的洛洛，就變得非常軟糯可愛了。其間究竟發生了什麼，洛洛沒怎麼和我提到過。\"),\"\\n\",Vue.h(_components.p,null,\"後來，在 7 月 6 日，我們成了伴侶，我們倆戀愛的過程也或許非常老套吧……大抵就是日久生情了。也許起初只是想找個互相陪伴的人？但我們都真正愛上了彼此。那或許，也是悲劇的開端吧。\"),\"\\n\",Vue.h(_components.p,null,\"雖然那些平凡的日常很無趣，但有趣的小故事，我倒能找出一個：\"),\"\\n\",Vue.h(_components.p,null,\"有一回，洛洛早上睡覺，突然蹦出來了一個新的人格，「伊洛」。一個完完全全的男性人格，那一次給我嚇壞了。不過後續睡了一覺洛洛又回來了。\"),\"\\n\",Vue.h(_components.p,null,\"或許這段小故事在旁人聽起來並不有趣吧，但這就是我所熟知的洛洛了。\"),\"\\n\",Vue.h(_components.p,null,\"她依然是那個可愛的洛洛，我也還是我自己，但我們的命運交織在一起。那段時光是我至今經歷過最美好的日子。\"),\"\\n\",Vue.h(_components.p,null,\"然而美好的時光總是短暫的。8 月中旬，她的心理問題日益嚴重。我們原定于國慶見面，但她因為過量用藥，後來基本都在瞞著我。\"),\"\\n\",Vue.h(_components.p,null,\"8 月 23 日我開學時，她自殺了。\"),\"\\n\",Vue.h(_components.p,null,\"一個可愛的騙子，一個值得我愛的人。\"),\"\\n\",Vue.h(_components.p,null,\"她的前半生我並不清楚，因此不再多說。她並不特別想在這個世界上留下什麼，但既然留下了我，我就想讓其他人也記住她。\"),\"\\n\",Vue.h(_components.p,null,\"笨蛋，騙子……無論你在何方，我永遠愛你。\"),\"\\n\",Vue.h(_components.h2,null,\"其二 友人追憶——小眠\"),\"\\n\",Vue.h(_components.p,null,\"致溫柔的你，洛洛。你救了我，我來紀念你，緬懷你。\"),\"\\n\",Vue.h(_components.p,null,\"洛洛是我最好的朋友之一。她是一位跨性別女性，和我是同類。\"),\"\\n\",Vue.h(_components.p,null,\"起初，我們在一個群組中相識。我不知為何對她產生興趣，後來便成了朋友。我們相識不過數月，情誼卻如同老友。\"),\"\\n\",Vue.h(_components.p,null,\"我印象最深的是在我想要自殺的時候，她連夜開車數百公里來找我。當時我感到極大衝擊，不敢相信她真的這麼做，我非常感動，她在我心中的分量一下子重了許多。但那日我仍沒能忍住對來生的渴望。她連夜趕來後，我把我的重要物品塞進她的車裡，當晚還是選擇了離開。\"),\"\\n\",Vue.h(_components.p,null,\"或許因為她的影響，我下手輕了一些，也活到了現在。\"),\"\\n\",Vue.h(_components.p,null,\"她救了我，可惜沒能救下自己。\"),\"\\n\",Vue.h(_components.p,null,\"她很瘦弱，臉上幾乎沒有肉。但就是這樣瘦弱的人，肩上承擔了太重的責任——她的年齡本應在校園中學習，但生前卻一直忙於工作，經常疲憊，空閒時常在睡眠中度過，但還要供養一大家人。承擔著不屬於這個年紀的責任，既堅強又令人心酸。我們曾有一段時間幾乎每天都在交流，時刻保持聯繫。雖然原因不明，但我非常喜歡這個人，這種情感難以控制。\"),\"\\n\",Vue.h(_components.p,null,\"當天下午得知她離世的消息時，我感到震驚。震驚於她沒有告知我，也震驚於我們的約定尚未完成。在生活向好發展時，她離開了，這讓我難以置信。她與 Dreemurr 是伴侶，她們也是我親近的朋友，本是約定一起離開的。最後 Dreemurr 倖存了下來，洛洛卻離開了，Dreemurr 是洛洛留下的最後一位重要的人……\"),\"\\n\",Vue.h(_components.p,null,\"我一定會好好珍惜，愛護這份她留下的珍寶。\"),\"\\n\",Vue.h(_components.p,null,\"洛洛，你說過不想再回來了。那麼，在那個幸福的世界裡，請看著我們吧。願你永遠不必回到這個地獄般的世界，願你能到達一個溫柔、無需再承擔重擔、可以安穩的地方。\"),\"\\n\",Vue.h(_components.p,null,\"條目貢獻：Dreemurr, 小眠\"))}function MDXContent(props){if(props===void 0)props={};var _ref=props.components||{},MDXLayout=_ref.wrapper;return MDXLayout?Vue.h(MDXLayout,_extends({},props),Vue.h(_createMdxContent,_extends({},props))):_createMdxContent(props)}"