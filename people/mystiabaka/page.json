"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({blockquote:\"blockquote\",br:\"br\",em:\"em\",h2:\"h2\",p:\"p\",strong:\"strong\"},props.components),PhotoScroll=_components.PhotoScroll,Sakura=_components.Sakura;if(!PhotoScroll)_missingMdxReference(\"PhotoScroll\",true);if(!Sakura)_missingMdxReference(\"Sakura\",true);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"因缘际会\"),\"\\n\",Vue.h(_components.p,null,\"说起米斯蒂娅……刚认识她的时候，我刚刚接触社群的助人工作，彼时我正在处理家暴相关的案子，而她恰好因着被家暴而向我求助，因缘际会，我们就这样在推上认识了。\"),\"\\n\",Vue.h(_components.p,null,\"尽管她比我小，心智却比我成熟些。加之那会儿她状态看上去还不错，我便总习惯喊她姐姐。\"),\"\\n\",Vue.h(_components.p,null,\"她当然不服气，也爱叫我姐姐：\"),\"\\n\",Vue.h(_components.p,null,\"「我会一直爱着这个世界哒，因为我现在有了一个特别特别厉害的糯米姐姐！」\"),\"\\n\",Vue.h(_components.p,null,\"彼时的我尚未参与正式的社工活动，因而并没有很严肃的原则。于是，在 2024 年的暑假，恰逢她父母出差在外，我便远赴北京同她见了一面。\"),\"\\n\",Vue.h(_components.p,null,\"在往北京的车上，她还同我聊起做饭的事情。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「姐姐平时喜欢吃什么呢？」\"),\"\\n\",Vue.h(_components.p,null,\"「其实，我带了一捆我们这边的面呢，到时候姐姐给你烧面吃~」\"),\"\\n\",Vue.h(_components.p,null,\"「好呀好呀。」\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"夏梦幽燕\"),\"\\n\",Vue.h(_components.p,null,\"列车抵达，我拖着行李从站台匆匆走到出站口，而她已如约在出站口的角落等候。她安静得就像一朵脆弱的小花，轻飘飘的，看起来有些怕生。那样的感觉，很容易就能从人群中寻到她的身影。\"),\"\\n\",Vue.h(_components.p,null,\"与她见面后，我们便相约去附近的萨莉亚吃饭。毕竟，萨莉亚便宜好吃嘛，大家都觉得是聚餐的不二之选呢。\"),\"\\n\",Vue.h(_components.p,null,\"在饭桌上，我和她先聊了聊她的家庭状况，然后问了些她关于未来的打算。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「唔……未来吗……？总之先把高中阶段扛过去吧。至于高考之后，大概会去浙江……？或者珠三角上大学。」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"米斯蒂娅是个对未来抱有希望和幻想的女孩子。她觉得即使现在再灰暗，未来也是美好的。\"),\"\\n\",Vue.h(_components.p,null,\"至少，当时还是这样……\"),\"\\n\",Vue.h(_components.p,null,\"这样的小姑娘，私底下对甜食爱不释手，当然也不奇怪呢。她会买来发酵好的可可豆，然后自己用烤箱做巧克力，不过她做的那些巧克力，往往是专门留给我吃的。她还会做各种各样的家常菜，包括她最爱吃的鳗鱼饭，是个天才小厨娘。\"),\"\\n\",Vue.h(_components.p,null,\"还记得我之前在列车上聊过的，随身带过来的那捆面吗？那是来自我们永康本地的一种面，唤作土索面。滋味上乘，但烧起来非常麻烦。我祖母曾经开过一家饭店，我也顺理成章地从她那儿学到了烧这种面的手艺。\"),\"\\n\",Vue.h(_components.p,null,\"我为她演示了一遍烧面的方法：猪肉分肥瘦切成小块，起锅点火。先把肥肉下锅熬干一些，然后把瘦肉放进去炒熟，一起捞出，再加些酱油和热水。按照老规矩抖面下水，热气漫上来，捞到碗里，最后连肉带油一并浇上——两大碗汤色红润、柔韧劲道的土索面就烧好了。\"),\"\\n\",Vue.h(_components.p,null,\"「姐姐烧的面很好吃哦。」米斯蒂娅对我烧的面赞不绝口。\"),\"\\n\",Vue.h(_components.p,null,\"我笑了笑，溺爱地揉了揉她的头。\"),\"\\n\",Vue.h(_components.p,null,\"但没想到，第二餐的时候，她便能如法炮制。本来是我打算烧面给她吃，最后变成了她烧给我。而且她烧的面，味道和我家祖母的手艺十分相似——换句话说，也就是要手艺娴熟精巧，才能达到的程度。\"),\"\\n\",Vue.h(_components.p,null,\"来到北京的第一天，我们吃了四顿饭，其中三顿都是面，另一顿是萨莉亚。\"),\"\\n\",Vue.h(_components.p,null,\"除了萨莉亚之外，我到北京之后一直没怎么下过馆子。依仗着她的厨艺，便不至于沦落到在北京吃 K 记和麦麦了。\"),\"\\n\",Vue.h(_components.p,null,\"在北京的日子里，她喜欢大早上就把我从被窝里拉起来出去散步。其实我并非是一个喜欢出门的人，但由于是她在身边，我便乐意地随着她出门了。\"),\"\\n\",Vue.h(_components.p,null,\"清晨六点的北京是凉爽的，即便是在七月盛夏，迎面拂过来的清风依旧让人感到舒畅。我们还可以坐在湖边的长椅上一起看日出。日出的景色很美，美得让人感到有些梦幻。我们就这样在湖边小径上走走停停，她同我一起畅聊无线电相关的话题，叙说她对未来的规划。\"),\"\\n\",Vue.h(_components.p,null,\"她说，想去盐田港航拍。\"),\"\\n\",Vue.h(_components.p,null,\"她说，想去杭州待上几年。\"),\"\\n\",Vue.h(_components.p,null,\"她说，……\"),\"\\n\",Vue.h(_components.p,null,\"看得出，她是个内心有明确规划，对未来充满畅想，心智成熟的小姑娘呢。\"),\"\\n\",Vue.h(_components.p,null,\"想起来约莫是到北京第二天的时候，我在她家的阳台上坐着，望着窗外出神：\"),\"\\n\",Vue.h(_components.p,null,\"「外面好像梦，没有真实的感觉呢……」\"),\"\\n\",Vue.h(_components.p,null,\"「姐姐，这不是梦哦，就算是梦，也是美好的梦。因为姐姐就在我身边呀。」\"),\"\\n\",Vue.h(_components.p,null,\"我很开心。\"),\"\\n\",Vue.h(_components.p,null,\"那个时候，我能很明显地感到她喜欢我，后来也是，只是从未明说过。毕竟，伦理上，助人者和被助者，是不能谈恋爱的……\"),\"\\n\",Vue.h(_components.p,null,\"我待了一个星期之后就离开了北京，然后约定好一定要下次见面。\"),\"\\n\",Vue.h(_components.h2,null,\"余杭秋声\"),\"\\n\",Vue.h(_components.p,null,\"2024 年的国庆之前，我因着一些事情提前三天从学校回家，米斯蒂娅听说了，便想办法从学校请假，从北京南下来寻我。但因为一些意外，我的父母有将我再一次送到扭转机构的打算。那之后，我们便改道去了杭州。\"),\"\\n\",Vue.h(_components.p,null,\"那时乘坐的车是金温铁路在 03:28 于永康南站开行的 K1050 次列车，这趟车我很熟悉。只是后来这趟列车悄然消失在铁路运行调整之中，如同生命中那些未经之事，仿若一个未解之谜，我永远不知为何。\"),\"\\n\",Vue.h(_components.p,null,\"到达杭州的时候的那天是国庆，我和她小聚了一阵子，和她在满记吃了甜品，她点了金芒杨枝甘露和芒果班戟。而后我们又吃了一次萨莉亚，开心地聊了许多许多事情。其实长三角的萨莉亚和北京的相比，没什么味道上的区别，和谁一起吃才是最重要的。\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo1.webp\"]}),\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\"（在杭州时给米斯蒂娅买的，巧克力味的星冰乐。）\"),\"\\n\",Vue.h(_components.p,null,\"下午，我与米斯蒂娅到老杭州拍车，一处是永昌坝，另一处则是艮山所。永昌坝是一处老旧的小区，在火车迷的口口相传中，是个拍摄视角极好的地方。艮山所嘛，曾经是艮山门站所在，后来改建为动车运用所，用于动车维护和修理，只可惜未能留下当时在艮山所的照片。\"),\"\\n\",Vue.h(\"div\",{style:\"display: flex; margin: auto; gap: 80px; flex-direction: row; justify-self: center; justify-content: center; justify-items: center; flex-wrap: wrap\"},Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo2.webp\"]}),Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo3.webp\"]})),\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\"（10 月 1 日下午，于永昌坝摄。）\"),\"\\n\",Vue.h(_components.p,null,\"与她短暂地重聚之后，我乘车回永康，第二天又匆匆前去武汉开会。\"),\"\\n\",Vue.h(_components.p,null,\"我仍记着每一次下次见面的约定。\"),\"\\n\",Vue.h(_components.p,null,\"我们总是习惯于相遇，却从未想过离别。\"),\"\\n\",Vue.h(_components.h2,null,\"相伴冬雪\"),\"\\n\",Vue.h(_components.p,null,\"米斯蒂娅那会儿在北京的一所学校读高一。一方面，她是走读生，因而回家的时候总遭到家暴；另一方面，她家里对她的态度极度恶劣，甚至到了拒绝给她交高中学费的地步，即使学校当时介入了也无济于事。直至最后，我和其他志愿者众筹为她凑齐了学费和医保的费用，并给她留了一部分生活费，以备不时之需。\"),\"\\n\",Vue.h(_components.p,null,\"她所在的学校有安装在墙上的座机，我和她会每天打电话聊天。她会和我说，每天遇到了什么有趣的事情，或者自己学不会的内容，缠着我教教她。\"),\"\\n\",Vue.h(_components.p,null,\"那时候的她喜欢写诗：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"斜阳一缕破窗尘，镜里蒙纱认未真。\"),\"\\n\",Vue.h(_components.p,null,\"指上清风才拂过，光阴忽现镜中人。\"),\"\\n\",Vue.h(_components.p,null,\"2024-09-12\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"又想起她无聊时在校内写过的随笔，回到家就拍给我看。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"雪国的冬天很长，长到这里的人习惯把春天的到来想象的比实际更远，把希望说得比实际更轻，他们的骨子里都有一股淡淡的、说不出的倔强和一些悠长的诗意与悲伤。\"),\"\\n\",Vue.h(_components.p,null,\"我虽不在那里，但是也过着漫漫的冬，看着春天，看着以后。\"),\"\\n\",Vue.h(_components.p,null,\"2024-10-12\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"「我打算写小说了。」我说道。\"),\"\\n\",Vue.h(_components.p,null,\"「那姐姐把这段随笔加进姐姐的小说里好嘛？」\"),\"\\n\",Vue.h(_components.p,null,\"「为什么呀？」\"),\"\\n\",Vue.h(_components.p,null,\"「因为只要加进去，要是哪天我不在了，我就可以一直陪着姐姐了~」\"),\"\\n\",Vue.h(_components.p,null,\"……古灵精怪的小姑娘，满脑袋鬼点子。\"),\"\\n\",Vue.h(_components.p,null,\"周末闲暇之余，她会陪我打 Apex，然后在晚上语音聊天。其实那个时候我们都还很开心，都还很开心。\"),\"\\n\",Vue.h(_components.p,null,\"一切都还是美好的，生活还是生活，未来还是美好的，像一块很容易就可以抓住的宝石。\"),\"\\n\",Vue.h(_components.p,null,\"……近在眼前，但也仅仅只是近在眼前。\"),\"\\n\",Vue.h(_components.p,null,\"幸福的时光过得很慢，却又在不经意间转瞬即逝。\"),\"\\n\",Vue.h(_components.p,null,\"故事的转折发生在 2024 年 11 月 23 日。\"),\"\\n\",Vue.h(_components.p,null,\"彼时，她的经济仍然处于被父母断绝的状态，一直在靠我与其他几位志愿者的支援吃饭和购置生活必需品。\"),\"\\n\",Vue.h(_components.p,null,\"她的父母终于起了疑心，质问她钱是从哪里来的。随后就是经典的砸东西与吵架，还有家暴环节。\"),\"\\n\",Vue.h(_components.p,null,\"她无助地跑出家门，打电话给我，找我哭诉她的遭遇。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「糯米姐姐……我不想回家了……我好累……」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"后来，我们帮她在北京稍偏一点的地方租了房子，至少这样……让她能暂时远离原生家庭一段时间。\"),\"\\n\",Vue.h(_components.p,null,\"她把所有能搬出来的东西都搬了出来。这段日子，对她来说，美得像梦境一般。\"),\"\\n\",Vue.h(_components.h2,null,\"未待春来\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\"北京市教育委员会关于印发 2024—2025 学年度各级各类学校校历的通知\"),\"\\n\",Vue.h(\"p\",{style:\"text-align: center;\"},\"京教办〔2024〕8 号\"),\"\\n\",Vue.h(_components.p,null,\"各区教委，燕山教委、北京经济技术开发区社会事业局，各普通高等学校、普通中等职业学校、成人学校，各直属单位：\"),\"\\n\",Vue.h(_components.p,null,\"现将 2024—2025 学年度北京市各级各类学校校历印发给你们，请结合本地区、本学校实际情况执行。\"),\"\\n\",Vue.h(_components.p,null,Vue.h(_components.em,null,\"(……)\")),\"\\n\",Vue.h(_components.p,null,\"非义务教育阶段第一学期：\"),\"\\n\",Vue.h(_components.p,null,\"2025 年 1 月 18 日（星期六）结束本学期工作，共 20 周；\"),\"\\n\",Vue.h(_components.p,null,Vue.h(_components.strong,null,\"2025 年 1 月 19 日（星期日）\"),\" 至 2 月 16 日（星期日）放寒假，共 4 周零 1 天。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"期末考试之后便是寒假，她的父母很快就找上了门，要求她寒假回家，即便我们的志愿者前去苦口婆心地规劝，也没有成功。\"),\"\\n\",Vue.h(_components.p,null,\"于是梦碎。她无可奈何地把东西搬回家，继续遭受言语和肢体暴力。她的父母先是强迫她剪头发，她不同意，就又是一顿毒打，打到她同意为止。\"),\"\\n\",Vue.h(_components.p,null,\"最终，她在绝望之中于 1 月 26 日自杀，从正式放假到她离世，掐头去尾，中间仅隔着短短六天。\"),\"\\n\",Vue.h(_components.p,null,\"才六天，六天哪……\"),\"\\n\",Vue.h(_components.p,null,\"我不知道是怎样的遭遇才能让一个原先对未来充满希望的孩子在短短六天之内失去希望，然后选择自杀……\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"姐姐，我好累。不想继续等下去了。\"),\"\\n\",Vue.h(_components.p,null,\"未来，真的会好吗？\"),\"\\n\",Vue.h(_components.p,null,\"糯米姐姐，一定不要出事哦，要一直好好的。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"我翻开她留下的《资本论（修订版）》，翻到扉页。\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo4.webp\"]}),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"这是一本绝对没有人会翻阅的书，但常说「物极必反」，所以你翻开了这本书，看到这段话。不过，真的有人对这种书感兴趣吗？！\"),\"\\n\",Vue.h(_components.p,null,\"（不一样的字迹）怎么没有，我认为挺有趣的。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"书架上，存放着她提前寄给我的，她收藏的其他书籍和杂志。\"),\"\\n\",Vue.h(_components.p,null,\"「柳文扬啊……柳也是很年轻的时候就走了啊……她很喜欢柳文扬写的文章。」我念叨着。\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo5.webp\"]}),\"\\n\",Vue.h(_components.p,null,\"我又从微信收藏夹中翻出她拍摄的照片，一张是 2024 年 4 月，她去重庆开证时随手拍摄的地铁站，另一张则是她去杭州参加无线电聚会时拍下的朝霞。\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo6.webp\",\"${path}/photos/photo7.webp\"]}),\"\\n\",Vue.h(_components.p,null,\"这些……是她在这个世界上留下的为数不多的痕迹。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"听见人们在议论纷纷地说\",Vue.h(_components.br),\"\\n\",\"这种情景只在电视上看到过\",Vue.h(_components.br),\"\\n\",\"而此时此刻这女孩 到底在想些什么呢？\",Vue.h(_components.br),\"\\n\",\"在远方……在远方……\",Vue.h(_components.br),\"\\n\",\"想要哭……想要哭……\",Vue.h(_components.br),\"\\n\",\"原本漫长的一天却已日薄西山\",Vue.h(_components.br),\"\\n\",\"她活过 她活过 她活过 她活过 她活过\",Vue.h(_components.br),\"\\n\",\"她活过 她活过 她也曾活过啊\"),\"\\n\",Vue.h(_components.p,null,\"——生きていたんだよな（歌：あいみょん）\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"我再度想起米斯蒂娅那段随笔中的句子：「我虽不在那里，但是也过着漫漫的冬，看着春天，看着以后。」可她连第二年的春天都未能等来，她在春风吹来的前夕离开了，在新一岁生日到来前离开了，独自留在了那个寒冬之中。如同在《雪国》中，叶子如同一只僵硬的昆虫般飘落，生命戛然而止。\"),\"\\n\",Vue.h(_components.p,null,\"在烈火与银河交织的诡异而唯美的夜空下，驹子抱起叶子发出痛苦的尖叫，而岛村则在极度的震撼中感到「银河仿佛哗啦一声倾泻在自己的心中」。\"),\"\\n\",Vue.h(_components.p,null,\"而我如今翻看她留下来的东西，也有一种相似的恍惚。她写过的诗与随笔、读过的书、拍下过的照片，和她曾留给我的那些话语，依旧安静地躺在那里。可在人群之中，我却再也寻不到那朵轻飘飘的、脆弱的小花了。\"),\"\\n\",Vue.h(_components.p,null,\"她未曾在社群中过多驻足，甚至连一篇像样的推文也没有留下。但我会一直记得她，她真的是一个很好的人呢。\"),\"\\n\",Vue.h(_components.p,null,\"条目贡献：糯米\",Vue.h(_components.br),\"\\n\",\"文字润饰：梨安，AMa-10\"),\"\\n\",Vue.h(Sakura,{count:\"50\"}))}function MDXContent(props){if(props===void 0)props={};var _ref=props.components||{},MDXLayout=_ref.wrapper;return MDXLayout?Vue.h(MDXLayout,_extends({},props),Vue.h(_createMdxContent,_extends({},props))):_createMdxContent(props)}function _missingMdxReference(id,component){throw new Error(\"Expected \"+(component?\"component\":\"object\")+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"