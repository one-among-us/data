"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\",strong:\"strong\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"简介\"),\"\\n\",Vue.h(_components.p,null,\"依菲雅，Epheia（/ɪˈfiːə/），代词 she 或 they。Transgender，也是 Queer。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\"))),\"\\n\",Vue.h(_components.p,null,\"她喜欢二次元百合，也喜欢模拟类游戏和轨道交通，尤其是线路规划。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-2\",id:\"footnote-ref-2\"},\"2\")),\" 高中分班以后，宿舍里的 5 个舍友都非常「顺直」，他们聊的那些话题她一听就烦。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我开始戴着耳机看百合番，不主动和他们说话。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"她会自己搭网站、写代码，把文章、日记和推文存档都放在了自己的站点上。\"),\"\\n\",Vue.h(_components.p,null,\"她还创办了 TransCircle（跨环），一个记录中文 MtF 跨性别社群故事的项目。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-3\",id:\"footnote-ref-3\"},\"3\"))),\"\\n\",Vue.h(_components.h2,null,\"名字的由来\"),\"\\n\",Vue.h(_components.p,null,\"她很喜欢《崩坏：星穹铁道》里的角色遐蝶（Castorice）。和很多喜欢遐蝶的人不同，她喜欢遐蝶，是因为：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我非常希望自己能成为遐蝶那样的人。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"她一向喜欢「神圣感」，遐蝶正是这样的角色；遐蝶和妹妹玻吕茜亚之间的百合故事，也让她很感动。\"),\"\\n\",Vue.h(_components.p,null,\"遐蝶在游戏中有一个代号 EpieiKeia216，她把这个词变形，得到了 Epheia。这个名字是她和 AI 一起想出来的，抽卡试了好几次才满意。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"嗯，就决定是 Epheia 了。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"后来她才知道这个词的读音和自己想的不一样，但她还是按自己的读法，在各处都标注了读音。之后，她顺着读音给自己起了中文名「依菲雅」，也把这个名字给了自己设计的猫娘形象。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-4\",id:\"footnote-ref-4\"},\"4\"))),\"\\n\",Vue.h(_components.h2,null,\"成为自己\"),\"\\n\",Vue.h(_components.p,null,\"在幼儿园时她就幻想过自己是女孩子，想穿可爱的裙子。上小学以后，她努力融入男生的圈子，但一直在心里羡慕着女孩子。\"),\"\\n\",Vue.h(_components.p,null,\"初中时的一个雨天，她从厕所回教室，手放在栏杆上拖着，把栏杆上的水珠变成水流。值日生说她「趴栏杆」，要扣分。她去德育处申诉，主任调了监控，最后说：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「那好，我给你这分撤销了，但以后我都特别关照你，你要是有违反校规的现象就加倍扣分。」\"),\"\\n\",Vue.h(_components.p,null,\"我很恐惧。不安，和绝望。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"那天下午，主任又找她谈话。她说出自己的担心，主任却笑了笑：「啊，你还真信啊」。她曾经对学校的美好期待，就这样完全破灭了。\"),\"\\n\",Vue.h(_components.p,null,\"这件事，加上之后的一些事情，让她开始质疑自己原本相信的一切。她给自己定下了一条原则：「自由即有权做任何不损害他人之事。」\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-5\",id:\"footnote-ref-5\"},\"5\")),\" 后来她刷到了一些 MtF 的帖子，有一种「好像找到了什么」的感觉。她给自己定了「三年时间探索」。\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 3 月左右，她真正开始和妈妈聊这件事。妈妈说，无论她选择什么都支持，这给了她很大的勇气。她更新了推特简介：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"二次元百合厨 | \\uD83C\\uDFF3️‍\\uD83C\\uDF08\\uD83C\\uDFF3️‍⚧️LGBT 友好 | 09 | MtF?MtX？探索中，总之不是顺直男 | 暂未 HRT | 家长党 | Vibe coding | 搭建网站\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"短短几个小时，就有好几位 MtF 关注了她。3 月 20 日，她第一次去医院门诊。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-6\",id:\"footnote-ref-6\"},\"6\"))),\"\\n\",Vue.h(_components.p,null,\"3 月 30 日，开始 HRT 之前，她在日记里写到其他跨性别姐妹：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"她们付出这么多，只是为了成为自己。\"),\"\\n\",Vue.h(_components.p,null,\"她们好勇敢。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"那时她还觉得自己做不到。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-7\",id:\"footnote-ref-7\"},\"7\")),\" 不久之后，她开始了 HRT。\"),\"\\n\",Vue.h(_components.h2,null,\"求助！\"),\"\\n\",Vue.h(_components.p,null,\"同一天的日记里，她还问过：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"而且我这样的人和可爱哪里又一点关系呢？？\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-8\",id:\"footnote-ref-8\"},\"8\"))),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"Epheia，一个可爱而善良的 MtF。\"),\"\\n\",Vue.h(_components.p,null,\"她会尽自己的努力，去帮助那些也许在深夜经历精神危机、也许在炸柜\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-9\",id:\"footnote-ref-9\"},\"9\")),\"后经历家暴、抑或被顺直网暴的姐妹们。她帮人寻找支持资源；遇到有自杀倾向的姐妹，她会尽可能地拖延时间，事情一旦超出自己能力范围，就直接报警。\"),\"\\n\",Vue.h(_components.p,null,\"7 月 19 日，我陪她在南京面基。傍晚六点多，我们正吃着饭，她举起手机，打下两个字：「求助！」有一位姐妹在推特上说自己状态很不好，她在替对方找人。\"),\"\\n\",Vue.h(_components.p,null,\"7 月 23 日，她和朋友一起为另一位姐妹做了自杀干预，还和那位姐妹的家长聊了聊。她发推说，不知道能不能改变对方爸妈的想法，「但说实话她家庭氛围真的好压抑」。又说那位姐妹现在应该还好，「在 vibe coding（？」。\"),\"\\n\",Vue.h(_components.p,null,\"医者无法自医。\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 7 月 27 日，她离开了我们，年仅 17 岁。\"),\"\\n\",Vue.h(_components.p,null,\"我的 GitHub 上，还留着她发给我的协作邀请。已经过期了。\"),\"\\n\",Vue.h(_components.p,null,\"依菲雅，sqrt(-1) STILL ♥️ U\"),\"\\n\",Vue.h(_components.p,null,\"时间走向了远方，Epheia 也是。记得回头看看，有这样的 Epheia 曾 Vibe Coding，曾观看百合，曾存在于此。\"),\"\\n\",Vue.h(_components.p,null,\"谨此，致 Epheia（2009 年 5 月 12 日 ~ 2026 年 7 月 27 日）\"),\"\\n\",Vue.h(_components.p,null,\"Sy Yann，写于 2026 年 10 月 3 日深夜，她离开后的第 68 天。\"),\"\\n\",Vue.h(_components.h2,null,\"身后\"),\"\\n\",Vue.h(_components.p,null,\"她的网站 \",Vue.h(_components.a,{href:\"https://me.epheia.moe/\"},\"me.epheia.moe\"),\" 和推文存档 \",Vue.h(_components.a,{href:\"https://nyaepheia.pages.dev/\"},\"nyaepheia.pages.dev\"),\" 都还在。那里有她写下的文章和日记，还有她喜欢的东西。\"),\"\\n\",Vue.h(_components.p,null,\"条目贡献：Sy Yann\"),\"\\n\",Vue.h(_components.p,null,Vue.h(_components.strong,null,\"参考内容与注释\")),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},Vue.h(_components.a,{href:\"https://web.archive.org/web/20261003125509/https://epheia.pages.dev/\"},\"依菲雅的网站首页（镜像站存档）\"),Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px