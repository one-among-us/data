"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\",strong:\"strong\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"簡介\"),\"\\n\",Vue.h(_components.p,null,\"依菲雅，Epheia（/ɪˈfiːə/），代詞 she 或 they。Transgender，也是 Queer。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\"))),\"\\n\",Vue.h(_components.p,null,\"她喜歡二次元百合，也喜歡模擬類遊戲和軌道交通，尤其是路線規劃。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-2\",id:\"footnote-ref-2\"},\"2\")),\" 高中分班以後，宿舍裡的 5 個室友都非常「順直」，他們聊的那些話題她一聽就煩。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我開始戴著耳機看百合番，不主動和他們說話。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"她會自己架網站、寫程式碼，把文章、日記和推文存檔都放在了自己的網站上。\"),\"\\n\",Vue.h(_components.p,null,\"她還創辦了 TransCircle（跨環），一個記錄中文 MtF 跨性別社群故事的計畫。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-3\",id:\"footnote-ref-3\"},\"3\"))),\"\\n\",Vue.h(_components.h2,null,\"名字的由來\"),\"\\n\",Vue.h(_components.p,null,\"她很喜歡《崩壞：星穹鐵道》裡的角色遐蝶（Castorice）。和很多喜歡遐蝶的人不同，她喜歡遐蝶，是因為：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我非常希望自己能成為遐蝶那樣的人。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"她一向喜歡「神聖感」，遐蝶正是這樣的角色；遐蝶和妹妹玻呂茜亞之間的百合故事，也讓她很感動。\"),\"\\n\",Vue.h(_components.p,null,\"遐蝶在遊戲中有一個代號 EpieiKeia216，她把這個詞變形，得到了 Epheia。這個名字是她和 AI 一起想出來的，抽卡試了好幾次才滿意。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"嗯，就決定是 Epheia 了。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"後來她才知道這個詞的讀音和自己想的不一樣，但她還是按自己的讀法，在各處都標註了讀音。之後，她順著讀音給自己起了中文名「依菲雅」，也把這個名字給了自己設計的貓娘形象。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-4\",id:\"footnote-ref-4\"},\"4\"))),\"\\n\",Vue.h(_components.h2,null,\"成為自己\"),\"\\n\",Vue.h(_components.p,null,\"在幼稚園時她就幻想過自己是女孩子，想穿可愛的裙子。上小學以後，她努力融入男生的圈子，但一直在心裡羨慕著女孩子。\"),\"\\n\",Vue.h(_components.p,null,\"初中時的一個雨天，她從廁所回教室，手放在欄杆上拖著，把欄杆上的水珠變成水流。值日生說她「趴欄杆」，要扣分。她去德育處申訴，主任調了監視器畫面，最後說：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「那好，我給你這分撤銷了，但以後我都特別關照你，你要是有違反校規的現象就加倍扣分。」\"),\"\\n\",Vue.h(_components.p,null,\"我很恐懼。不安，和絕望。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"那天下午，主任又找她談話。她說出自己的擔心，主任卻笑了笑：「啊，你還真信啊」。她曾經對學校的美好期待，就這樣完全破滅了。\"),\"\\n\",Vue.h(_components.p,null,\"這件事，加上之後的一些事情，讓她開始質疑自己原本相信的一切。她給自己定下了一條原則：「自由即有權做任何不損害他人之事。」\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-5\",id:\"footnote-ref-5\"},\"5\")),\" 後來她滑到了一些 MtF 的貼文，有一種「好像找到了什麼」的感覺。她給自己定了「三年時間探索」。\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 3 月左右，她真正開始和媽媽聊這件事。媽媽說，無論她選擇什麼都支持，這給了她很大的勇氣。她更新了推特簡介：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"二次元百合廚 | \\uD83C\\uDFF3️‍\\uD83C\\uDF08\\uD83C\\uDFF3️‍⚧️LGBT 友好 | 09 | MtF?MtX？探索中，總之不是順直男 | 暫未 HRT | 家長黨 | Vibe coding | 搭建網站\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"短短幾個小時，就有好幾位 MtF 追蹤了她。3 月 20 日，她第一次去醫院門診。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-6\",id:\"footnote-ref-6\"},\"6\"))),\"\\n\",Vue.h(_components.p,null,\"3 月 30 日，開始 HRT 之前，她在日記裡寫到其他跨性別姊妹：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"她們付出這麼多，只是為了成為自己。\"),\"\\n\",Vue.h(_components.p,null,\"她們好勇敢。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"那時她還覺得自己做不到。\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-7\",id:\"footnote-ref-7\"},\"7\")),\" 不久之後，她開始了 HRT。\"),\"\\n\",Vue.h(_components.h2,null,\"求助！\"),\"\\n\",Vue.h(_components.p,null,\"同一天的日記裡，她還問過：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"而且我這樣的人和可愛哪裡又一點關係呢？？\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-8\",id:\"footnote-ref-8\"},\"8\"))),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"Epheia，一個可愛而善良的 MtF。\"),\"\\n\",Vue.h(_components.p,null,\"她會盡自己的努力，去幫助那些也許在深夜經歷精神危機、也許在炸櫃\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-9\",id:\"footnote-ref-9\"},\"9\")),\"後經歷家暴、抑或被順直網暴的姊妹們。她幫人尋找支持資源；遇到有自殺傾向的姊妹，她會盡可能地拖延時間，事情一旦超出自己能力範圍，就直接報警。\"),\"\\n\",Vue.h(_components.p,null,\"7 月 19 日，我陪她在南京見網友。傍晚六點多，我們正吃著飯，她舉起手機，打下兩個字：「求助！」有一位姊妹在推特上說自己狀態很不好，她在替對方找人。\"),\"\\n\",Vue.h(_components.p,null,\"7 月 23 日，她和朋友一起為另一位姊妹做了自殺介入，還和那位姊妹的家長聊了聊。她發推說，不知道能不能改變對方爸媽的想法，「但說實話她家庭氛圍真的好壓抑」。又說那位姊妹現在應該還好，「在 vibe coding（？」。\"),\"\\n\",Vue.h(_components.p,null,\"醫者無法自醫。\"),\"\\n\",Vue.h(_components.p,null,\"2026 年 7 月 27 日，她離開了我們，年僅 17 歲。\"),\"\\n\",Vue.h(_components.p,null,\"我的 GitHub 上，還留著她發給我的協作邀請。已經過期了。\"),\"\\n\",Vue.h(_components.p,null,\"依菲雅，sqrt(-1) STILL ♥️ U\"),\"\\n\",Vue.h(_components.p,null,\"時間走向了遠方，Epheia 也是。記得回頭看看，有這樣的 Epheia 曾 Vibe Coding，曾觀看百合，曾存在於此。\"),\"\\n\",Vue.h(_components.p,null,\"謹此，致 Epheia（2009 年 5 月 12 日 ~ 2026 年 7 月 27 日）\"),\"\\n\",Vue.h(_components.p,null,\"Sy Yann，寫於 2026 年 10 月 3 日深夜，她離開後的第 68 天。\"),\"\\n\",Vue.h(_components.h2,null,\"身後\"),\"\\n\",Vue.h(_components.p,null,\"她的網站 \",Vue.h(_components.a,{href:\"https://me.epheia.moe/\"},\"me.epheia.moe\"),\" 和推文存檔 \",Vue.h(_components.a,{href:\"https://nyaepheia.pages.dev/\"},\"nyaepheia.pages.dev\"),\" 都還在。那裡有她寫下的文章和日記，還有她喜歡的東西。\"),\"\\n\",Vue.h(_components.p,null,\"條目貢獻：Sy Yann\"),\"\\n\",Vue.h(_components.p,null,Vue.h(_components.strong,null,\"參考內容與注釋\")),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},Vue.h(_components.a,{href:\"https://web.archive.org/web/20261003125509/https://epheia.pages.dev/\"},\"依菲雅的網站首頁（鏡像站存檔）\"),Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: