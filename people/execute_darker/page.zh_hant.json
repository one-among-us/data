"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\",strong:\"strong\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"這裡記錄著一些經歷與回憶，卻也有一個可能缺失了再也補不全的故事。\"),\"\\n\",Vue.h(_components.p,null,\"我們是生息在不健全世界上的不健全的人，不可能用尺子測量長度，或者用分度器測量角度，如同銀行存款般那樣毫釐不爽地生活，對吧？\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\"))),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"一段經歷\"),\"\\n\",Vue.h(_components.p,null,\"Darker 是一個有些任性執著，卻也討人喜歡的女孩子。在音樂遊戲方面頗有造詣。她喜歡 Phigros，舞萌也打得不錯。\"),\"\\n\",Vue.h(_components.p,null,\"她在酷安論壇十分活躍，會折騰第三方內核，開發 Magisk 模組，也因此與\",Vue.h(_components.a,{href:\"../profile/qcm45\"},\"夢夢\"),\"，還有白下\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-2\",id:\"footnote-ref-2\"},\"2\")),\"相識。\"),\"\\n\",Vue.h(_components.p,null,\"至於她的頭像嘛……來自《心跳文學部》中的莫妮卡，或許也是因為害怕如莫妮卡那般的\",Vue.h(_components.strong,null,\"孤獨\"),\"呢，2023 年的夏天，她從廣西千里迢迢來到蘇州找夢夢。\"),\"\\n\",Vue.h(_components.p,null,\"十月，她北上來到了白姐姐所在的哈爾濱，這是一個被冰雪覆蓋的城市。她在那邊待了很長一段時間，度過了一段愉快的時光，也和夢夢一起出去剪了滿意的髮型。\"),\"\\n\",Vue.h(_components.p,null,\"後來她養了一隻貓，叫作衝突，後來改名為小克，又名 Clash。然後重演了一張經典的圖片：Clash 正在代理你的網路流量！\"),\"\\n\",Vue.h(_components.p,null,\"不幸的是，四月清明，她回到廣西後突然\",Vue.h(_components.strong,null,\"失蹤\"),\"，白姐姐和夢夢後來知曉了她被送進扭轉學校的消息。\"),\"\\n\",Vue.h(_components.p,null,\"她們開始想辦法把人救出來。並與橙昔一同 加上 Darker 母親的微信，儘管聊天聊得還算過得去，但沒有實際效果。\"),\"\\n\",Vue.h(_components.p,null,\"八月末，夢夢去世。橙昔以此為理由讓她的父母把她從扭轉學校接出來。她的父母同意了，但 Darker 被從普通高中被轉到了職高\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-3\",id:\"footnote-ref-3\"},\"3\")),\"，父母要求她參加完高考，並斷絕她與跨性別社群的任何聯繫。\"),\"\\n\",Vue.h(_components.p,null,\"她很沮喪，覺得是自己的暫離造成了夢夢的離去。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"在沒有人注意的情況下，我失去了一些東西。\"),\"\\n\",Vue.h(_components.p,null,\"在我意識到之前，你已經不在了。只留下回憶。\"),\"\\n\",Vue.h(_components.p,null,\"在忙碌的時候，就像失去言語的木偶一樣。就像滿街都是的流浪貓一樣。聽到的都是無法辨認的東西。\"),\"\\n\",Vue.h(_components.p,null,\"如果我還能見到你就好了，我只想說一件事。\"),\"\\n\",Vue.h(_components.p,null,\"謝謝……謝謝……\"),\"\\n\",Vue.h(_components.p,null,\"（2024 年 9 月 20 日）\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"她無時無刻不想念著夢夢。新學期在新的班級上，她看到了一位同學，無論是身形還是髮型都讓她恍惚，讓她回想起曾在自己身邊的那個夢夢。\"),\"\\n\",Vue.h(_components.p,null,\"冬月，因其時 Darker 已然成年，她毅然決定\",Vue.h(_components.strong,null,\"逃離\"),\"廣西，她從柳州出發，坐火車一路北上，重新來到了哈爾濱這座被冰雪覆蓋的城市，只是這座城中再也沒有夢夢的身影了。\"),\"\\n\",Vue.h(_components.p,null,\"她繼續借住在白姐姐家，只是往日的歡聲笑語也漸不再。\"),\"\\n\",Vue.h(_components.p,null,\"歲末，父母要求她回家處理高考報名的事情，也就是在那時發生了不幸。\"),\"\\n\",Vue.h(_components.p,null,\"「抱歉，生活的壓力太大，我堅持不下去了……」在一聲晚安之後，她便再也沒了消息。\"),\"\\n\",Vue.h(_components.p,null,\"橙昔擔心她的安危，再一次聯繫了她在廣西的父母，卻獲知了她已不幸離開的噩耗。\"),\"\\n\",Vue.h(_components.h2,null,\"一段回憶\"),\"\\n\",Vue.h(_components.p,null,\"說到底，Darker 一開始其實也是我的粉絲。\"),\"\\n\",Vue.h(_components.p,null,\"那時，我恰好在酷安論壇寫關於玩機的實用教程，因為我的某篇文章獲得了很大的流量，得到了官方的推送，我也趁此建立了自己的粉絲群。Darker 便通過公開渠道加了進來。\"),\"\\n\",Vue.h(_components.p,null,\"可有一次，她突然在群裡提到難過的事情，說想不開。我當然不能坐視不管，於是勸了勸她，之後也因此交了個朋友，至於關係怎麼好起來的……我有些忘卻了。\"),\"\\n\",Vue.h(_components.p,null,\"直到 2023 年 7 月份的時候，我實在是受不了家裡的管制了，於是就決定從東北南下，到蘇州找夢夢去。Darker 知道了，執意要跟過來，於是我倆那會兒就都到了蘇州。\"),\"\\n\",Vue.h(_components.p,null,\"我沒辦法孤立她……但作為單純的朋友，我也沒辦法照顧她……\"),\"\\n\",Vue.h(_components.h2,null,\"尾聲\"),\"\\n\",Vue.h(_components.p,null,\"Darker 去世後不久，白姐姐也嘗試自殺，在一切即將走向終點的時候，她還是選擇了撥打了 120。\"),\"\\n\",Vue.h(_components.p,null,\"救護車來得很及時，她因而僥倖獲救。只是醒來後 Darker 和夢夢都已然不在世上。\"),\"\\n\",Vue.h(_components.p,null,\"如今舊事已然飄散，但那些過往都還真切。\"),\"\\n\",Vue.h(_components.p,null,\"「她們兩個呀……是長不大的孩子。並且現在她們已經永遠長不大了。」\"),\"\\n\",Vue.h(_components.p,null,\"「你會想她們嗎？」\"),\"\\n\",Vue.h(_components.p,null,\"「有些懷念……那時，那段放蕩不羈的經歷。」\"),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"語出《挪威的森林》村上春樹作，林少華譯；第十章【ISBN 9787532776771 P344】\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"translate(0,2)\"},Vue.h(\"circle\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient2);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path1\",cx:\"10.667834\",cy:\"6\",r:\"4.5818877\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:#ff8373;stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",d:\"M 9.9178343,10.577036 H 1.7971455\",id:\"path2\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient4);stroke-width:1.5;stroke-linecap:square;paint