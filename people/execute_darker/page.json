"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\",strong:\"strong\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"这里记录着一些经历与回忆，却也有一个可能缺失了再也补不全的故事。\"),\"\\n\",Vue.h(_components.p,null,\"我们是生息在不健全世界上的不健全的人，不可能用尺子测量长度，或者用分度器测量角度，如同银行存款般那样毫厘不爽地生活，对吧？\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\"))),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"一段经历\"),\"\\n\",Vue.h(_components.p,null,\"Darker 是一个有些任性执着，却也讨人喜欢的女孩子。在音乐游戏方面颇有造诣。她喜欢 Phigros，舞萌也打得不错。\"),\"\\n\",Vue.h(_components.p,null,\"她在酷安论坛十分活跃，会折腾第三方内核，开发 Magisk 模块，也因此与\",Vue.h(_components.a,{href:\"../profile/qcm45\"},\"梦梦\"),\"，还有白下\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-2\",id:\"footnote-ref-2\"},\"2\")),\"相识。\"),\"\\n\",Vue.h(_components.p,null,\"至于她的头像嘛……来自《心跳文学部》中的莫妮卡，或许也是因为害怕如莫妮卡那般的\",Vue.h(_components.strong,null,\"孤独\"),\"呢，2023 年的夏天，她从广西千里迢迢来到苏州找梦梦。\"),\"\\n\",Vue.h(_components.p,null,\"十月，她北上来到了白姐姐所在的哈尔滨，这是一个被冰雪覆盖的城市。她在那边待了很长一段时间，度过了一段愉快的时光，也和梦梦一起出去剪了满意的发型。\"),\"\\n\",Vue.h(_components.p,null,\"后来她养了一只猫，叫作冲突，后来改名为小克，又名 Clash。然后重演了一张经典的图片：Clash 正在代理你的网络流量！\"),\"\\n\",Vue.h(_components.p,null,\"不幸的是，四月清明，她回到广西后突然\",Vue.h(_components.strong,null,\"失踪\"),\"，白姐姐和梦梦后来知晓了她被送进扭转学校的消息。\"),\"\\n\",Vue.h(_components.p,null,\"她们开始想办法把人救出来。并与橙昔一同 加上 Darker 母亲的微信，尽管聊天聊得还算过得去，但没有实际效果。\"),\"\\n\",Vue.h(_components.p,null,\"八月末，梦梦去世。橙昔以此为理由让她的父母把她从扭转学校接出来。她的父母同意了，但 Darker 被从普通高中被转到了职高，父母要求她参加完高考，并断绝她与跨性别社群的任何联系。\"),\"\\n\",Vue.h(_components.p,null,\"她很沮丧，觉得是自己的暂离造成了梦梦的离去。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"在没有人注意的情况下，我失去了一些东西。\"),\"\\n\",Vue.h(_components.p,null,\"在我意识到之前，你已经不在了。只留下回忆。\"),\"\\n\",Vue.h(_components.p,null,\"在忙碌的时候，就像失去言语的木偶一样。就像满街都是的流浪猫一样。听到的都是无法辨认的东西。\"),\"\\n\",Vue.h(_components.p,null,\"如果我还能见到你就好了，我只想说一件事。\"),\"\\n\",Vue.h(_components.p,null,\"谢谢……谢谢……\"),\"\\n\",Vue.h(_components.p,null,\"（2024 年 9 月 20 日）\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"她无时无刻不想念着梦梦。新学期在新的班级上，她看到了一位同学，无论是身形还是发型都让她恍惚，让她回想起曾在自己身边的那个梦梦。\"),\"\\n\",Vue.h(_components.p,null,\"冬月，因其时 Darker 已然成年，她毅然决定\",Vue.h(_components.strong,null,\"逃离\"),\"广西，她从柳州出发，坐火车一路北上，重新来到了哈尔滨这座被冰雪覆盖的城市，只是这座城中再也没有梦梦的身影了。\"),\"\\n\",Vue.h(_components.p,null,\"她继续借住在白姐姐家，只是往日的欢声笑语也渐不再。\"),\"\\n\",Vue.h(_components.p,null,\"岁末，父母要求她回家处理高考报名的事情，也就是在那时发生了不幸。\"),\"\\n\",Vue.h(_components.p,null,\"「抱歉，生活的压力太大，我坚持不下去了……」在一声晚安之后，她便再也没了消息。\"),\"\\n\",Vue.h(_components.p,null,\"橙昔担心她的安危，再一次联系了她在广西的父母，却获知了她已不幸离开的噩耗。\"),\"\\n\",Vue.h(_components.h2,null,\"一段回忆\"),\"\\n\",Vue.h(_components.p,null,\"说到底，Darker 一开始其实也是我的粉丝。\"),\"\\n\",Vue.h(_components.p,null,\"那时，我恰好在酷安论坛写关于玩机的实用教程，因为我的某篇文章获得了很大的流量，得到了官方的推送，我也趁此建立了自己的粉丝群。Darker 便通过公开渠道加了进来。\"),\"\\n\",Vue.h(_components.p,null,\"可有一次，她突然在群里提到难过的事情，说想不开。我当然不能坐视不管，于是劝了劝她，之后也因此交了个朋友，至于关系怎么好起来的……我有些忘却了。\"),\"\\n\",Vue.h(_components.p,null,\"直到 2023 年 7 月份的时候，我实在是受不了家里的管制了，于是就决定从东北南下，到苏州找梦梦去。Darker 知道了，执意要跟过来，于是我俩那会儿就都到了苏州。\"),\"\\n\",Vue.h(_components.p,null,\"我没办法孤立她……但作为单纯的朋友，我也没办法照顾她……\"),\"\\n\",Vue.h(_components.h2,null,\"尾声\"),\"\\n\",Vue.h(_components.p,null,\"Darker 去世后不久，白姐姐也尝试自杀，在一切即将走向终点的时候，她还是选择了拨打了 120。\"),\"\\n\",Vue.h(_components.p,null,\"救护车来得很及时，她因而侥幸获救。只是醒来后 Darker 和梦梦都已然不在世上。\"),\"\\n\",Vue.h(_components.p,null,\"如今旧事已然飘散，但那些过往都还真切。\"),\"\\n\",Vue.h(_components.p,null,\"「她们两个呀……是长不大的孩子。并且现在她们已经永远长不大了。」\"),\"\\n\",Vue.h(_components.p,null,\"「你会想她们吗？」\"),\"\\n\",Vue.h(_components.p,null,\"「有些怀念……那时，那段放荡不羁的经历。」\"),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"语出《挪威的森林》村上春树作，林少华译；第十章【ISBN 9787532776771 P344】\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"translate(0,2)\"},Vue.h(\"circle\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient2);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path1\",cx:\"10.667834\",cy:\"6\",r:\"4.5818877\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:#ff8373;stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",d:\"M 9.9178343,10.577036 H 1.7971455\",id:\"path2\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient4);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path3\",d:\"M 8.0000001,11.231817 4.7681825,8.0000001 7