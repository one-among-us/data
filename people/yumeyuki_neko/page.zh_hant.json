"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"简介\"),\"\\n\",Vue.h(_components.p,null,\"夢雪貓貓，一個來自廣東的跨性別女孩。她心靈手巧，活潑開朗，自由自在，深受大家喜歡。\"),\"\\n\",Vue.h(_components.p,null,\"夢雪的女裝初體驗是在 2022 年伊始。\",Vue.h(_components.a,{href:\"https://www.bilibili.com/video/BV1zZ4y1S7C3\"},\"鏡頭\"),\"前的她滿懷欣喜與不安，小心翼翼地穿上 JK 制服，在打扮結束的那一刻，她看起來很是開心。也是從那時起，她開始了每天下午三點半女裝直播打遊戲的慣例，也逐漸累積了越來越多的粉絲。\"),\"\\n\",Vue.h(_components.p,null,\"她也曾展示過自己的 RLE 歷程。耗時將近三年時間，從減肥，到穿搭，再到接髮……夢雪一點一點地摸索，逐漸接近自己喜歡的模樣。\"),\"\\n\",Vue.h(_components.p,null,\"夢雪熱愛著生活，曾與好閨蜜櫻雪小狐狸一起出門買菜，緊接著又給她買了小裙子，後來又自己偷偷穿到身上……好幾個影片都記錄著她倆的日常，那些日常記錄平淡而瑣碎，卻也正是閨蜜情最真實的一面呢。\"),\"\\n\",Vue.h(_components.p,null,\"她也是個多才多藝的女孩子，作為半個「虛擬主播」，她的 Live 2D 模型從原畫，到拆分，再到建模，均由自己一人獨立完成。她還會出 cos，因為喜歡《原神》中的吟遊詩人溫迪，所以出了溫迪的 cos。\"),\"\\n\",Vue.h(_components.p,null,\"她還穿著這身 cos 抽取了溫迪的卡池，不過嘛……\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我 cos 溫迪就是為了今天能夠出溫迪！\"),\"\\n\",Vue.h(_components.p,null,\"怎麼歪了！提納里\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"，快解釋一下提納里！狐狸快給我解釋一下——狐狸！怎麼回事！\"),\"\\n\",Vue.h(_components.p,null,\"都怪狐狸！因為我旁邊就坐著一隻狐狸！嗚嗚……大保底了……\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"啊哈哈……不要在意，好像出了一點小意外……\"),\"\\n\",Vue.h(_components.p,null,\"關於稱呼……？夢雪其實一直都很清楚「木桶飯」的稱呼呢，不過在大多數影片中，她都自稱為「男娘」或「可愛的男孩子」，或許是為了避免限流，讓更多的人看到呢……\"),\"\\n\",Vue.h(_components.p,null,\"難過的是，在 2023 年的冬天，母親與她關係不和，威脅同她斷絕母女關係，最終，她選擇了獨自離開……\"),\"\\n\",Vue.h(_components.p,null,\"夢雪貓貓離世後，仍然有很多關心著她的朋友與粉絲在評論區留言，一直惦記著她。\"),\"\\n\",Vue.h(_components.p,null,\"她的朋友火火醬開設了一個影片系列，「帶夢雪貓貓看世界」。\"),\"\\n\",Vue.h(_components.p,null,\"在夢雪離開後，世界上又發生了哪些變化呢？又上映了什麼新的電影，有了什麼新的好玩的遊戲……？\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"貓貓去了喵星，我們就會變成她的眼睛看看這個世界。\"),\"\\n\",Vue.h(_components.p,null,\"一定會帶著貓貓好好看看這個世界，她一定能看見的。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"這個世界上，有她來不及經歷的每一天，她所未能踏足的風景，還有她不曾知曉的新角色……我們好想把這些都講給她聽。\"),\"\\n\",Vue.h(_components.p,null,\"夢雪貓貓，我們會一直等你回來哦……\"),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"提納里：《原神》中的角色，原型是\\uD859\\uDDD2狐。\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"translate(0,2)\"},Vue.h(\"circle\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient2);stroke-width:1