"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"简介\"),\"\\n\",Vue.h(_components.p,null,\"梦雪猫猫，一位来自广东的跨性别女孩。她心灵手巧，活泼开朗，自由自在，深受大家喜欢。\"),\"\\n\",Vue.h(_components.p,null,\"梦雪的女装初体验是在 2022 年伊始。\",Vue.h(_components.a,{href:\"https://www.bilibili.com/video/BV1zZ4y1S7C3\"},\"镜头\"),\"前的她满怀欣喜与不安，小心翼翼地穿上 JK 制服，在打扮结束的那一刻，她看起来很是开心。也是从那时起，她开始了每天下午三点半女装直播打游戏的惯例，也逐渐积累了越来越多的粉丝。\"),\"\\n\",Vue.h(_components.p,null,\"她也曾展示过自己的 RLE 历程。耗时将近三年时间，从减肥，到穿搭，再到接发……梦雪一点一点地摸索，逐渐接近自己喜欢的模样。\"),\"\\n\",Vue.h(_components.p,null,\"梦雪热爱着生活，曾与好闺蜜樱雪小狐狸一起出门买菜，紧接着又给她买了小裙子，后来又自己偷偷穿到身上……好几个视频都记录着她俩的日常，那些日常记录平淡而琐碎，却也正是闺蜜情最真实的一面呢。\"),\"\\n\",Vue.h(_components.p,null,\"她也是个多才多艺的女孩子，作为半个「虚拟主播」，她的 Live 2D 模型从原画，到拆分，再到建模，均由自己一人独立完成。她还会出 cos，因为喜欢《原神》中的吟游诗人温迪，所以出了温迪的 cos。\"),\"\\n\",Vue.h(_components.p,null,\"她还穿着这身 cos 抽取了温迪的卡池，不过嘛……\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"我 cos 温迪就是为了今天能够出温迪！\"),\"\\n\",Vue.h(_components.p,null,\"怎么歪了！提纳里\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"，快解释一下提纳里！狐狸快给我解释一下——狐狸！怎么回事！\"),\"\\n\",Vue.h(_components.p,null,\"都怪狐狸！因为我旁边就坐着一只狐狸！呜呜……大保底了……\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"啊哈哈……不要在意，好像出了一点小意外……\"),\"\\n\",Vue.h(_components.p,null,\"关于称呼……？梦雪其实一直都很清楚「木桶饭」的称呼呢，不过在大多数视频中，她都自称为「男娘」或「可爱的男孩子」，或许是为了避免限流，让更多的人看到呢……\"),\"\\n\",Vue.h(_components.p,null,\"难过的是，在 2023 年的冬天，母亲与她关系不和，威胁同她断绝母女关系，最终，她选择了独自离开……\"),\"\\n\",Vue.h(_components.p,null,\"梦雪猫猫离世后，仍然有很多关心着她的朋友与粉丝在评论区留言，一直惦记着她。\"),\"\\n\",Vue.h(_components.p,null,\"她的朋友火火酱开设了一个视频系列，「带梦雪猫猫看世界」。\"),\"\\n\",Vue.h(_components.p,null,\"在梦雪离开后，世界上又发生了哪些变化呢？又上映了什么新的电影，有了什么新的好玩的游戏……？\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"猫猫去了喵星，我们就会变成她的眼睛看看这个世界。\"),\"\\n\",Vue.h(_components.p,null,\"一定会带着猫猫好好看看这个世界，她一定能看见的。\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"这个世界上，有她来不及经历的每一天，她所未能踏足的风景，还有她不曾知晓的新角色……我们好想把这些都讲给她听。\"),\"\\n\",Vue.h(_components.p,null,\"梦雪猫猫，我们会一直等你回来哦……\"),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"提纳里：《原神》中的角色，原型是\\uD859\\uDDD2狐。\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"translate(0,2)\"},Vue.h(\"circle\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient2);stroke-width:1