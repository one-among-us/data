"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",h2:\"h2\",p:\"p\"},props.components);return Vue.h(Vue.Fragment,null,Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,Vue.h(\"svg\",{style:\"display: inline-block; overflow: visible !important; vertical-align: sub; fill: rgb(26, 127, 55); margin-right: 10px;\",viewBox:\"0 0 16 16\",version:\"1.1\",width:\"16\",height:\"16\",\"aria-hidden\":\"true\"},Vue.h(\"path\",{d:\"M8 1.5c-2.363 0-4 1.69-4 3.75 0 .984.424 1.625.984 2.304l.214.253c.223.264.47.556.673.848.284.411.537.896.621 1.49a.75.75 0 0 1-1.484.211c-.04-.282-.163-.547-.37-.847a8.456 8.456 0 0 0-.542-.68c-.084-.1-.173-.205-.268-.32C3.201 7.75 2.5 6.766 2.5 5.25 2.5 2.31 4.863 0 8 0s5.5 2.31 5.5 5.25c0 1.516-.701 2.5-1.328 3.259-.095.115-.184.22-.268.319-.207.245-.383.453-.541.681-.208.3-.33.565-.37.847a.751.751 0 0 1-1.485-.212c.084-.593.337-1.078.621-1.489.203-.292.45-.584.673-.848.075-.088.147-.173.213-.253.561-.679.985-1.32.985-2.304 0-2.06-1.637-3.75-4-3.75ZM5.75 12h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5ZM6 15.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Z\"})),\" 閱讀提示：本文因敘事完整性與連貫性的需要，破例保留了部分涉及藥物濫用與敏感用藥情節的具體藥物名稱。請讀者切莫效仿。若您在閱讀中感到不適，或出現其他可能導致危險的精神體驗，請立即停止閱讀並尋求專業醫生或社群的幫助。\"),\"\\n\"),\"\\n\",Vue.h(_components.h2,null,\"妹妹\"),\"\\n\",Vue.h(_components.p,null,\"我同 Kata 是在卡牌姐的群裡認識的。她當時是卡牌姐的幾位妹妹之一，因著後來我也當了卡牌姐的妹妹，她年紀小些，也就順理成章地當了我的妹妹。\"),\"\\n\",Vue.h(_components.p,null,\"可我在群裡聊天時發現，她的狀態並不太好，就想著要不要加上她，試著和她聊聊天，會不會好一點？雖然因著家庭和學校複雜的原因，我的狀態也好不到哪裡去——但至少，我想著，至少，能互相幫助一下吧。\"),\"\\n\",Vue.h(_components.p,null,\"與她加上好友以後，我這才弄明白她的狀況已糟糕到了何等地步：原生家庭不僅對她瘋狂地加以控制，斷絕了她的生活費，甚則將她掃地出門，連家都不讓回。\"),\"\\n\",Vue.h(_components.p,null,\"可憐的 Kata 妹妹差點流落街頭。她還那麼小，她又能做些什麼所謂合法體面的工作呢——最後只得出去接一些援交的活以維持生計。\"),\"\\n\",Vue.h(_components.h2,null,\"初遇\"),\"\\n\",Vue.h(_components.p,null,\"有一回，她接了一份來自上海的單。我便同她說要到浦東機場（PVG）接她，畢竟是聊過天的朋友嘛，不說接風洗塵，她千里迢迢地從北京趕過來，我又怎能不盡東道主之責呢？於是在到達大廳候著，從人群中墊著腳盼望看到那個熟悉而陌生的身影。\"),\"\\n\",Vue.h(_components.p,null,\"接到 Kata 以後，我和她聊了許多事情。那時，我的狀況比現在糟糕多了，家長不僅沒同意給我買 HRT 的藥物，還經常對我加以謾罵。我無可奈何，也只能試著去「接單」。她便給了我好些接單的建議，告訴我哪些單該接，哪些單不該接，自己應該注意些什麼，要怎麼保護自己……\"),\"\\n\",Vue.h(_components.p,null,\"嘛，儘管她年齡比我小些……卻不得不承認，她在這方面確是前輩呢。\"),\"\\n\",Vue.h(_components.p,null,\"Kata 到上海還要來找秧苗的呢，我們從航站樓裡出來，叫了輛車，便一起過去找秧苗姐姐了。\"),\"\\n\",Vue.h(_components.p,null,\"這便是我同她的第一次見面，儘管倉促無比，如今想來卻是五味雜陳。\"),\"\\n\",Vue.h(_components.h2,null,\"試縫\"),\"\\n\",Vue.h(_components.p,null,\"有一回，Kata 說她要自殺。那一陣子我們又聯繫不上她，只能眼巴巴地盯著她的動態乾著急。後來夥同洛亦羽她們討論了一下之後，還是決定報警處理這件事。\"),\"\\n\",Vue.h(_components.p,null,\"那是一個陽光尚好的下午，我還在學校裡上課，但還是擠出時間，把要緊的報警電話給撥出去了。好在北京的警察找到她的時候，發現她並沒有自殺，只是心情太差，在一個人喝悶酒。但這警察不知是內心極壞，還是工作過於死腦筋，人本來安全了，卻還要把她喊走，要她去派出所裡做什麼筆錄。也正因為此事，她父親知道後，便大發雷霆，一直叫囂著要把她送進精神病院。妹妹她呀……她就很害怕，我也很害怕。\"),\"\\n\",Vue.h(_components.p,null,\"「你們能不能別把她送進精神病院……她說要是被關進裡面，就要去尋死的……」我試著和她家人溝通。隨後又安慰她：「妹妹，你來上海吧，至少還能住我這裡……不會被送進去，不會流離失所。」\"),\"\\n\",Vue.h(_components.p,null,\"當時我用來繳學費的銀行卡裡剛存了學費的錢。除去用於學費的那部分，還有些餘錢，我便緊急給她購了一張從北京到上海的機票。\"),\"\\n\",Vue.h(_components.p,null,\"她是週五到上海的——恰好在我放學之後。我如約到機場接了她，把她安置在了家中。\"),\"\\n\",Vue.h(_components.p,null,\"週六晚上，家母帶她出去吃了頓飯。因著我患了病，她那會對我的態度終於也不得不改觀些了，對 Kata 這樣可憐的小姑娘自然也起了同情心，於是在新華醫院給她約了位醫生。\"),\"\\n\",Vue.h(_components.p,null,\"週日，我叫上了初中同學，攜她一起出去玩儿。和她沿著外灘的路散步了很長時間，雖然彼此說的話不多，只是走著走著，就忍不住親了一下。在上海的三件套\",Vue.h(\"sup\",null,Vue.h(\"a\",{href:\"#footnote-1\",id:\"footnote-ref-1\"},\"1\")),\"那邊遊玩的時候，又忍不住親了親。好像這樣就可以維繫著某種湧上心頭的溫暖。\"),\"\\n\",Vue.h(_components.p,null,\"印象裡，Kata 在我家住了好幾天，可如今想來也不過是一個再短不過的週末。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「妹妹，你就先一直待在我這裡吧……只是我學校離我家很遠呢，大概 30 公里的路程。週一到週五的時候，我得在學校住呢……今晚我就得回去了。」\"),\"\\n\",Vue.h(_components.p,null,\"「一個人在你家太孤單了……不太行……」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"當時我已經讓她一個人暫住在我家了，可是她不答應，我也只好作罷，隨她自行安排。\"),\"\\n\",Vue.h(_components.h2,null,\"長夜\"),\"\\n\",Vue.h(_components.p,null,\"也不知怎的，她把我買的一瓶還沒開封的金剛烷胺拿走了……應該還有一瓶普瑞巴林，而我最終也沒能從她手裡搶回來。\"),\"\\n\",Vue.h(_components.p,null,\"「普瑞巴林和金剛烷胺，是絕對不能聯用的呀……」我實在是拗不過她，只好如此。\"),\"\\n\",Vue.h(_components.p,null,\"臨近回校的那個傍晚，我跟她吃了頓麻辣燙……不對，不是麻辣燙，而是冒菜。\"),\"\\n\",Vue.h(_components.p,null,\"那天晚上她吃了好多普瑞，我也吃了些許。畢竟第二天還要上學，加上我很擔心很擔心她，壓力太大，還是得吃，好像除了這樣做，沒有別的什麼方法。\"),\"\\n\",Vue.h(_components.p,null,\"「妹妹，一定要記得呀，普瑞和晚安……不能一起吃啊……」我一遍又一遍地勸告她。\"),\"\\n\",Vue.h(_components.p,null,\"因著去學校的緣故，我未能親自到機場目睹她返程。臨近第二天的深夜，她乘機回北京，起飛之前還給我發送了一段從舷窗內向外拍攝的視頻，裡邊還錄上了她的聲音。\"),\"\\n\",Vue.h(_components.p,null,\"「妹妹的聲音很好聽哦……」\"),\"\\n\",Vue.h(_components.p,null,\"「你能和卡牌姐姐去 NZ 的呢……加油 w」\"),\"\\n\",Vue.h(_components.p,null,\"我在對話框裡這樣寫道。\"),\"\\n\",Vue.h(_components.p,null,\"只是我不曾知曉，我在宿舍熟睡的那晚，約莫凌晨一點的時候，她把那一整瓶，整整一百粒的金剛烷胺全給吃了。\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"「對不起……我吞藥了……不知道能不能活到明天，好幾天沒回消息的話，就給我發訃告吧。」\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"直到將近六點醒來，我才看到那條我後悔沒及時看到的消息，未能及時回覆的消息……\"),\"\\n\",Vue.h(_components.h2,null,\"尾聲\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"你還好嗎\"),\"\\n\",Vue.h(_components.p,null,\"妹妹，想你了……\"),\"\\n\",Vue.h(_components.p,null,\"想你了……\"),\"\\n\",Vue.h(_components.p,null,\"想你了……\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"靜止的對話框，再也接不通的電話，未曾更新的動態，一切的結局或許都已明瞭。\"),\"\\n\",Vue.h(_components.p,null,\"只是直到第二年七月，我才真正從另外一位朋友處得知了她去世的消息，才有了十二月那封遲來一年有餘的訃告。\"),\"\\n\",Vue.h(_components.p,null,\"Kata 妹妹人很好，儘管她年齡比我小些……在接單這方面確是前輩呢……如今想來還是對她心存感激。\"),\"\\n\",Vue.h(_components.p,null,\"她還那麼小，那麼年輕啊……\"),\"\\n\",Vue.h(_components.p,null,\"迄今她的主頁上還掛著我最早的 ID，只是她不知道我又被封鎖了七次，那條簡介當然也不可能再更新了。\"),\"\\n\",Vue.h(_components.p,null,\"我同 Kata 線下的見面並不多，了解也並不深。但她真的是個很可愛，很善良的人，也永遠是我的好妹妹呢。\"),\"\\n\",Vue.h(_components.p,null,\"我親愛的好妹妹，要晚安啊。在那個世界裡，不要再有痛苦……\"),\"\\n\",Vue.h(_components.p,null,\"條目貢獻：\",Vue.h(_components.a,{href:\"https://twitter.com/N552AA8\"},\"N552AA\")),\"\\n\",Vue.h(\"ol\",null,Vue.h(\"li\",{id:\"footnote-1\"},\"上海三件套：即浦東新區的三幢建築：上海環球金融中心、上海金茂大廈、上海中心大廈。\",Vue.h(\"a\",{href:\"#footnote-ref-1\"},Vue.h(\"svg\",{viewBox:\"0 0 16 16\",version:\"1.1\",id:\"svg1\",\"xmlns:xlink\":\"http://www.w3.org/1999/xlink\",xmlns:\"http://www.w3.org/2000/svg\",\"xmlns:svg\":\"http://www.w3.org/2000/svg\",style:\"margin-left: 0.5rem; margin-bottom: -2px; width: 1rem; height: 1rem\"},Vue.h(\"defs\",{id:\"defs1\"},Vue.h(\"linearGradient\",{id:\"linearGradient3\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop3\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop4\"})),Vue.h(\"linearGradient\",{id:\"linearGradient1\"},Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:0;\",offset:\"0.5\",id:\"stop1\"}),Vue.h(\"stop\",{style:\"stop-color:#ff8373;stop-opacity:1;\",offset:\"0.5\",id:\"stop2\"})),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient1\",id:\"linearGradient2\",x1:\"2.6681123\",y1:\"8\",x2:\"13.331888\",y2:\"8\",gradientUnits:\"userSpaceOnUse\",gradientTransform:\"translate(2.6678295,-2)\"}),Vue.h(\"linearGradient\",{\"xlink:href\":\"#linearGradient3\",id:\"linearGradient4\",x1:\"3.7075224\",y1:\"8\",x2:\"12.292478\",y2:\"8\",gradientUnits:\"userSpaceOnUse\"})),Vue.h(\"g\",{id:\"layer1\",transform:\"translate(0,2)\"},Vue.h(\"circle\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient2);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path1\",cx:\"10.667834\",cy:\"6\",r:\"4.5818877\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:#ff8373;stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",d:\"M 9.9178343,10.577036 H 1.7971455\",id:\"path2\"}),Vue.h(\"path\",{style:\"fill:#cccccc;fill-opacity:0;stroke:url(#linearGradient4);stroke-width:1.5;stroke-linecap:square;paint-order:stroke fill markers\",id:\"path3\",d:\"M 8.0000001,11.231817 4.7681825,8.0000001 7.9999999,4.7681825 11.231817,7.9999999 Z\",transform:\"translate(-3.6894439,2.577036)\"})))))))}function MDXContent(props){if(props===void 0)props={};var _ref=props.components||{},MDXLayout=_ref.wrapper;return MDXLayout?Vue.h(MDXLayout,_extends({},props),Vue.h(_createMdxContent,_extends({},props))):_createMdxContent(props)}"