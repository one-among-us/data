"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",br:\"br\",h2:\"h2\",p:\"p\"},props.components),PhotoScroll=_components.PhotoScroll;if(!PhotoScroll)_missingMdxReference(\"PhotoScroll\",true);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"往事\"),\"\\n\",Vue.h(_components.p,null,\"在 2024 年，慧慧正式开始 HRT，但受到了来自家庭的强烈反对。她开始自伤，OD……抢救后被家里送往精神病院。在精神病院内被\",Vue.h(_components.a,{href:\"https://www.bilibili.com/opus/1209737543921172484\"},\"违规强制治疗\"),\"一个月，遭受巨大心理创伤后，她选择独自离开，来到广西与男友一起生活。在度过幸福的一段时间后，因现实的各种问题导致分手，慧慧也因此一个人在北海孤独地度过了一段时间。\"),\"\\n\",Vue.h(_components.h2,null,\"初识\"),\"\\n\",Vue.h(_components.p,null,\"我认识慧慧的时候，已经是 2026 年 4 月了，可以说来得很晚了，这也是我的遗憾吧……慧慧当时自伤送医，伤口没能恢复得很好，医院也不愿意再处理，再三讨论下，我给慧慧提供了建议：「回家，或者多等几天，我放假了来带慧慧去一起合租」。\"),\"\\n\",Vue.h(_components.p,null,\"慧慧选择了回家（后续她的日记本里提到，选择回家是因为她会自伤，不想让我难过）。在慧慧回家以后，我也一直在网上陪伴她，帮她还贷款，她也找了份工作努力把我的钱还上。但是工作太累，她后来辞去了。\"),\"\\n\",Vue.h(_components.p,null,\"两年，经历了这么多，她也明白了自己想要什么：「我只是想要被爱」。\"),\"\\n\",Vue.h(_components.h2,null,\"终曲\"),\"\\n\",Vue.h(_components.p,null,\"但是回家以后，家里人软禁她，不让她再出太远的门。她只能玩 VRChat 以及和一些好友在近一点的地方见面缓解痛苦（哎……我在网络上能做到的实在太少）。在我们一起努力找工作一段时间后，慧慧还是只能回到家。工作并不好找，她已经很努力地尝试了很久，但终究无果。回家后，还要被家里人责骂、催促。即使是 VRChat，也渐渐无法支撑慧慧活下去的念头。\"),\"\\n\",Vue.h(_components.p,null,\"最后，在 2026 年 8 月 2 日，她选择离开。我前一晚还在和慧慧聊天：「明天起来记得给我打电话」，但到了第二天早上，电话那头只剩下了无尽的忙音，私聊中是她最后发给我的说说……在临走前，她最后的礼物，以及遗物，一并邮寄给了我。\"),\"\\n\",Vue.h(_components.p,null,\"这次，我也没能拉住她，对不起。\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo1.webp\"]}),\"\\n\",Vue.h(_components.p,null,\"我想为慧慧尽最后一份力。\"),\"\\n\",Vue.h(_components.p,null,\"慧慧是一个很善良的人，也一直在网上鼓励别人活下去。\",Vue.h(_components.br),\"\\n\",\"她的愿望，只是想得到陪伴和爱。\",Vue.h(_components.br),\"\\n\",\"她愿意为别人付出很多，也只是想别人能如此对待她，可惜呐。\"),\"\\n\",Vue.h(_components.p,null,\"她留下的日记本里有这样一段话：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"好好珍惜对你好的人\"),\"\\n\",Vue.h(_components.p,null,\"万一弄丢了\"),\"\\n\",Vue.h(_components.p,null,\"就回不来了\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"好好珍惜呢，大家。\"),\"\\n\",Vue.h(_components.p,null,\"好好活着，好好珍惜。\"),\"\\n\",Vue.h(_components.p,null,\"缅怀慧慧\"),\"\\n\",Vue.h(_components.p,null,\"……\"),\"\\n\",Vue.h(_components.p,null,\"条目贡献：月乃 詩音\"))}function MDXContent(props){if(props===void 0)props={};var _ref=props.components||{},MDXLayout=_ref.wrapper;return MDXLayout?Vue.h(MDXLayout,_extends({},props),Vue.h(_createMdxContent,_extends({},props))):_createMdxContent(props)}function _missingMdxReference(id,component){throw new Error(\"Expected \"+(component?\"component\":\"object\")+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"