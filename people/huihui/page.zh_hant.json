"\"use strict\";Object.defineProperty(exports,\"__esModule\",{value:true});Object.defineProperty(exports,\"default\",{enumerable:true,get:function(){return MDXContent}});function _extends(){_extends=Object.assign||function(target){for(var i=1;i<arguments.length;i++){var source=arguments[i];for(var key in source){if(Object.prototype.hasOwnProperty.call(source,key)){target[key]=source[key]}}}return target};return _extends.apply(this,arguments)}function _createMdxContent(props){var _components=_extends({a:\"a\",blockquote:\"blockquote\",br:\"br\",h2:\"h2\",p:\"p\"},props.components),PhotoScroll=_components.PhotoScroll;if(!PhotoScroll)_missingMdxReference(\"PhotoScroll\",true);return Vue.h(Vue.Fragment,null,Vue.h(_components.h2,null,\"往事\"),\"\\n\",Vue.h(_components.p,null,\"在 2024 年，慧慧正式開始 HRT，但受到了來自家庭的強烈反對。她開始自傷，OD……搶救後被家裡送往精神科醫院。在醫院內被\",Vue.h(_components.a,{href:\"https://www.bilibili.com/opus/1209737543921172484\"},\"違規強制治療\"),\"一個月，遭受巨大心理創傷後，她選擇獨自離開，來到廣西與男友一起生活。在度過幸福的一段時間後，因現實的各種問題導致分手，慧慧也因此一個人在北海孤獨地度過了一段時間。\"),\"\\n\",Vue.h(_components.h2,null,\"初識\"),\"\\n\",Vue.h(_components.p,null,\"我認識慧慧的時候，已經是 2026 年 4 月了，可以說來得很晚了，這也是我的遺憾吧……慧慧當時自傷送醫，傷口沒能恢復得很好，醫院也不願意再處理，再三討論下，我給慧慧提供了建議：「回家，或者多等幾天，我放假了來帶慧慧去一起合租」。\"),\"\\n\",Vue.h(_components.p,null,\"慧慧選擇了回家（後續她的日記本裡提到，選擇回家是因為她會自傷，不想讓我難過）。在慧慧回家以後，我也一直在網路上陪伴她，幫她還貸款，她也找了份工作努力把我的錢還上。但是工作太累，她後來辭去了。\"),\"\\n\",Vue.h(_components.p,null,\"兩年，經歷了這麼多，她也明白了自己想要什麼：「我只是想要被愛」。\"),\"\\n\",Vue.h(_components.h2,null,\"終曲\"),\"\\n\",Vue.h(_components.p,null,\"但是回家以後，家裡人軟禁她，不讓她再出太遠的門。她只能玩 VRChat 以及和一些好友在近一點的地方見面緩解痛苦（哎……我在網路上能做到的實在太少）。在我們一起努力找工作一段時間後，慧慧還是只能回到家。工作並不好找，她已經很努力地嘗試了很久，但終究無果。回家後，還要被家裡人責罵、催促。即使是 VRChat，也漸漸無法支撐慧慧活下去的念頭。\"),\"\\n\",Vue.h(_components.p,null,\"最後，在 2026 年 8 月 2 日，她選擇離開。我前一晚還在和慧慧聊天：「明天起來記得給我打電話」，但到了第二天早上，電話那頭只剩下了無盡的忙音，私聊中是她最後發給我的動態……在臨走前，她最後的禮物，以及遺物，一併郵寄給了我。\"),\"\\n\",Vue.h(_components.p,null,\"這次，我也沒能拉住她，對不起。\"),\"\\n\",Vue.h(PhotoScroll,{photos:[\"${path}/photos/photo1.webp\"]}),\"\\n\",Vue.h(_components.p,null,\"我想為慧慧盡最後一份力。\"),\"\\n\",Vue.h(_components.p,null,\"慧慧是一個很善良的人，也一直在網路上鼓勵別人活下去。\",Vue.h(_components.br),\"\\n\",\"她的願望，只是想得到陪伴和愛。\",Vue.h(_components.br),\"\\n\",\"她願意為別人付出很多，也只是想別人能如此對待她，可惜吶。\"),\"\\n\",Vue.h(_components.p,null,\"她留下的日記本裡有這樣一段話：\"),\"\\n\",Vue.h(_components.blockquote,null,\"\\n\",Vue.h(_components.p,null,\"好好珍惜對你好的人\"),\"\\n\",Vue.h(_components.p,null,\"萬一弄丟了\"),\"\\n\",Vue.h(_components.p,null,\"就回不來了\"),\"\\n\"),\"\\n\",Vue.h(_components.p,null,\"好好珍惜呢，大家。\"),\"\\n\",Vue.h(_components.p,null,\"好好活著，好好珍惜。\"),\"\\n\",Vue.h(_components.p,null,\"緬懷慧慧\"),\"\\n\",Vue.h(_components.p,null,\"……\"),\"\\n\",Vue.h(_components.p,null,\"條目貢獻：月乃 詩音\"))}function MDXContent(props){if(props===void 0)props={};var _ref=props.components||{},MDXLayout=_ref.wrapper;return MDXLayout?Vue.h(MDXLayout,_extends({},props),Vue.h(_createMdxContent,_extends({},props))):_createMdxContent(props)}function _missingMdxReference(id,component){throw new Error(\"Expected \"+(component?\"component\":\"object\")+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"